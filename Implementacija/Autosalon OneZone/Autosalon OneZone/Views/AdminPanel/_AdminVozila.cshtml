@model Autosalon_OneZone.ViewModels.Admin.VoziloListViewModel
@using System.Text.Json

@Html.AntiForgeryToken()

@{
    var vozilaTexts = new Dictionary<string, string>
    {
        ["addVehicle"] = L["AdminAddVehicle"].Value,
        ["editVehicle"] = L["EditVehicle"].Value,
        ["edit"] = L["Edit"].Value,
        ["delete"] = L["CommonDelete"].Value,
        ["deleteTitle"] = L["DeleteVehicleTitle"].Value,
        ["deleteMessage"] = L["DeleteVehicleMessage"].Value,
        ["deleteAction"] = L["DeleteVehicleAction"].Value,
        ["loading"] = L["LoadingVehicles"].Value,
        ["empty"] = L["NoVehiclesAvailable"].Value,
        ["unknownVehicle"] = L["UnknownVehicle"].Value,
        ["notAvailable"] = L["NotAvailable"].Value,
        ["year"] = L["VehicleYear"].Value,
        ["mileage"] = L["VehicleMileage"].Value,
        ["loadError"] = L["VehicleLoadError"].Value,
        ["addFormLoadError"] = L["VehicleAddFormLoadError"].Value,
        ["editFormLoadError"] = L["VehicleEditFormLoadError"].Value,
        ["saveSuccess"] = L["VehicleSavedSuccess"].Value,
        ["saveValidationError"] = L["VehicleSaveValidationError"].Value,
        ["saveImageRequiredError"] = L["VehicleSaveImageRequiredError"].Value,
        ["deleteSuccess"] = L["VehicleDeletedSuccess"].Value,
        ["deleteError"] = L["VehicleDeleteError"].Value
    };
    var fuelLabels = Enum.GetValues<TipGoriva>()
        .ToDictionary(fuel => fuel.ToString(), fuel => L[FuelPresentation.GetResourceKey(fuel)].Value);
}

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@L["AdminPanel"]</p>
        <h1>@L["AdminVehiclesTitle"]</h1>
    </div>
</div>

<div id="add-vozilo-form-container" class="admin-form-card" style="display: none;">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <p class="admin-eyebrow mb-1">@L["AdminVehicle"]</p>
            <h2 id="add-edit-form-title" class="mb-0">@L["AdminAddVehicle"]</h2>
        </div>
    </div>
    <div id="add-vozilo-form-placeholder"></div>
</div>

<div class="admin-card"
     id="vozila-list-container"
     data-texts="@JsonSerializer.Serialize(vozilaTexts)"
     data-fuel-labels="@JsonSerializer.Serialize(fuelLabels)"
     data-list-url="@Url.Action("GetVozilaJson", "AdminPanel")"
     data-add-form-url="@Url.Action("GetAddVoziloForm", "AdminPanel")"
     data-edit-form-url="@Url.Action("GetEditVoziloForm", "AdminPanel")"
     data-delete-url="@Url.Action("DeleteVozilo", "AdminPanel")"
     data-initial-search="@Model.SearchQuery">
    <div class="admin-card-header">
        <div>
            <h2>@L["AdminVehiclesList"]</h2>
            <p>@L["AdminVehiclesListText"]</p>
        </div>
    </div>

    <div class="admin-list-toolbar">
        <button id="add-vozilo-button" class="btn btn-primary rounded-4 add-admin-btn" type="button">
            <i class="bi bi-plus-lg me-2"></i>@L["AdminAddVehicle"]
        </button>

        <div class="admin-filter-chips" aria-label="@L["AdminVehicleFuelFilterAria"]">
            <button type="button" class="filter-chip active" data-vehicle-fuel="">@L["AllVehicles"]</button>
            @foreach (var fuel in Enum.GetValues<TipGoriva>())
            {
                <button type="button" class="filter-chip" data-vehicle-fuel="@fuel">@L[FuelPresentation.GetResourceKey(fuel)]</button>
            }
        </div>

        <div class="admin-search-compact">
            <input type="text" id="vozilo-search-input" class="form-control" placeholder="@L["AdminSearchVehiclesPlaceholder"]" value="@Model.SearchQuery" />
            <button id="vozilo-search-button" class="search-submit-btn" type="button" aria-label="@L["VehicleSearchAria"]">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <div class="admin-mobile-sort">
        <label for="vozilo-sort-select" class="form-label">@L["AdminSortBy"]</label>
        <select id="vozilo-sort-select" class="form-select">
            <option value="cijena|desc">@L["AdminSortPriceDesc"]</option>
            <option value="cijena|asc">@L["AdminSortPriceAsc"]</option>
            <option value="godiste|desc">@L["AdminSortYearDesc"]</option>
            <option value="godiste|asc">@L["AdminSortYearAsc"]</option>
            <option value="kilometraza|asc">@L["AdminSortMileageAsc"]</option>
            <option value="kilometraza|desc">@L["AdminSortMileageDesc"]</option>
        </select>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["AdminVehicleName"]</th>
                    <th>
                        <a href="?sort=godiste&direction=desc" class="sortable-th" data-sort-key="godiste">
                            @L["VehicleYear"]
                            <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>@L["VehicleFuel"]</th>
                    <th>
                        <a href="?sort=kilometraza&direction=asc" class="sortable-th" data-sort-key="kilometraza">
                            @L["VehicleMileage"]
                            <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>
                        <a href="?sort=cijena&direction=desc" class="sortable-th active" data-sort-key="cijena">
                            @L["VehiclePrice"]
                            <i class="bi bi-arrow-down-short"></i>
                        </a>
                    </th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody id="vozila-table-body">
                <tr>
                    <td colspan="6">@L["LoadingVehicles"]</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="vozila-mobile-list" class="admin-mobile-list"></div>
    <div id="pagination-controls"></div>
</div>
