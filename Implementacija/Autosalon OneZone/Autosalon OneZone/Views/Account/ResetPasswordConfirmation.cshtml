@{
    ViewData["Title"] = L["ResetPasswordConfirmationTitle"];
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["ResetPasswordEyebrow"]</p>
                <h1>@L["ResetPasswordConfirmationTitle"]</h1>
                <p>@L["ResetPasswordConfirmationText"]</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card text-center">
                    <div class="form-icon mx-auto">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <h2>@L["ResetPasswordDoneHeading"]</h2>
                    <p class="text-muted mb-4">@L["ResetPasswordDoneText"]</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-4 w-100">@L["AuthSignInLink"]</a>
                </div>
            </div>
        </div>
    </div>
</section>
