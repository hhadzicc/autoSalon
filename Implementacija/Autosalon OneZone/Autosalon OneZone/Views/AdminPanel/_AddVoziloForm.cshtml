@model Autosalon_OneZone.ViewModels.Admin.AddVoziloViewModel
@using System.Text.Json

@Html.AntiForgeryToken()

@{
    var isEdit = Model.VoziloID > 0;
    var vehicleFormTexts = new Dictionary<string, string>
    {
        ["makeRequired"] = L["Validation.VehicleMakeRequiredClient"].Value,
        ["makeMax"] = L["Validation.VehicleMakeMaxLength"].Value,
        ["modelRequired"] = L["Validation.VehicleModelRequiredClient"].Value,
        ["modelMax"] = L["Validation.VehicleModelMaxLength"].Value,
        ["yearRequired"] = L["Validation.VehicleYearRequired"].Value,
        ["yearMin"] = L["Validation.VehicleYearMin", VehicleYearPolicy.MinimumYear].Value,
        ["yearMax"] = L["Validation.VehicleYearMax", VehicleYearPolicy.MaximumYear].Value,
        ["yearDigits"] = L["Validation.VehicleYearDigits"].Value,
        ["fuelRequired"] = L["Validation.VehicleFuelRequired"].Value,
        ["displacementPositive"] = L["Validation.VehicleDisplacementPositive"].Value,
        ["displacementNumber"] = L["Validation.VehicleDisplacementNumber"].Value,
        ["colorRequired"] = L["Validation.VehicleColorRequiredClient"].Value,
        ["mileageRequired"] = L["Validation.VehicleMileageRequired"].Value,
        ["mileagePositive"] = L["Validation.VehicleMileagePositive"].Value,
        ["mileageNumber"] = L["Validation.VehicleMileageNumber"].Value,
        ["priceRequired"] = L["Validation.VehiclePriceRequired"].Value,
        ["pricePositive"] = L["Validation.VehiclePricePositive"].Value,
        ["priceNumber"] = L["Validation.VehiclePriceNumber"].Value,
        ["imageRequired"] = L["Validation.VehicleImageRequiredClient"].Value,
        ["descriptionRequired"] = L["Validation.VehicleDescriptionRequired"].Value,
        ["descriptionMax"] = L["Validation.VehicleDescriptionMaxLength"].Value,
        ["allowedExtensions"] = L["AllowedImageExtensionsError"].Value,
        ["imageSizeLimit"] = L["ImageSizeLimitError"].Value
    };
}

<form id="add-edit-vozilo-form"
      asp-controller="AdminPanel"
      asp-action="SaveVozilo"
      method="post"
      enctype="multipart/form-data"
      data-validation-texts="@JsonSerializer.Serialize(vehicleFormTexts)"
      data-is-edit="@isEdit.ToString().ToLowerInvariant()">
    <input type="hidden" asp-for="VoziloID" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Marka" class="form-label">@L["VehicleMake"]</label>
            <input asp-for="Marka" class="form-control" placeholder="@L["VehicleMakePlaceholder"]" required />
            <span asp-validation-for="Marka" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Model" class="form-label">@L["VehicleModel"]</label>
            <input asp-for="Model" class="form-control" placeholder="@L["VehicleModelPlaceholder"]" required />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Godiste" class="form-label">@L["VehicleYear"]</label>
            <input asp-for="Godiste" class="form-control" type="number" min="@VehicleYearPolicy.MinimumYear" max="@VehicleYearPolicy.MaximumYear" required />
            <span asp-validation-for="Godiste" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Gorivo" class="form-label">@L["VehicleFuel"]</label>
            <select asp-for="Gorivo" class="form-control" required>
                <option value="">@L["SelectFuelType"]</option>
                @foreach (var fuel in Enum.GetValues<TipGoriva>())
                {
                    <option value="@fuel">@L[FuelPresentation.GetResourceKey(fuel)]</option>
                }
            </select>
            <span asp-validation-for="Gorivo" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Kubikaza" class="form-label">@L["VehicleDisplacement"]</label>
            <input asp-for="Kubikaza" class="form-control" type="number" min="0" step="0.1" />
            <span asp-validation-for="Kubikaza" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Boja" class="form-label">@L["VehicleColor"]</label>
            <select asp-for="Boja" class="form-control" required>
                <option value="">@L["SelectVehicleColor"]</option>
                @foreach (var color in Enum.GetValues<TipBoje>())
                {
                    <option value="@color">@L[VehicleColorPresentation.GetResourceKey(color)]</option>
                }
            </select>
            <span asp-validation-for="Boja" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Kilometraza" class="form-label">@L["VehicleMileage"]</label>
            <input asp-for="Kilometraza" class="form-control" type="number" min="0" step="1" required />
            <span asp-validation-for="Kilometraza" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Cijena" class="form-label">@L["VehiclePrice"]</label>
            <input asp-for="Cijena" class="form-control" type="number" min="0.01" step="0.01" required />
            <span asp-validation-for="Cijena" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Slika" class="form-label">@L["VehicleImage"]</label>
            @if (isEdit)
            {
                <input asp-for="Slika" class="form-control" type="file" accept="image/*" />
            }
            else
            {
                <input asp-for="Slika" class="form-control" type="file" accept="image/*" required />
            }
            <small class="form-text text-muted">@(isEdit ? L["VehicleImageOptional"] : L["VehicleImageRequired"]) · @L["FileExtensionsAllowed"]</small>
            <span asp-validation-for="Slika" class="text-danger"></span>

            @if (Model is Autosalon_OneZone.ViewModels.Admin.EditVoziloViewModel editVm && !string.IsNullOrEmpty(editVm.PostojecaSlikaPath))
            {
                <div class="mt-3">
                    <img src="~/images/vozila/@editVm.PostojecaSlikaPath" alt="@L["CurrentImage"]" class="admin-current-image" />
                    <input type="hidden" name="PostojecaSlikaPath" value="@editVm.PostojecaSlikaPath" />
                </div>
            }
        </div>

        <div class="col-12">
            <label asp-for="Opis" class="form-label">@L["VehicleDescription"]</label>
            <textarea asp-for="Opis" class="form-control" rows="4" placeholder="@L["VehicleDescriptionPlaceholder"]" required></textarea>
            <span asp-validation-for="Opis" class="text-danger"></span>
        </div>
    </div>

    <div class="profile-actions mt-4">
        <div class="profile-actions-left">
            <button type="button" id="cancel-add-vozilo" class="btn btn-light border rounded-4">@L["Cancel"]</button>
        </div>
        <button type="submit" class="btn btn-primary rounded-4">
            @(isEdit ? L["SaveChanges"] : L["AddVehicleSubmit"])
        </button>
    </div>
</form>
