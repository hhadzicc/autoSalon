@using Microsoft.AspNetCore.Identity
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager
@inject UserManager<Autosalon_OneZone.Models.ApplicationUser> UserManager
@model Autosalon_OneZone.ViewModels.KontaktViewModel
@{
    ViewData["Title"] = "Kontaktirajte podršku";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">Podrška</p>
                <h1>Kontaktirajte naš tim</h1>
                <p>Pošaljite upit za vozilo, proces kupovine ili dodatne informacije. Tim podrške će odgovoriti u najkraćem roku.</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-start g-4">
            <div class="col-lg-7 col-xl-6">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi @(SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated ? "bi-chat-dots-fill" : "bi-envelope-paper-fill")"></i>
                        </div>
                        <h2>@(SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated ? "Pošaljite poruku" : "Pošaljite upit podršci")</h2>
                        <p class="text-muted mb-0">
                            @(SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated
                                ? "Napišite pitanje i tim podrške će odgovoriti u najkraćem roku."
                                : "Za slanje poruke kroz aplikaciju potrebno je da korisnik bude prijavljen.")
                        </p>
                    </div>

                    @if (SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Home" asp-action="Kontakt" method="post" id="contact-form">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Naslov" class="form-label">Naslov</label>
                                <input asp-for="Naslov" class="form-control" placeholder="Unesite naslov" />
                                <span asp-validation-for="Naslov" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Sadrzaj" class="form-label">Poruka</label>
                                <textarea asp-for="Sadrzaj" class="form-control" rows="6" placeholder="Napišite vašu poruku"></textarea>
                                <span asp-validation-for="Sadrzaj" class="text-danger"></span>
                            </div>

                            <button type="submit" id="send-message" class="btn btn-primary btn-lg rounded-4 w-100">Pošaljite poruku</button>
                        </form>
                    }
                    else
                    {
                        <div class="contact-choice text-center">
                            <p class="text-muted mb-4">
                                Nakon prijave moguće je poslati upit za vozilo, kupovinu ili narudžbu.
                            </p>
                            <div class="d-grid gap-3">
                                <a href="/Account/Login" class="btn btn-primary btn-lg rounded-4">Prijavi se za slanje poruke</a>
                                <a href="/Account/Register" class="btn btn-outline-primary btn-lg rounded-4">Registruj se</a>
                                <a href="mailto:autosalon@autosalon.com" class="btn btn-light border btn-lg rounded-4">Pošalji email direktno</a>
                            </div>
                        </div>
                    }

                    <p class="small text-muted text-center mt-4 mb-0">Podrška će odgovoriti što je prije moguće. Hvala na strpljenju.</p>
                </div>
            </div>

            <div class="col-lg-5 col-xl-4">
                <aside class="info-card">
                    <h3>Informacije</h3>

                    <div class="info-item">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <strong>Email</strong>
                            <span>autosalon@autosalon.com</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <strong>Telefon</strong>
                            <span>+387 000 000 000</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock-fill"></i>
                        <div>
                            <strong>Vrijeme odgovora</strong>
                            <span>U najkraćem mogućem roku</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-car-front-fill"></i>
                        <div>
                            <strong>Upiti</strong>
                            <span>Vozila, kupovina i narudžbe</span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
