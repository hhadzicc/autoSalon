@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using Autosalon_OneZone.Authorization
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Autosalon_OneZone.Services.ICartService CartService
@inject Autosalon_OneZone.Services.ISupportService SupportService
@inject IOptions<Autosalon_OneZone.Services.DemoOptions> DemoOptionsAccessor
@inject Autosalon_OneZone.Services.DemoResetSchedule DemoResetSchedule

@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isHomeArea = currentPath == "/" || currentPath.StartsWith("/home");
    var isAccountArea = currentPath.StartsWith("/account");
    var isAdminArea = currentPath.StartsWith("/adminpanel");
    var isVehiclesArea = currentPath.StartsWith("/vozilo");
    var isCartArea = currentPath.StartsWith("/korpa");
    var isProfileArea = currentPath.StartsWith("/profil");
    var isLoginArea = currentPath.StartsWith("/account/login");
    var isRegisterArea = currentPath.StartsWith("/account/register");
    var isCommerceArea = isCartArea || currentPath.StartsWith("/vozilo/details");
    var successMessage = Convert.ToString(TempData["SuccessMessage"]);
    var errorMessage = Convert.ToString(TempData["ErrorMessage"]);
    var infoMessage = Convert.ToString(TempData["InfoMessage"]);
    var warningMessage = Convert.ToString(TempData["WarningMessage"]);
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isBosnian = currentCulture.StartsWith("bs", StringComparison.OrdinalIgnoreCase);
    var languageLabel = isBosnian ? "BS" : "EN";
    var returnUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
    var demoOptions = DemoOptionsAccessor.Value;
    var nextDemoResetUtc = DemoResetSchedule.NextResetUtc;
    var cartItemCount = 0;
    var unreadSupportCount = 0;
    var isBuyer = User.IsInRole(AppRoles.Buyer);
    var compactVehicleNav = ViewData["CompactVehicleNav"] as bool? == true;
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var currentUserDisplayName = currentUser == null
        ? string.Empty
        : $"{currentUser.Ime} {currentUser.Prezime}".Trim();
    if (string.IsNullOrWhiteSpace(currentUserDisplayName))
    {
        currentUserDisplayName = User.Identity?.Name ?? string.Empty;
    }
    if (SignInManager.IsSignedIn(User) && isBuyer)
    {
        var currentUserId = UserManager.GetUserId(User);
        if (!string.IsNullOrWhiteSpace(currentUserId))
        {
            cartItemCount = await CartService.GetItemCountAsync(currentUserId);
        }
    }
    if (SignInManager.IsSignedIn(User))
    {
        var currentUserId = UserManager.GetUserId(User);
        if (!string.IsNullOrWhiteSpace(currentUserId))
        {
            unreadSupportCount = await SupportService.GetUnreadUserCountAsync(currentUserId);
        }
    }
}

<!DOCTYPE html>
<html lang="@(isBosnian ? "bs" : "en")" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <title>@ViewData["Title"] - Autosalon OneZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="~/css/base/foundation.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/forms.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/page-header.css" asp-append-version="true">
    @if (isHomeArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/home.css" asp-append-version="true">
    }
    @if (isAccountArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/authentication.css" asp-append-version="true">
    }
    @if (isVehiclesArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/vehicles.css" asp-append-version="true">
    }
    @if (isProfileArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/profile.css" asp-append-version="true">
    }
    @if (isCommerceArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/commerce.css" asp-append-version="true">
        <link rel="stylesheet" type="text/css" href="~/css/responsive/commerce-responsive.css" asp-append-version="true">
    }
    <link rel="stylesheet" type="text/css" href="~/css/components/footer.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/fuel-chip.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/vehicle-color-swatch.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/responsive/site-responsive.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/feedback.css" asp-append-version="true">
    @if (isAdminArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/pages/admin.css" asp-append-version="true">
    }
    <link rel="stylesheet" type="text/css" href="~/css/components/button-system.css" asp-append-version="true">
    @if (isAdminArea)
    {
        <link rel="stylesheet" type="text/css" href="~/css/responsive/admin-mobile.css" asp-append-version="true">
    }
    @if (demoOptions.Enabled && demoOptions.ResetEnabled)
    {
        <link rel="stylesheet" type="text/css" href="~/css/components/demo-reset-timer.css" asp-append-version="true">
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    @if (demoOptions.Enabled && demoOptions.ResetEnabled && nextDemoResetUtc.HasValue)
    {
        <div class="demo-reset-overlay @(DemoResetSchedule.IsResetting ? "is-visible" : null)"
             id="demo-reset-overlay"
             data-status-url="@Url.Action("DemoResetStatus", "Home")"
             data-is-resetting="@DemoResetSchedule.IsResetting.ToString().ToLowerInvariant()"
             aria-hidden="@(!DemoResetSchedule.IsResetting).ToString().ToLowerInvariant()">
            <div class="demo-reset-overlay-panel"
                 role="alertdialog"
                 aria-modal="true"
                 aria-live="assertive"
                 aria-atomic="true"
                 aria-labelledby="demo-reset-overlay-title"
                 aria-describedby="demo-reset-overlay-text"
                 tabindex="-1">
                <span class="demo-reset-overlay-icon" aria-hidden="true">
                    <i class="bi bi-hourglass-split"></i>
                </span>
                <h2 id="demo-reset-overlay-title">@L["DemoResetOverlayTitle"]</h2>
                <p id="demo-reset-overlay-text">@L["DemoResetOverlayText"]</p>
                <span class="demo-reset-overlay-progress" aria-hidden="true"></span>
            </div>
        </div>
    }
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top @(compactVehicleNav ? "vehicle-catalog-navbar" : null)">
        <div class="container-xxl align-items-center">
            <a class="navbar-brand text-white d-flex align-items-center gap-2" href="/" aria-label="Autosalon OneZone">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                <span class="brand-name">OneZone</span>
            </a>

            @if (compactVehicleNav)
            {
                <form class="vehicle-navbar-search" method="get" action="@Url.Action("Index", "Vozilo")" role="search" autocomplete="off">
                    <input type="search"
                           name="searchTerm"
                           value="@Context.Request.Query["searchTerm"]"
                           placeholder=""
                           aria-label="@L["VehicleSearchAria"]" />
                    <span class="vehicle-navbar-search-placeholder"
                          data-mobile-search-placeholder
                          data-text="@L["VehiclesSearchPlaceholder"]"
                          aria-hidden="true"></span>
                    <button type="submit" aria-label="@L["CommonSearch"]">
                        <i class="bi bi-search" aria-hidden="true"></i>
                    </button>
                </form>
            }

            @if (demoOptions.Enabled && demoOptions.ResetEnabled && nextDemoResetUtc.HasValue)
            {
                <div class="demo-reset-nav" id="demo-reset-nav">
                    <button type="button"
                            class="demo-reset-button"
                            id="demo-reset-button"
                            aria-expanded="false"
                            aria-describedby="demo-reset-tooltip"
                            aria-label="@L["DemoModeAriaLabel"]">
                        <svg class="demo-reset-icon" aria-hidden="true" focusable="false" viewBox="0 0 32 32">
                            <path d="M8 4.5h16M8 27.5h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.8"></path>
                            <path d="M10 5.5v4.1c0 3 2.2 5 5.1 6.4C12.2 17.4 10 19.4 10 22.4v4.1M22 5.5v4.1c0 3-2.2 5-5.1 6.4 2.9 1.4 5.1 3.4 5.1 6.4v4.1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8"></path>
                            <path d="M13 10.2h6M13.3 22.2h5.4" fill="none" opacity=".9" stroke="currentColor" stroke-linecap="round" stroke-width="2.2"></path>
                        </svg>
                        <strong id="demo-reset-countdown"
                                data-reset-at="@nextDemoResetUtc.Value.ToString("O")"
                                data-reset-interval-seconds="@(demoOptions.ResetIntervalMinutes * 60)">
                            <span class="demo-time-full">--:--</span>
                            <span class="demo-time-compact">--m</span>
                        </strong>
                    </button>
                    <div class="demo-reset-tooltip" id="demo-reset-tooltip" role="tooltip">
                        <div class="demo-reset-tooltip-title">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            @L["DemoModeTitle"]
                        </div>
                        <span class="demo-reset-tooltip-text">@L["DemoModeTooltip", demoOptions.ResetIntervalMinutes]</span>
                    </div>
                </div>
            }

            <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation"
                    aria-controls="mobileNavigation" aria-expanded="false" aria-label="@L["CommonShow"]">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse d-none d-lg-flex" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Administrator") || User.IsInRole("Prodavac")))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isAdminArea ? "active" : "")" href="/AdminPanel/Index">
                                @(User.IsInRole(AppRoles.Administrator) ? L["NavAdminPanel"] : L["NavSellerPanel"])
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(isVehiclesArea ? "active" : "")" href="/Vozilo">@L["NavVehicles"]</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        @if (isBuyer)
                        {
                            <li class="nav-item">
                                <a class="nav-link cart-link @(isCartArea ? "active" : "")" href="/Korpa">
                                    <i class="bi bi-cart-fill me-lg-1"></i>@L["NavCart"]
                                    <span class="cart-count-badge @(cartItemCount == 0 ? "d-none" : null)"
                                          data-cart-count>@cartItemCount</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isProfileArea ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-lg-1"></i>@L["NavMyProfile"]
                                @if (unreadSupportCount > 0)
                                {
                                    <span class="support-nav-badge">@Math.Min(unreadSupportCount, 99)</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-menu">
                                <li>
                                    <a class="dropdown-item" href="/Profil">
                                        <i class="bi bi-person-fill me-2"></i>@L["NavProfile"]
                                    </a>
                                </li>
                                @if (isBuyer)
                                {
                                    <li>
                                        <a class="dropdown-item" href="/Profil/KupljeniArtikli">
                                            <i class="bi bi-bag-check-fill me-2"></i>@L["NavPurchasedItems"]
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item support-menu-link" href="/Profil/Podrska">
                                        <span><i class="bi bi-chat-square-text-fill me-2"></i>@L["MySupportTickets"]</span>
                                        @if (unreadSupportCount > 0)
                                        {
                                            <span class="support-menu-count">@Math.Min(unreadSupportCount, 99)</span>
                                        }
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/Edit#password">
                                        <i class="bi bi-key-fill me-2"></i>@L["NavChangePassword"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>@L["NavLogout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isLoginArea ? "active" : "")" href="/Account/Login">@L["NavLogin"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link register-link @(isRegisterArea ? "active" : "")" id="register" href="/Account/Register">@L["NavRegister"]</a>
                        </li>
                    }

                    <li class="nav-item dropdown language-switcher">
                        <a class="nav-link dropdown-toggle language-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["Language"]">
                            <i class="bi bi-globe2 me-lg-1"></i>@languageLabel
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end language-menu">
                            <li>
                                <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="en-US" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "EN" ? "active" : "")">
                                        <span class="language-code">EN</span>@L["LanguageEnglish"]
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="bs-Latn-BA" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "BS" ? "active" : "")">
                                        <span class="language-code">BS</span>@L["LanguageBosnian"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="offcanvas offcanvas-end mobile-nav-drawer d-lg-none" tabindex="-1" id="mobileNavigation" aria-labelledby="mobileNavigationLabel">
                <div class="offcanvas-header mobile-nav-header">
                    <div class="mobile-nav-brand" id="mobileNavigationLabel">
                        <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                        <strong>OneZone</strong>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="@L["Close"]"></button>
                </div>

                <div class="offcanvas-body mobile-nav-body">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="mobile-account-header">
                            <span class="mobile-account-avatar"><i class="bi bi-person-fill"></i></span>
                            <span>
                                <strong>@currentUserDisplayName</strong>
                                <small>@currentUser?.Email</small>
                            </span>
                        </div>
                    }

                    <nav class="mobile-nav-links">
                        @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Administrator") || User.IsInRole("Prodavac")))
                        {
                            <a class="mobile-nav-link @(isAdminArea ? "active" : "")" href="/AdminPanel/Index">
                                <i class="bi bi-grid-fill" aria-hidden="true"></i>
                                <span>@(User.IsInRole(AppRoles.Administrator) ? L["NavAdminPanel"] : L["NavSellerPanel"])</span>
                            </a>
                        }

                        <a class="mobile-nav-link @(isVehiclesArea ? "active" : "")" href="/Vozilo">
                            <i class="bi bi-car-front-fill" aria-hidden="true"></i>
                            <span>@L["NavVehicles"]</span>
                        </a>

                        @if (SignInManager.IsSignedIn(User) && isBuyer)
                        {
                            <a class="mobile-nav-link @(isCartArea ? "active" : "")" href="/Korpa">
                                <i class="bi bi-cart-fill" aria-hidden="true"></i>
                                <span>@L["NavCart"]</span>
                                <span class="mobile-nav-count cart-count-badge @(cartItemCount == 0 ? "d-none" : null)" data-cart-count>@cartItemCount</span>
                            </a>
                        }

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <span class="mobile-nav-section-label">@L["NavMyProfile"]</span>

                            <a class="mobile-nav-link @(currentPath == "/profil" ? "active" : "")" href="/Profil">
                                <i class="bi bi-person-fill" aria-hidden="true"></i>
                                <span>@L["NavProfile"]</span>
                            </a>
                            @if (isBuyer)
                            {
                                <a class="mobile-nav-link" href="/Profil/KupljeniArtikli">
                                    <i class="bi bi-bag-check-fill" aria-hidden="true"></i>
                                    <span>@L["NavPurchasedItems"]</span>
                                </a>
                            }
                            <a class="mobile-nav-link" href="/Profil/Podrska">
                                <i class="bi bi-chat-square-text-fill" aria-hidden="true"></i>
                                <span>@L["MySupportTickets"]</span>
                                @if (unreadSupportCount > 0)
                                {
                                    <span class="mobile-nav-count support-menu-count">@Math.Min(unreadSupportCount, 99)</span>
                                }
                            </a>
                            <a class="mobile-nav-link" href="/Profil/Edit#password">
                                <i class="bi bi-key-fill" aria-hidden="true"></i>
                                <span>@L["NavChangePassword"]</span>
                            </a>
                        }
                        else
                        {
                            <a class="mobile-nav-link @(isLoginArea ? "active" : "")" href="/Account/Login">
                                <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                <span>@L["NavLogin"]</span>
                            </a>
                            <a class="mobile-nav-link @(isRegisterArea ? "active" : "")" href="/Account/Register">
                                <i class="bi bi-person-plus-fill" aria-hidden="true"></i>
                                <span>@L["NavRegister"]</span>
                            </a>
                        }
                    </nav>

                    <div class="mobile-nav-footer">
                        <span class="mobile-nav-section-label">@L["Language"]</span>
                        <div class="mobile-language-options">
                            <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="bs-Latn-BA" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="@(languageLabel == "BS" ? "active" : "")">BS</button>
                            </form>
                            <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="culture" value="en-US" />
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <button type="submit" class="@(languageLabel == "EN" ? "active" : "")">EN</button>
                            </form>
                        </div>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <form class="mobile-logout-form" asp-controller="Account" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="mobile-nav-link mobile-logout-button">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                    <span>@L["NavLogout"]</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

    <main class="main-content-container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container-xxl">
            <div class="footer-content">
                <h5 class="footer-title">Autosalon OneZone</h5>
                <div class="footer-contact">
                    <a href="tel:+387000000000">
                        <span class="footer-contact-label">@L["FooterContact"]: </span>
                        <span>+387 000 000 000</span>
                    </a>
                    <a href="mailto:autosalon@autosalon.com">
                        <span class="footer-contact-label">Email: </span>
                        <span>autosalon@autosalon.com</span>
                    </a>
                </div>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">@L["FooterPrivacy"]</a>
                    <a asp-controller="Home" asp-action="Terms">@L["FooterTerms"]</a>
                </div>
                <p class="footer-copyright">&copy; @DateTime.Now.Year Autosalon OneZone<span class="footer-rights">. @L["FooterRights"]</span></p>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="globalDeleteConfirmModal" tabindex="-1" aria-labelledby="globalDeleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-confirm-modal">
                <div class="modal-header border-0">
                    <div class="delete-modal-heading">
                        <div class="delete-modal-icon">
                            <i class="bi bi-trash-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="globalDeleteConfirmTitle">@L["DeleteConfirmTitle"]</h5>
                            <p class="mb-0 text-muted small">@L["DeleteConfirmSubtitle"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p id="globalDeleteConfirmMessage" class="delete-confirm-message">
                        @L["DeleteConfirmMessage"]
                    </p>
                    <div id="globalDeleteConfirmItem" class="delete-confirm-item d-none"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="btn btn-danger rounded-4" id="globalDeleteConfirmButton">@L["DeleteConfirmAction"]</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="globalImagePreviewModal" tabindex="-1" aria-labelledby="globalImagePreviewTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl image-preview-dialog">
            <div class="modal-content image-preview-modal">
                <div class="image-preview-toolbar">
                    <h2 class="visually-hidden" id="globalImagePreviewTitle">@L["CurrentImage"]</h2>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <img id="globalImagePreview" alt="@L["CurrentImage"]" />
            </div>
        </div>
    </div>

    <script>
        window.appInitialToasts = [
            { message: @Json.Serialize(successMessage), type: "success" },
            { message: @Json.Serialize(errorMessage), type: "error" },
            { message: @Json.Serialize(infoMessage), type: "info" },
            { message: @Json.Serialize(warningMessage), type: "warning" }
        ];

        window.appTexts = {
            close: @Json.Serialize(L["Close"].Value),
            showPassword: @Json.Serialize(L["ShowPassword"].Value),
            hidePassword: @Json.Serialize(L["HidePassword"].Value),
            deleteConfirmTitle: @Json.Serialize(L["DeleteConfirmTitle"].Value),
            deleteConfirmMessage: @Json.Serialize(L["DeleteConfirmMessage"].Value),
            deleteConfirmAction: @Json.Serialize(L["DeleteConfirmAction"].Value),
            validationRequired: @Json.Serialize(L["ValidationRequired"].Value),
            validationEmail: @Json.Serialize(L["ValidationEmail"].Value),
            validationUrl: @Json.Serialize(L["ValidationUrl"].Value),
            validationDate: @Json.Serialize(L["ValidationDate"].Value),
            validationDateIso: @Json.Serialize(L["ValidationDateIso"].Value),
            validationNumber: @Json.Serialize(L["ValidationNumber"].Value),
            validationDigits: @Json.Serialize(L["ValidationDigits"].Value),
            validationCreditCard: @Json.Serialize(L["ValidationCreditCard"].Value),
            validationEqualTo: @Json.Serialize(L["ValidationEqualTo"].Value),
            validationMaxLength: @Json.Serialize(L["ValidationMaxLength"].Value),
            validationMinLength: @Json.Serialize(L["ValidationMinLength"].Value),
            validationRangeLength: @Json.Serialize(L["ValidationRangeLength"].Value),
            validationRange: @Json.Serialize(L["ValidationRange"].Value),
            validationMax: @Json.Serialize(L["ValidationMax"].Value),
            validationMin: @Json.Serialize(L["ValidationMin"].Value)
        };
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/app-api.js" asp-append-version="true"></script>
    <script src="~/js/components/mobile-navigation.js" asp-append-version="true"></script>
    <script src="~/js/components/vehicle-color-picker.js" asp-append-version="true"></script>
    @if (demoOptions.Enabled && demoOptions.ResetEnabled && nextDemoResetUtc.HasValue)
    {
        <script>
            (() => {
                const countdown = document.getElementById('demo-reset-countdown');
                const wrapper = document.getElementById('demo-reset-nav');
                const button = document.getElementById('demo-reset-button');
                const tooltipText = document.querySelector('#demo-reset-tooltip .demo-reset-tooltip-text');
                const fullTime = countdown?.querySelector('.demo-time-full');
                const compactTime = countdown?.querySelector('.demo-time-compact');
                const resetOverlay = document.getElementById('demo-reset-overlay');
                const resetOverlayPanel = resetOverlay?.querySelector('.demo-reset-overlay-panel');

                if (!countdown || !wrapper || !button || !fullTime || !compactTime || !resetOverlay) return;

                const resetAt = Date.parse(countdown.dataset.resetAt);
                const resetStatusUrl = resetOverlay.dataset.statusUrl;
                if (!Number.isFinite(resetAt) || !resetStatusUrl) return;

                const seenAtKey = 'autosalon-demo-indicator-seen-at-v1';
                const repeatIntroAfterMs = 5 * 60 * 60 * 1000;
                const defaultTooltip = @Json.Serialize(L["DemoModeTooltip", demoOptions.ResetIntervalMinutes].Value);
                const warningTooltip = @Json.Serialize(L["DemoModeWarningTooltip"].Value);
                let previousMinute = null;
                let wasInLastMinute = false;
                let countdownTimer = null;
                let resetFlowStarted = false;
                let resetFlowStartedAt = null;
                let reloadScheduled = false;
                let tooltipTimer = null;
                const minimumOverlayDurationMs = 2000;

                const closeTooltip = () => {
                    window.clearTimeout(tooltipTimer);
                    tooltipTimer = null;
                    wrapper.classList.remove('is-open');
                    button.setAttribute('aria-expanded', 'false');
                };

                const openTooltip = () => {
                    window.clearTimeout(tooltipTimer);
                    wrapper.classList.add('is-open');
                    button.setAttribute('aria-expanded', 'true');
                    tooltipTimer = window.setTimeout(closeTooltip, 3000);
                };

                const restartAnimation = (className, duration) => {
                    wrapper.classList.remove(className);
                    void wrapper.offsetWidth;
                    wrapper.classList.add(className);
                    window.setTimeout(() => wrapper.classList.remove(className), duration);
                };

                const reloadAfterReset = () => window.location.reload();

                const scheduleReloadAfterReset = () => {
                    if (reloadScheduled) return;
                    reloadScheduled = true;

                    const visibleForMs = Date.now() - resetFlowStartedAt;
                    const remainingDelay = Math.max(0, minimumOverlayDurationMs - visibleForMs);
                    window.setTimeout(reloadAfterReset, remainingDelay);
                };

                const pollResetStatus = async () => {
                    try {
                        const response = await fetch(resetStatusUrl, {
                            cache: 'no-store',
                            headers: { Accept: 'application/json' }
                        });

                        if (response.ok) {
                            const status = await response.json();
                            const nextResetUtc = Date.parse(status.nextResetUtc);
                            if (!status.isResetting && Number.isFinite(nextResetUtc) && nextResetUtc > resetAt) {
                                scheduleReloadAfterReset();
                                return;
                            }
                        }
                    } catch {
                        // The next poll will retry if the app is briefly unavailable during reset.
                    }

                    window.setTimeout(pollResetStatus, 1000);
                };

                const beginResetFlow = () => {
                    if (resetFlowStarted) return;
                    resetFlowStarted = true;
                    resetFlowStartedAt = Date.now();
                    window.clearInterval(countdownTimer);
                    closeTooltip();

                    wrapper.classList.add('is-reset-warning', 'is-reset-critical');
                    fullTime.textContent = '0:00';
                    compactTime.textContent = '0m';
                    resetOverlay.classList.add('is-visible');
                    resetOverlay.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('demo-reset-in-progress');

                    document.querySelectorAll('body > :not(#demo-reset-overlay):not(script)').forEach(element => {
                        element.inert = true;
                    });

                    resetOverlayPanel?.focus({ preventScroll: true });
                    pollResetStatus();
                    window.setTimeout(reloadAfterReset, 45000);
                };

                const updateCountdown = () => {
                    const now = Date.now();
                    const remainingSeconds = Math.max(0, Math.ceil((resetAt - now) / 1000));
                    const minutes = Math.floor(remainingSeconds / 60);
                    const seconds = remainingSeconds % 60;
                    const isLastMinute = remainingSeconds <= 60;
                    const isCritical = remainingSeconds <= 10;

                    fullTime.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                    compactTime.textContent = `${minutes}m`;
                    wrapper.classList.toggle('is-reset-warning', isLastMinute);
                    wrapper.classList.toggle('is-reset-critical', isCritical);

                    if (tooltipText) {
                        tooltipText.textContent = isLastMinute ? warningTooltip : defaultTooltip;
                    }

                    if (isLastMinute && !wasInLastMinute) {
                        restartAnimation('entering-reset-warning', 850);
                    } else if (!isLastMinute && previousMinute !== null && minutes !== previousMinute) {
                        restartAnimation('minute-flip', 650);
                    }

                    wasInLastMinute = isLastMinute;
                    previousMinute = minutes;

                    if (resetAt <= now) {
                        beginResetFlow();
                    }
                };

                let shouldShowIntro = true;
                try {
                    const lastSeenAt = Number(localStorage.getItem(seenAtKey));
                    shouldShowIntro = !Number.isFinite(lastSeenAt) ||
                        lastSeenAt <= 0 ||
                        Date.now() - lastSeenAt >= repeatIntroAfterMs;

                    if (shouldShowIntro) {
                        localStorage.setItem(seenAtKey, String(Date.now()));
                    }
                } catch {
                    // Without localStorage, the small introduction is shown on each visit.
                }

                if (shouldShowIntro) {
                    wrapper.classList.add('is-first-visit');
                    window.setTimeout(() => wrapper.classList.remove('is-first-visit'), 1600);
                    window.setTimeout(() => wrapper.classList.add('is-acknowledged'), 7000);
                } else {
                    wrapper.classList.add('is-acknowledged');
                }

                if (shouldShowIntro && resetOverlay.dataset.isResetting !== 'true') {
                    closeTooltip();
                    openTooltip();
                }

                button.addEventListener('click', event => {
                    event.stopPropagation();
                    if (wrapper.classList.contains('is-open')) {
                        closeTooltip();
                    } else {
                        openTooltip();
                    }
                });

                if (window.matchMedia('(hover: hover)').matches) {
                    wrapper.addEventListener('mouseenter', openTooltip);
                    wrapper.addEventListener('mouseleave', closeTooltip);
                }
                button.addEventListener('focus', () => {
                    if (button.matches(':focus-visible')) openTooltip();
                });
                button.addEventListener('blur', closeTooltip);

                document.addEventListener('click', closeTooltip);

                button.addEventListener('keydown', event => {
                    if (event.key !== 'Escape') return;
                    closeTooltip();
                    button.blur();
                });

                if (resetOverlay.dataset.isResetting === 'true' || resetAt <= Date.now()) {
                    beginResetFlow();
                } else {
                    updateCountdown();
                    countdownTimer = window.setInterval(updateCountdown, 1000);
                }
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("BottomScripts", required: false)
    <script>
        $(document).on('hidden.bs.modal', '.modal', function () {
            window.setTimeout(function () {
                if (document.activeElement && document.activeElement !== document.body) {
                    document.activeElement.blur();
                }
            }, 0);
        });
    </script>
</body>
</html>
