@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Autosalon_OneZone.Services.ICartService CartService
@inject IOptions<Autosalon_OneZone.Services.DemoOptions> DemoOptionsAccessor
@inject Autosalon_OneZone.Services.DemoResetSchedule DemoResetSchedule

@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isAdminArea = currentPath.StartsWith("/adminpanel");
    var isVehiclesArea = currentPath.StartsWith("/vozilo");
    var isContactArea = currentPath.StartsWith("/home/kontakt");
    var isCartArea = currentPath.StartsWith("/korpa");
    var isProfileArea = currentPath.StartsWith("/profil");
    var isLoginArea = currentPath.StartsWith("/account/login");
    var isRegisterArea = currentPath.StartsWith("/account/register");
    var successMessage = Convert.ToString(TempData["SuccessMessage"]);
    var errorMessage = Convert.ToString(TempData["ErrorMessage"]);
    var infoMessage = Convert.ToString(TempData["InfoMessage"]);
    var warningMessage = Convert.ToString(TempData["WarningMessage"]);
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isBosnian = currentCulture.StartsWith("bs", StringComparison.OrdinalIgnoreCase);
    var languageLabel = isBosnian ? "BS" : "EN";
    var returnUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
    var demoOptions = DemoOptionsAccessor.Value;
    var nextDemoResetUtc = DemoResetSchedule.NextResetUtc;
    var cartItemCount = 0;
    if (SignInManager.IsSignedIn(User))
    {
        var currentUserId = UserManager.GetUserId(User);
        if (!string.IsNullOrWhiteSpace(currentUserId))
        {
            cartItemCount = await CartService.GetItemCountAsync(currentUserId);
        }
    }
}

<!DOCTYPE html>
<html lang="@(isBosnian ? "bs" : "en")" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google" content="notranslate">
    <title>@ViewData["Title"] - Autosalon OneZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="~/css/base/foundation.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/home.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/authentication.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/vehicles.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/profile.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/commerce.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/footer.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/responsive/site-responsive.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/admin-legacy.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/admin.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/responsive/admin-responsive.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/admin-overrides.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/feedback.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/pages/admin-final.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/components/button-system.css" asp-append-version="true">
    @if (demoOptions.Enabled && demoOptions.ResetEnabled)
    {
        <link rel="stylesheet" type="text/css" href="~/css/components/demo-reset-timer.css" asp-append-version="true">
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top">
        <div class="container-xxl align-items-center">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" href="/">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                Autosalon OneZone
            </a>

            @if (demoOptions.Enabled && demoOptions.ResetEnabled && nextDemoResetUtc.HasValue)
            {
                <div class="demo-reset-nav" id="demo-reset-nav">
                    <button type="button"
                            class="demo-reset-button"
                            id="demo-reset-button"
                            aria-expanded="false"
                            aria-describedby="demo-reset-tooltip"
                            aria-label="@L["DemoModeAriaLabel"]">
                        <svg class="demo-reset-icon" aria-hidden="true" focusable="false" viewBox="0 0 32 32">
                            <path d="M8 4.5h16M8 27.5h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.8"></path>
                            <path d="M10 5.5v4.1c0 3 2.2 5 5.1 6.4C12.2 17.4 10 19.4 10 22.4v4.1M22 5.5v4.1c0 3-2.2 5-5.1 6.4 2.9 1.4 5.1 3.4 5.1 6.4v4.1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.8"></path>
                            <path d="M13 10.2h6M13.3 22.2h5.4" fill="none" opacity=".9" stroke="currentColor" stroke-linecap="round" stroke-width="2.2"></path>
                        </svg>
                        <strong id="demo-reset-countdown"
                                data-reset-at="@nextDemoResetUtc.Value.ToString("O")"
                                data-reset-interval-seconds="@(demoOptions.ResetIntervalMinutes * 60)">
                            <span class="demo-time-full">--:--</span>
                            <span class="demo-time-compact">--m</span>
                        </strong>
                    </button>
                    <div class="demo-reset-tooltip" id="demo-reset-tooltip" role="tooltip">
                        <div class="demo-reset-tooltip-title">
                            <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                            @L["DemoModeTitle"]
                        </div>
                        <span class="demo-reset-tooltip-text">@L["DemoModeTooltip", demoOptions.ResetIntervalMinutes]</span>
                    </div>
                </div>
            }

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="@L["CommonShow"]">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Administrator") || User.IsInRole("Prodavac")))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isAdminArea ? "active" : "")" href="/AdminPanel/Index">
                                @L["NavAdminPanel"]
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(isVehiclesArea ? "active" : "")" href="/Vozilo">@L["NavVehicles"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isContactArea ? "active" : "")" href="/Home/Kontakt">@L["NavContact"]</a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link @(isCartArea ? "active" : "")" href="/Korpa">
                                <i class="bi bi-cart-fill me-lg-1"></i>@L["NavCart"]
                                <span class="cart-count-badge @(cartItemCount == 0 ? "d-none" : null)"
                                      data-cart-count>@cartItemCount</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isProfileArea ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-lg-1"></i>@L["NavMyProfile"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-menu">
                                <li>
                                    <a class="dropdown-item" href="/Profil">
                                        <i class="bi bi-person-fill me-2"></i>@L["NavProfile"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/KupljeniArtikli">
                                        <i class="bi bi-bag-check-fill me-2"></i>@L["NavPurchasedItems"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/Edit#password">
                                        <i class="bi bi-key-fill me-2"></i>@L["NavChangePassword"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>@L["NavLogout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isLoginArea ? "active" : "")" href="/Account/Login">@L["NavLogin"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link register-link @(isRegisterArea ? "active" : "")" id="register" href="/Account/Register">@L["NavRegister"]</a>
                        </li>
                    }

                    <li class="nav-item dropdown language-switcher">
                        <a class="nav-link dropdown-toggle language-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["Language"]">
                            <i class="bi bi-globe2 me-lg-1"></i>@languageLabel
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end language-menu">
                            <li>
                                <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="en-US" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "EN" ? "active" : "")">
                                        <span class="language-code">EN</span>@L["LanguageEnglish"]
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form class="language-switch-form" asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="bs-Latn-BA" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "BS" ? "active" : "")">
                                        <span class="language-code">BS</span>@L["LanguageBosnian"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content-container">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container-xxl">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h5 class="text-white fw-bold mb-2">Autosalon OneZone</h5>
                    <p class="mb-1">@L["FooterContact"]: +387 000 000 000 · Email: <a href="mailto:autosalon@autosalon.com">autosalon@autosalon.com</a></p>
                    <p class="mb-0">&copy; @DateTime.Now.Year Autosalon OneZone. @L["FooterRights"]</p>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex justify-content-lg-end gap-3 flex-wrap">
                        <a asp-controller="Home" asp-action="Privacy">@L["FooterPrivacy"]</a>
                        <a href="#">@L["FooterTerms"]</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="globalDeleteConfirmModal" tabindex="-1" aria-labelledby="globalDeleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-confirm-modal">
                <div class="modal-header border-0">
                    <div class="delete-modal-heading">
                        <div class="delete-modal-icon">
                            <i class="bi bi-trash-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="globalDeleteConfirmTitle">@L["DeleteConfirmTitle"]</h5>
                            <p class="mb-0 text-muted small">@L["DeleteConfirmSubtitle"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p id="globalDeleteConfirmMessage" class="delete-confirm-message">
                        @L["DeleteConfirmMessage"]
                    </p>
                    <div id="globalDeleteConfirmItem" class="delete-confirm-item d-none"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="btn btn-danger rounded-4" id="globalDeleteConfirmButton">@L["DeleteConfirmAction"]</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.appInitialToasts = [
            { message: @Json.Serialize(successMessage), type: "success" },
            { message: @Json.Serialize(errorMessage), type: "error" },
            { message: @Json.Serialize(infoMessage), type: "info" },
            { message: @Json.Serialize(warningMessage), type: "warning" }
        ];

        window.appTexts = {
            close: @Json.Serialize(L["Close"].Value),
            showPassword: @Json.Serialize(L["ShowPassword"].Value),
            hidePassword: @Json.Serialize(L["HidePassword"].Value),
            deleteConfirmTitle: @Json.Serialize(L["DeleteConfirmTitle"].Value),
            deleteConfirmMessage: @Json.Serialize(L["DeleteConfirmMessage"].Value),
            deleteConfirmAction: @Json.Serialize(L["DeleteConfirmAction"].Value),
            validationRequired: @Json.Serialize(L["ValidationRequired"].Value),
            validationEmail: @Json.Serialize(L["ValidationEmail"].Value),
            validationUrl: @Json.Serialize(L["ValidationUrl"].Value),
            validationDate: @Json.Serialize(L["ValidationDate"].Value),
            validationDateIso: @Json.Serialize(L["ValidationDateIso"].Value),
            validationNumber: @Json.Serialize(L["ValidationNumber"].Value),
            validationDigits: @Json.Serialize(L["ValidationDigits"].Value),
            validationCreditCard: @Json.Serialize(L["ValidationCreditCard"].Value),
            validationEqualTo: @Json.Serialize(L["ValidationEqualTo"].Value),
            validationMaxLength: @Json.Serialize(L["ValidationMaxLength"].Value),
            validationMinLength: @Json.Serialize(L["ValidationMinLength"].Value),
            validationRangeLength: @Json.Serialize(L["ValidationRangeLength"].Value),
            validationRange: @Json.Serialize(L["ValidationRange"].Value),
            validationMax: @Json.Serialize(L["ValidationMax"].Value),
            validationMin: @Json.Serialize(L["ValidationMin"].Value)
        };
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (demoOptions.Enabled && demoOptions.ResetEnabled && nextDemoResetUtc.HasValue)
    {
        <script>
            (() => {
                const countdown = document.getElementById('demo-reset-countdown');
                const wrapper = document.getElementById('demo-reset-nav');
                const button = document.getElementById('demo-reset-button');
                const tooltipText = document.querySelector('#demo-reset-tooltip .demo-reset-tooltip-text');
                const fullTime = countdown?.querySelector('.demo-time-full');
                const compactTime = countdown?.querySelector('.demo-time-compact');

                if (!countdown || !wrapper || !button || !fullTime || !compactTime) return;

                let resetAt = Date.parse(countdown.dataset.resetAt);
                const intervalMs = Number(countdown.dataset.resetIntervalSeconds) * 1000;
                const seenAtKey = 'autosalon-demo-indicator-seen-at-v1';
                const repeatIntroAfterMs = 5 * 60 * 60 * 1000;
                const defaultTooltip = @Json.Serialize(L["DemoModeTooltip", demoOptions.ResetIntervalMinutes].Value);
                const warningTooltip = @Json.Serialize(L["DemoModeWarningTooltip"].Value);
                let previousMinute = null;
                let wasInLastMinute = false;

                const restartAnimation = (className, duration) => {
                    wrapper.classList.remove(className);
                    void wrapper.offsetWidth;
                    wrapper.classList.add(className);
                    window.setTimeout(() => wrapper.classList.remove(className), duration);
                };

                const updateCountdown = () => {
                    const now = Date.now();
                    while (resetAt <= now && intervalMs > 0) resetAt += intervalMs;

                    const remainingSeconds = Math.max(0, Math.ceil((resetAt - now) / 1000));
                    const minutes = Math.floor(remainingSeconds / 60);
                    const seconds = remainingSeconds % 60;
                    const isLastMinute = remainingSeconds <= 60;
                    const isCritical = remainingSeconds <= 10;

                    fullTime.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
                    compactTime.textContent = `${minutes}m`;
                    wrapper.classList.toggle('is-reset-warning', isLastMinute);
                    wrapper.classList.toggle('is-reset-critical', isCritical);

                    if (tooltipText) {
                        tooltipText.textContent = isLastMinute ? warningTooltip : defaultTooltip;
                    }

                    if (isLastMinute && !wasInLastMinute) {
                        restartAnimation('entering-reset-warning', 850);
                    } else if (!isLastMinute && previousMinute !== null && minutes !== previousMinute) {
                        restartAnimation('minute-flip', 650);
                    }

                    wasInLastMinute = isLastMinute;
                    previousMinute = minutes;
                };

                updateCountdown();
                window.setInterval(updateCountdown, 1000);

                let shouldShowIntro = true;
                try {
                    const lastSeenAt = Number(localStorage.getItem(seenAtKey));
                    shouldShowIntro = !Number.isFinite(lastSeenAt) ||
                        lastSeenAt <= 0 ||
                        Date.now() - lastSeenAt >= repeatIntroAfterMs;

                    if (shouldShowIntro) {
                        localStorage.setItem(seenAtKey, String(Date.now()));
                    }
                } catch {
                    // Without localStorage, the small introduction is shown on each visit.
                }

                if (shouldShowIntro) {
                    wrapper.classList.add('is-first-visit', 'is-open');
                    button.setAttribute('aria-expanded', 'true');
                    window.setTimeout(() => wrapper.classList.remove('is-first-visit'), 1600);
                    window.setTimeout(() => {
                        wrapper.classList.remove('is-open');
                        button.setAttribute('aria-expanded', 'false');
                    }, 3600);
                    window.setTimeout(() => wrapper.classList.add('is-acknowledged'), 7000);
                } else {
                    wrapper.classList.add('is-acknowledged');
                }

                button.addEventListener('click', event => {
                    event.stopPropagation();
                    const isOpen = wrapper.classList.toggle('is-open');
                    button.setAttribute('aria-expanded', String(isOpen));
                });

                document.addEventListener('click', () => {
                    if (!wrapper.classList.contains('is-open')) return;
                    wrapper.classList.remove('is-open');
                    button.setAttribute('aria-expanded', 'false');
                });

                button.addEventListener('keydown', event => {
                    if (event.key !== 'Escape') return;
                    wrapper.classList.remove('is-open');
                    button.setAttribute('aria-expanded', 'false');
                    button.blur();
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("BottomScripts", required: false)
    <script>
        $(document).on('hidden.bs.modal', '.modal', function () {
            window.setTimeout(function () {
                if (document.activeElement && document.activeElement !== document.body) {
                    document.activeElement.blur();
                }
            }, 0);
        });
    </script>
</body>
</html>
