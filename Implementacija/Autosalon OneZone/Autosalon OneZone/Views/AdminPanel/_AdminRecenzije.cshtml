@model Autosalon_OneZone.ViewModels.Admin.RecenzijaListViewModel

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Admin panel</p>
        <h1>Pregled recenzija</h1>
    </div>
</div>

<div class="admin-card" id="recenzije-list-container">
    <div class="admin-toolbar admin-toolbar-stacked">
        <div>
            <h2>Lista recenzija</h2>
            <span>Filtrirajte recenzije prema korisniku, vozilu ili sadržaju komentara.</span>
        </div>

        <div class="admin-filter-form review-filter-form">
            <input type="text" id="recenzija-user-filter" class="form-control" placeholder="Filtriraj po korisniku..." value="@Model.KorisnikFilter" />
            <input type="text" id="recenzija-vozilo-filter" class="form-control" placeholder="Filtriraj po vozilu..." value="@Model.VoziloFilter" />
            <input type="text" id="recenzija-text-search" class="form-control" placeholder="Pretraži po tekstu..." value="@Model.SearchQuery" />
            <button id="recenzija-filter-search-button" class="btn btn-primary" type="button">
                <i class="bi bi-funnel-fill me-2"></i>Primijeni filtere
            </button>
        </div>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Korisnik</th>
                    <th>Vozilo</th>
                    <th>Ocjena</th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody id="recenzija-table-body">
                <tr>
                    <td colspan="5">Učitavanje recenzija...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="recenzije-mobile-list" class="admin-mobile-list"></div>
    <div id="pagination-controls"></div>
</div>

<div class="modal fade" id="komentarModal" tabindex="-1" aria-labelledby="komentarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-chat-square-text-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="komentarModalLabel">Komentar recenzije</h5>
                        <p class="mb-0 text-muted small">Pregled punog komentara korisnika.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="review-meta-grid">
                    <div><span>Korisnik</span><strong id="komentarModalKorisnik">-</strong></div>
                    <div><span>Vozilo</span><strong id="komentarModalVozilo">-</strong></div>
                    <div><span>Ocjena</span><strong id="komentarModalOcjena">-</strong></div>
                    <div><span>Datum</span><strong id="komentarModalDatum">-</strong></div>
                </div>
                <div class="review-comment-box" id="komentarModalText"></div>
            </div>
            <div class="modal-footer modern-modal-footer">
                <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">Zatvori</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(document).off('click', '.view-komentar');
        $(document).off('app:delete-confirmed', '.delete-recenzija-button');

        const recenzijaTableBody = $('#recenzija-table-body');
        const recenzijeMobileList = $('#recenzije-mobile-list');
        const userFilterInput = $('#recenzija-user-filter');
        const voziloFilterInput = $('#recenzija-vozilo-filter');
        const textSearchInput = $('#recenzija-text-search');
        const filterSearchButton = $('#recenzija-filter-search-button');

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatDate(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return '';
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + date.getFullYear();
        }

        function ratingBadge(value) {
            const rating = Number(value || 0);
            return '<span class="rating-badge">' + rating + ' <i class="bi bi-star-fill"></i></span>';
        }

        function reviewDataAttributes(recenzija) {
            const komentar = encodeURIComponent(recenzija.komentar || '');
            const korisnik = encodeURIComponent(recenzija.korisnikUserName || recenzija.korisnikIme || 'N/A');
            const vozilo = encodeURIComponent((recenzija.voziloNaziv || ((recenzija.voziloMarka || '') + ' ' + (recenzija.voziloModel || '')).trim()) || 'N/A');
            const datum = encodeURIComponent(formatDate(recenzija.datumRecenzije));
            const ocjena = encodeURIComponent((recenzija.ocjena || '') + ' / 5');

            return 'data-komentar="' + komentar + '" ' +
                'data-korisnik="' + korisnik + '" ' +
                'data-vozilo="' + vozilo + '" ' +
                'data-ocjena="' + ocjena + '" ' +
                'data-datum="' + datum + '"';
        }

        function viewButton(recenzija) {
            return '<button class="btn btn-sm btn-outline-primary rounded-3 view-komentar" ' +
                reviewDataAttributes(recenzija) +
                '><i class="bi bi-eye me-1"></i>Prikaži</button>';
        }

        function reviewActions(recenzija) {
            const vozilo = (recenzija.voziloNaziv || ((recenzija.voziloMarka || '') + ' ' + (recenzija.voziloModel || '')).trim()) || 'Recenzija';
            const item = vozilo + ' · ocjena ' + (recenzija.ocjena || 'N/A');

            return '<div class="table-actions">' +
                viewButton(recenzija) +
                '<button class="delete-recenzija-button btn btn-sm btn-outline-danger rounded-3" data-id="' + recenzija.recenzijaID + '" data-confirm-delete="true" data-confirm-title="Obrisati recenziju?" data-confirm-message="Da li ste sigurni da želite obrisati ovu recenziju?" data-confirm-item="' + escapeAttribute(item) + '" data-confirm-action="Da, obriši recenziju"><i class="bi bi-trash me-1"></i>Obriši</button>' +
                '</div>';
        }

        function renderReviews(recenzije) {
            recenzijaTableBody.empty();
            recenzijeMobileList.empty();

            if (!recenzije || recenzije.length === 0) {
                recenzijaTableBody.html('<tr><td colspan="5"><div class="empty-state"><i class="bi bi-star"></i><p>Nema dostupnih recenzija.</p></div></td></tr>');
                recenzijeMobileList.html('<div class="empty-state"><i class="bi bi-star"></i><p>Nema dostupnih recenzija.</p></div>');
                return;
            }

            $.each(recenzije, function (_, recenzija) {
                const rawKorisnik = recenzija.korisnikUserName || recenzija.korisnikIme || 'N/A';
                const rawVozilo = recenzija.voziloNaziv || ((recenzija.voziloMarka || '') + ' ' + (recenzija.voziloModel || '')).trim() || 'N/A';
                const korisnik = escapeHtml(rawKorisnik);
                const vozilo = escapeHtml(rawVozilo);
                const datum = formatDate(recenzija.datumRecenzije);
                const actions = reviewActions(recenzija);

                recenzijaTableBody.append(
                    '<tr>' +
                        '<td class="date-cell">' + escapeHtml(datum) + '</td>' +
                        '<td><div class="user-cell" title="' + escapeAttribute(rawKorisnik) + '"><span class="user-avatar"><i class="bi bi-person-fill"></i></span><strong>' + korisnik + '</strong></div></td>' +
                        '<td><div class="vehicle-name-cell" title="' + escapeAttribute(rawVozilo) + '"><strong>' + vozilo + '</strong></div></td>' +
                        '<td>' + ratingBadge(recenzija.ocjena) + '</td>' +
                        '<td>' + actions + '</td>' +
                    '</tr>'
                );

                recenzijeMobileList.append(
                    '<article class="admin-review-card">' +
                        '<div class="mobile-card-top">' +
                            '<span class="date-cell">' + escapeHtml(datum) + '</span>' +
                            ratingBadge(recenzija.ocjena) +
                        '</div>' +
                        '<h3>' + vozilo + '</h3>' +
                        '<p class="mobile-user">' + korisnik + '</p>' +
                        '<div class="mobile-actions">' + actions + '</div>' +
                    '</article>'
                );
            });
        }

        function getCurrentFilterParams() {
            return {
                searchQuery: textSearchInput.val(),
                korisnikFilter: userFilterInput.val(),
                voziloFilter: voziloFilterInput.val()
            };
        }

        function loadRecenzijeList(params = {}) {
            recenzijaTableBody.html('<tr><td colspan="5">Učitavanje recenzija...</td></tr>');
            recenzijeMobileList.html('<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Učitavanje recenzija...</p></div>');

            $.get('@Url.Action("GetRecenzijeJson", "AdminPanel")', params, function (data) {
                renderReviews(data && data.recenzije ? data.recenzije : []);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                const message = escapeHtml(jqXHR.responseText || errorThrown || 'Greška');
                recenzijaTableBody.html('<tr><td colspan="5"><div class="alert alert-danger mb-0">Greška prilikom učitavanja recenzija: ' + message + '</div></td></tr>');
                recenzijeMobileList.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja recenzija: ' + message + '</div>');
            });
        }

        loadRecenzijeList(getCurrentFilterParams());

        filterSearchButton.on('click', function () {
            loadRecenzijeList(getCurrentFilterParams());
        });

        $('.admin-filter-form input[type="text"]').on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                filterSearchButton.click();
            }
        });

        $(document).off('click.adminRecenzijeView', '.view-komentar').on('click.adminRecenzijeView', '.view-komentar', function (e) {
            e.preventDefault();
            $('#komentarModalText').text(decodeURIComponent($(this).data('komentar') || ''));
            $('#komentarModalKorisnik').text(decodeURIComponent($(this).data('korisnik') || '-'));
            $('#komentarModalVozilo').text(decodeURIComponent($(this).data('vozilo') || '-'));
            $('#komentarModalOcjena').text(decodeURIComponent($(this).data('ocjena') || '-'));
            $('#komentarModalDatum').text(decodeURIComponent($(this).data('datum') || '-'));
            $('#komentarModal').modal('show');
        });

        $(document).off('app:delete-confirmed.adminRecenzijeDelete', '.delete-recenzija-button').on('app:delete-confirmed.adminRecenzijeDelete', '.delete-recenzija-button', function () {
            const recenzijaId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("DeleteRecenzija", "AdminPanel")',
                method: 'POST',
                data: { id: recenzijaId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    window.showAppFlashMessage(response.successMessage || 'Recenzija uspješno obrisana.', 'success');
                    loadRecenzijeList(getCurrentFilterParams());
                },
                error: function () {
                    window.showAppFlashMessage('Došlo je do greške prilikom brisanja recenzije.', 'error');
                }
            });
        });
    });
</script>
