@model Autosalon_OneZone.Models.Narudzba
@{
    ViewData["Title"] = "Uspješna kupovina";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container text-center">
        <p class="section-eyebrow">Kupovina</p>
        <h1>Kupovina završena</h1>
        <p>Vaša narudžba je uspješno evidentirana.</p>
    </div>
</section>

<section class="success-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="success-card">
                    <div class="success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <h2>Hvala na kupovini!</h2>
                    <p class="success-text">
                        Vaša kupovina je uspješno završena. Detalje narudžbe možete pregledati ispod.
                    </p>

                    <div class="order-summary">
                        <div>
                            <span>Broj narudžbe</span>
                            <strong>#@Model.NarudzbaID</strong>
                        </div>

                        <div>
                            <span>Datum</span>
                            <strong>@Model.DatumNarudzbe.ToString("dd.MM.yyyy. HH:mm")</strong>
                        </div>

                        <div>
                            <span>Ukupan iznos</span>
                            <strong>€@Model.UkupnaCijena.ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="purchase-details">
                        <h3>Detalji kupovine</h3>

                        <div class="purchase-row purchase-head">
                            <span>Vozilo</span>
                            <span>Cijena</span>
                        </div>

                        @foreach (var stavka in Model.StavkeKorpe)
                        {
                            <div class="purchase-row">
                                <span>@stavka.Vozilo.Marka @stavka.Vozilo.Model (@stavka.Vozilo.Godiste)</span>
                                <strong>€@stavka.CijenaStavke.ToString("N2")</strong>
                            </div>
                        }
                    </div>

                    <div class="success-note">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            <strong>Šta slijedi?</strong>
                            <p>
                                Dodatne informacije o preuzimanju vozila dobit ćete putem e-maila.
                                Za pitanja možete koristiti kontakt stranicu ili direktno pisati na
                                <strong>autosalon@autosalon.com</strong>.
                            </p>
                        </div>
                    </div>

                    <div class="success-actions">
                        <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary rounded-4">
                            <i class="bi bi-car-front-fill me-2"></i>Povratak na vozila
                        </a>

                        <a href="@Url.Action("KupljeniArtikli", "Profil")" class="btn btn-outline-primary rounded-4">
                            <i class="bi bi-bag-check me-2"></i>Moji kupljeni artikli
                        </a>

                        <a href="@Url.Action("Index", "Profil")" class="btn btn-light border rounded-4">
                            <i class="bi bi-person-fill me-2"></i>Moj profil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
