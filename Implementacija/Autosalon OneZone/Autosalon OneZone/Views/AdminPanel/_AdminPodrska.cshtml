@model Autosalon_OneZone.ViewModels.Admin.PodrskaListViewModel
@using Autosalon_OneZone.Models
@using System.Text.Json

@{
    var podrskaTexts = new Dictionary<string, string>
    {
        ["show"] = L["Show"].Value,
        ["reply"] = L["Reply"].Value,
        ["delete"] = L["CommonDelete"].Value,
        ["status"] = L["Status"].Value,
        ["statusSent"] = L["StatusSent"].Value,
        ["statusInProgress"] = L["StatusInProgress"].Value,
        ["statusAnswered"] = L["StatusAnswered"].Value,
        ["statusClosed"] = L["StatusClosed"].Value,
        ["deleteTitle"] = L["DeleteInquiryTitle"].Value,
        ["deleteMessage"] = L["DeleteInquiryMessage"].Value,
        ["deleteAction"] = L["DeleteInquiryAction"].Value,
        ["loading"] = L["LoadingInquiries"].Value,
        ["empty"] = L["NoSupportInquiries"].Value,
        ["notAvailable"] = L["NotAvailable"].Value,
        ["loadError"] = L["InquiriesLoadError"].Value,
        ["statusChangeError"] = L["StatusChangeError"].Value,
        ["deleteSuccess"] = L["InquiryDeletedSuccess"].Value,
        ["deleteError"] = L["InquiryDeleteError"].Value,
        ["email"] = L["Email"].Value,
        ["customer"] = L["Customer"].Value,
        ["replySubject"] = L["ReplyToInquirySubject"].Value,
        ["replyGreeting"] = L["ReplyToInquiryGreeting"].Value,
        ["replyBody"] = L["ReplyToInquiryBody"].Value,
        ["inquiryPrefix"] = L["InquiryItemPrefix"].Value,
        ["untitled"] = L["Untitled"].Value
    };
}

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">@L["AdminPanel"]</p>
        <h1>@L["AdminSupportTitle"]</h1>
    </div>
</div>

<div class="admin-card" id="podrska-list-container">
    <div class="admin-toolbar">
        <div>
            <h2>@L["AdminSupportList"]</h2>
            <span>@L["AdminSupportListText"]</span>
        </div>

        <div class="admin-search-compact">
            <input type="text" id="podrska-search-input" class="form-control" placeholder="@L["AdminSearchSupportPlaceholder"]" value="@Model.SearchQuery" />
            <button id="podrska-search-button" class="search-submit-btn" type="button" aria-label="@L["CommonSearch"]">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table admin-support-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@L["Date"]</th>
                    <th>@L["UserEmail"]</th>
                    <th>@L["InquiryTitle"]</th>
                    <th>@L["Status"]</th>
                    <th class="text-end">@L["Actions"]</th>
                </tr>
            </thead>
            <tbody id="podrska-table-body">
                <tr>
                    <td colspan="5">@L["LoadingInquiries"]</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="podrska-mobile-list" class="admin-mobile-list"></div>
    <div id="pagination-controls"></div>
</div>

<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-envelope-open-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="messageModalLabel">@L["MessageModalTitle"]</h5>
                        <p class="mb-0 text-muted small">@L["MessageModalSubtitle"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <div class="support-meta-grid">
                    <div><span>@L["UserEmail"]</span><strong id="messageModalEmail">-</strong></div>
                    <div><span>@L["InquiryTitle"]</span><strong id="messageModalTitle">-</strong></div>
                    <div><span>@L["Date"]</span><strong id="messageModalDate">-</strong></div>
                    <div><span>@L["Status"]</span><strong id="messageModalStatus">-</strong></div>
                </div>
                <div class="message-box" id="messageModalBody"></div>
            </div>
            <div class="modal-footer modern-modal-footer">
                <a id="messageModalReply" href="#" class="btn btn-primary rounded-4">
                    <i class="bi bi-reply-fill me-2"></i>@L["Reply"]
                </a>
                <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">@L["Close"]</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        const text = @Html.Raw(JsonSerializer.Serialize(podrskaTexts));

        $(document).off('click', '.delete-podrska-button');
        $(document).off('click', '.status-option');
        $(document).off('click', '.message-text, .view-message-button');
        $(document).off('app:delete-confirmed', '.delete-podrska-button');
        $('#podrska-search-button').off('click');
        $('#podrska-search-input').off('keypress');

        const podrskaTableBody = $('#podrska-table-body');
        const podrskaMobileList = $('#podrska-mobile-list');
        const searchInput = $('#podrska-search-input');
        const searchButton = $('#podrska-search-button');

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function emailLink(value) {
            const email = value || text.notAvailable;
            const safeEmail = escapeHtml(email);
            const safeAttr = escapeAttribute(email);

            if (!value) {
                return '<span class="admin-email-link is-empty">' + safeEmail + '</span>';
            }

            return '<a class="admin-email-link" href="mailto:' + safeAttr + '" title="' + safeAttr + '">' + safeEmail + '</a>';
        }

        function formatDateTime(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return '';
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + date.getFullYear();
        }

        function statusLabel(status) {
            switch (status) {
                case 'Poslat': return text.statusSent;
                case 'UObradi': return text.statusInProgress;
                case 'Odgovoren': return text.statusAnswered;
                case 'Zatvoren': return text.statusClosed;
                default: return status || text.notAvailable;
            }
        }

        function getStatusBadge(status) {
            let className = 'secondary';
            switch (status) {
                case 'Poslat': className = 'info'; break;
                case 'UObradi': className = 'warning'; break;
                case 'Odgovoren': className = 'success'; break;
                case 'Zatvoren': className = 'secondary'; break;
            }
            return '<span class="support-status-badge status-' + className + '">' + escapeHtml(statusLabel(status)) + '</span>';
        }

        function createStatusDropdown(upitId, currentStatus) {
            const statuses = [
                ['Poslat', text.statusSent],
                ['UObradi', text.statusInProgress],
                ['Odgovoren', text.statusAnswered],
                ['Zatvoren', text.statusClosed]
            ];

            const options = statuses.map(function (item) {
                const value = item[0];
                const label = item[1];
                return '<li><a class="dropdown-item status-option ' + (currentStatus === value ? 'active' : '') + '" href="#" data-status="' + value + '" data-upit-id="' + upitId + '">' + escapeHtml(label) + '</a></li>';
            }).join('');

            return '<div class="dropdown status-dropdown">' +
                '<button class="btn btn-sm btn-light border rounded-3 dropdown-toggle status-dropdown-toggle" type="button" aria-expanded="false">' + escapeHtml(text.status) + '</button>' +
                '<ul class="dropdown-menu dropdown-menu-end">' + options + '</ul>' +
            '</div>';
        }

        function buildReplyHref(upit) {
            const subject = text.replySubject + ' ' + (upit.naslov || '');
            const body = text.replyGreeting + ' ' + (upit.korisnikIme || '') + ',%0D%0A%0D%0A' + text.replyBody + '%0D%0A%0D%0A';
            return 'mailto:' + encodeURIComponent(upit.korisnikEmail || '') + '?subject=' + encodeURIComponent(subject) + '&body=' + body;
        }

        function supportDataAttributes(upit) {
            const replyHref = buildReplyHref(upit);

            return 'data-full-text="' + encodeURIComponent(upit.sadrzaj || '') + '" ' +
                'data-email="' + encodeURIComponent(upit.korisnikEmail || text.notAvailable) + '" ' +
                'data-title="' + encodeURIComponent(upit.naslov || '') + '" ' +
                'data-date="' + encodeURIComponent(formatDateTime(upit.datumUpita)) + '" ' +
                'data-status="' + encodeURIComponent(statusLabel(upit.status)) + '" ' +
                'data-reply="' + replyHref + '"';
        }

        function viewMessageButton(upit) {
            return '<button class="btn btn-sm btn-outline-primary rounded-3 view-message-button" ' +
                supportDataAttributes(upit) +
                '><i class="bi bi-eye me-1"></i>' + escapeHtml(text.show) + '</button>';
        }

        function supportActions(upit) {
            const replyHref = buildReplyHref(upit);
            const item = text.inquiryPrefix + ' ' + (upit.naslov || text.untitled) + ' · ' + (upit.korisnikEmail || text.notAvailable);

            return '<div class="table-actions support-actions-grid">' +
                viewMessageButton(upit) +
                '<a href="' + replyHref + '" class="btn btn-sm btn-outline-primary rounded-3"><i class="bi bi-reply me-1"></i>' + escapeHtml(text.reply) + '</a>' +
                createStatusDropdown(upit.upitID, upit.status) +
                '<button class="delete-podrska-button btn btn-sm btn-outline-danger rounded-3" data-id="' + upit.upitID + '" data-confirm-delete="true" data-confirm-title="' + escapeAttribute(text.deleteTitle) + '" data-confirm-message="' + escapeAttribute(text.deleteMessage) + '" data-confirm-item="' + escapeAttribute(item) + '" data-confirm-action="' + escapeAttribute(text.deleteAction) + '"><i class="bi bi-trash me-1"></i>' + escapeHtml(text.delete) + '</button>' +
                '</div>';
        }

        function renderTickets(upiti) {
            podrskaTableBody.empty();
            podrskaMobileList.empty();

            if (!upiti || upiti.length === 0) {
                podrskaTableBody.html('<tr><td colspan="5"><div class="empty-state"><i class="bi bi-inbox"></i><p>' + escapeHtml(text.empty) + '</p></div></td></tr>');
                podrskaMobileList.html('<div class="empty-state"><i class="bi bi-inbox"></i><p>' + escapeHtml(text.empty) + '</p></div>');
                return;
            }

            upiti.forEach(upit => {
                const datum = formatDateTime(upit.datumUpita);
                const rawEmail = upit.korisnikEmail || '';
                const email = emailLink(rawEmail);
                const rawTitle = upit.naslov || text.untitled;
                const naslov = escapeHtml(rawTitle);
                const actions = supportActions(upit);

                podrskaTableBody.append(
                    '<tr>' +
                        '<td class="date-cell">' + escapeHtml(datum) + '</td>' +
                        '<td><div class="user-cell" title="' + escapeAttribute(rawEmail || text.notAvailable) + '"><span class="user-avatar"><i class="bi bi-envelope-fill"></i></span><strong>' + email + '</strong></div></td>' +
                        '<td><strong class="table-text-truncate" title="' + escapeAttribute(rawTitle) + '">' + naslov + '</strong></td>' +
                        '<td>' + getStatusBadge(upit.status) + '</td>' +
                        '<td>' + actions + '</td>' +
                    '</tr>'
                );

                podrskaMobileList.append(
                    '<article class="support-mobile-card">' +
                        '<div class="mobile-card-top">' +
                            '<span class="date-cell">' + escapeHtml(datum) + '</span>' +
                            getStatusBadge(upit.status) +
                        '</div>' +
                        '<h3>' + naslov + '</h3>' +
                        '<p class="mobile-user">' + email + '</p>' +
                        '<div class="review-mobile-meta">' +
                            '<div><span>' + escapeHtml(text.status) + '</span><strong>' + escapeHtml(statusLabel(upit.status)) + '</strong></div>' +
                            '<div><span>' + escapeHtml(text.customer) + '</span><strong>' + email + '</strong></div>' +
                        '</div>' +
                        '<div class="mobile-actions">' + actions + '</div>' +
                    '</article>'
                );
            });
        }

        function loadUpitiList(searchQuery = '', page = 1) {
            podrskaTableBody.html('<tr><td colspan="5">' + escapeHtml(text.loading) + '</td></tr>');
            podrskaMobileList.html('<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>' + escapeHtml(text.loading) + '</p></div>');

            $.get('@Url.Action("GetPodrskaJson", "AdminPanel")', { searchQuery, page }, function (data) {
                renderTickets(data && data.upiti ? data.upiti : []);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                const message = escapeHtml(jqXHR.responseText || errorThrown || window.appTexts?.genericError || 'Error');
                podrskaTableBody.html('<tr><td colspan="5"><div class="alert alert-danger mb-0">' + escapeHtml(text.loadError) + ' ' + message + '</div></td></tr>');
                podrskaMobileList.html('<div class="alert alert-danger mb-0">' + escapeHtml(text.loadError) + ' ' + message + '</div>');
            });
        }

        $(document).off('click.adminPodrskaStatusToggle', '.status-dropdown-toggle').on('click.adminPodrskaStatusToggle', '.status-dropdown-toggle', function (e) {
            e.preventDefault();
            e.stopPropagation();

            const dropdown = bootstrap.Dropdown.getOrCreateInstance(this, {
                boundary: document.body,
                popperConfig: function (config) {
                    return {
                        ...config,
                        strategy: 'fixed',
                        modifiers: [
                            ...(config.modifiers || []),
                            {
                                name: 'preventOverflow',
                                options: {
                                    boundary: 'viewport',
                                    rootBoundary: 'viewport'
                                }
                            },
                            {
                                name: 'flip',
                                options: {
                                    boundary: 'viewport',
                                    rootBoundary: 'viewport'
                                }
                            }
                        ]
                    };
                }
            });

            dropdown.toggle();
        });

        $(document).off('click.adminPodrskaView', '.view-message-button').on('click.adminPodrskaView', '.view-message-button', function () {
            $('#messageModalBody').text(decodeURIComponent($(this).data('full-text') || ''));
            $('#messageModalEmail').text(decodeURIComponent($(this).data('email') || '-'));
            $('#messageModalTitle').text(decodeURIComponent($(this).data('title') || '-'));
            $('#messageModalDate').text(decodeURIComponent($(this).data('date') || '-'));
            $('#messageModalStatus').text(decodeURIComponent($(this).data('status') || '-'));
            $('#messageModalReply').attr('href', $(this).data('reply') || '#');
            $('#messageModal').modal('show');
        });

        $(document).off('click.adminPodrskaStatus', '.status-option').on('click.adminPodrskaStatus', '.status-option', function (e) {
            e.preventDefault();
            const status = $(this).data('status');
            const upitId = $(this).data('upit-id');

            $.ajax({
                url: '@Url.Action("UpdatePodrskaStatus", "AdminPanel")',
                method: 'POST',
                data: { id: upitId, status: status },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.successMessage) {
                        window.showAppToast(response.successMessage, 'success');
                    }
                    loadUpitiList(searchInput.val());
                },
                error: function () {
                    window.showAppToast(text.statusChangeError, 'error');
                }
            });
        });

        $(document).off('app:delete-confirmed.adminPodrskaDelete', '.delete-podrska-button').on('app:delete-confirmed.adminPodrskaDelete', '.delete-podrska-button', function () {
            const upitId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("DeletePodrska", "AdminPanel")',
                method: 'POST',
                data: { id: upitId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.successMessage) {
                        window.showAppToast(response.successMessage, 'success');
                    } else {
                        window.showAppToast(text.deleteSuccess, 'success');
                    }
                    loadUpitiList(searchInput.val());
                },
                error: function () {
                    window.showAppToast(text.deleteError, 'error');
                }
            });
        });

        searchButton.on('click', function () {
            loadUpitiList(searchInput.val());
        });

        searchInput.on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                searchButton.click();
            }
        });

        loadUpitiList(@Html.Raw(JsonSerializer.Serialize(Model.SearchQuery ?? string.Empty)));
    });
</script>
