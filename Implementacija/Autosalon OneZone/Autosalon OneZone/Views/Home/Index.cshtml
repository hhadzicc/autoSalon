@using System.Globalization
@using Autosalon_OneZone.ViewModels
@model HomeIndexViewModel

@{
    ViewData["Title"] = L["HomeTitle"];

    var culture = CultureInfo.CurrentCulture;
    var heroVehicles = Model.HeroVehicles;
    var featuredVehicles = Model.FeaturedVehicles;
    var hasHeroVehicles = heroVehicles.Any();
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-badge"><i class="bi bi-lightning-charge-fill me-2"></i>@L["HomeHeroBadge"]</div>

                <h1 class="hero-title">
                    @L["HomeHeroTitleStart"] <span>@L["HomeHeroTitleAccent"]</span>
                </h1>

                <p class="hero-text">@L["HomeHeroText"]</p>

                <div class="hero-actions d-flex flex-wrap gap-3 mb-4">
                    <a href="@Url.Action("Index", "Vozilo")" class="oz-btn">
                        <span>@L["HomeViewOffer"]</span>
                        <span class="oz-btn-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M5 12h14"></path>
                                <path d="m14 7 5 5-5 5"></path>
                            </svg>
                        </span>
                    </a>
                    <a href="@Url.Action("Kontakt", "Home")" class="oz-btn oz-btn-secondary">
                        <span>@L["HomeContactUs"]</span>
                    </a>
                </div>

                <form class="hero-search d-flex gap-2" action="/Vozilo/Index" method="get" role="search" autocomplete="off">
                    <input class="form-control animated-search-placeholder"
                           type="search"
                           name="searchTerm"
                           autocomplete="off"
                           spellcheck="false"
                           placeholder="@L["HomeSearchPlaceholder"]"
                           data-animated-search-placeholder
                           data-static-placeholder="@L["HomeSearchPlaceholder"]"
                           data-placeholder-phrases="@L["VehicleSearchAnimatedPhrases"]"
                           aria-label="@L["VehicleSearchAria"]">
                    <button class="oz-btn oz-btn-search" type="submit">
                        <svg class="oz-btn-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="m16 16 4 4"></path>
                        </svg>
                        <span>@L["HomeFindVehicle"]</span>
                    </button>
                </form>
            </div>

            <div class="col-lg-5">
                @if (hasHeroVehicles)
                {
                    <div class="hero-vehicle-carousel"
                         data-hero-vehicle-carousel
                         data-autoplay-delay="5000"
                         data-transition-duration="650">
                        <div class="featured-car-card hero-carousel-card">
                            <div class="hero-carousel-viewport">
                            @for (var index = 0; index < heroVehicles.Count; index++)
                            {
                                var heroVehicle = heroVehicles[index];
                                var heroVehicleName = $"{heroVehicle.Marka} {heroVehicle.Model}";
                                var heroVehicleImage = !string.IsNullOrWhiteSpace(heroVehicle.Slika)
                                    ? Url.Content($"~/images/vozila/{heroVehicle.Slika}")
                                    : null;
                                var heroVehiclePrice = heroVehicle.Cijena.HasValue
                                    ? $"€{heroVehicle.Cijena.Value.ToString("N0", culture)}"
                                    : L["PriceOnRequest"].Value;
                                var heroVehicleMileage = heroVehicle.Kilometraza.HasValue
                                    ? $"{heroVehicle.Kilometraza.Value.ToString("N0", culture)} km"
                                    : L["NotEntered"].Value;

                                <article class="hero-carousel-slide @(index == 0 ? "is-active" : null)"
                                         data-hero-carousel-slide
                                         aria-hidden="@(index == 0 ? "false" : "true")">
                                    <a href="@Url.Action("Details", "Vozilo", new { id = heroVehicle.VoziloID, returnUrl = "/" })"
                                       class="hero-vehicle-image-link"
                                       aria-label="@($"{L["ViewDetails"]}: {heroVehicleName}")">
                                        @if (!string.IsNullOrWhiteSpace(heroVehicleImage))
                                        {
                                            <div class="car-image" style="background-image: url('@heroVehicleImage');"></div>
                                        }
                                        else
                                        {
                                            <div class="car-image car-image-placeholder">
                                                <i class="bi bi-car-front-fill"></i>
                                                <span>@L["ImageUnavailable"]</span>
                                            </div>
                                        }
                                    </a>

                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3 mb-4">
                                        <div>
                                            <h2 class="fw-black mb-1">
                                                <a href="@Url.Action("Details", "Vozilo", new { id = heroVehicle.VoziloID, returnUrl = "/" })"
                                                   class="hero-vehicle-title-link">@heroVehicleName</a>
                                            </h2>
                                        </div>
                                        <span class="price-badge">@heroVehiclePrice</span>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-4">
                                            <div class="glass-stat">
                                                <strong>@heroVehicle.Godiste</strong>
                                                <span>@L["VehicleYearLower"]</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="glass-stat">
                                                <strong>@heroVehicleMileage</strong>
                                                <span>@L["VehicleMileageLower"]</span>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="glass-stat">
                                                <strong>@heroVehicle.Gorivo</strong>
                                                <span>@L["VehicleFuelLower"]</span>
                                            </div>
                                        </div>
                                    </div>

                                    <a href="@Url.Action("Details", "Vozilo", new { id = heroVehicle.VoziloID, returnUrl = "/" })" class="oz-btn oz-btn-light">
                                        <span>@L["ViewDetails"]</span>
                                    </a>
                                </article>
                            }
                            </div>
                        </div>

                        @if (heroVehicles.Count > 1)
                        {
                            <div class="hero-carousel-controls">
                                <button class="hero-carousel-arrow" type="button" data-hero-carousel-previous aria-label="@L["HomeCarouselPrevious"]">
                                    <i class="bi bi-chevron-left" aria-hidden="true"></i>
                                </button>
                                <div class="hero-carousel-dots" role="group" aria-label="@L["HomeCarouselNavigation"]">
                                    @for (var index = 0; index < heroVehicles.Count; index++)
                                    {
                                        <button class="hero-carousel-dot @(index == 0 ? "is-active" : null)"
                                                type="button"
                                                data-hero-carousel-dot="@index"
                                                aria-label="@($"{L["HomeCarouselShowVehicle"]} {index + 1}")"
                                                aria-current="@(index == 0 ? "true" : "false")"></button>
                                    }
                                </div>
                                <button class="hero-carousel-arrow" type="button" data-hero-carousel-next aria-label="@L["HomeCarouselNext"]">
                                    <i class="bi bi-chevron-right" aria-hidden="true"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="featured-car-card">
                        <div class="empty-featured-car">
                            <i class="bi bi-car-front-fill"></i>
                            <h2 class="fw-black mb-2">@L["HomeNoFeaturedVehicle"]</h2>
                            <p class="text-light opacity-75 mb-4">@L["HomeOfferAvailableOnVehicles"]</p>
                            <a href="@Url.Action("Index", "Vozilo")" class="oz-btn oz-btn-light">
                                <span>@L["HomeViewOffer"]</span>
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["HomeWhyEyebrow"]</p>
                <h2 class="section-title">@L["HomeWhyTitle"]</h2>
                <p class="section-text mb-0">@L["HomeWhyText"]</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-car-front-fill"></i></div>
                        <h3 class="h5 fw-bold">@L["HomeFeatureSelectionTitle"]</h3>
                        <p class="text-secondary mb-0">@L["HomeFeatureSelectionText"]</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
                        <h3 class="h5 fw-bold">@L["HomeFeaturePricesTitle"]</h3>
                        <p class="text-secondary mb-0">@L["HomeFeaturePricesText"]</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-patch-check-fill"></i></div>
                        <h3 class="h5 fw-bold">@L["HomeFeaturePurchaseTitle"]</h3>
                        <p class="text-secondary mb-0">@L["HomeFeaturePurchaseText"]</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-headset"></i></div>
                        <h3 class="h5 fw-bold">@L["HomeFeatureSupportTitle"]</h3>
                        <p class="text-secondary mb-0">@L["HomeFeatureSupportText"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-white" id="izdvojena-vozila">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <h2 class="section-title">@L["HomeFeaturedVehiclesTitle"]</h2>
            </div>
        </div>

        @if (featuredVehicles.Any())
        {
            <div class="row g-4">
                @foreach (var vehicle in featuredVehicles)
                {
                    var cardImage = !string.IsNullOrWhiteSpace(vehicle.Slika)
                        ? Url.Content($"~/images/vozila/{vehicle.Slika}")
                        : Url.Content("~/img/no-image.png");
                    var cardPrice = vehicle.Cijena.HasValue
                        ? $"€{vehicle.Cijena.Value.ToString("N0", culture)}"
                        : L["PriceOnRequest"].Value;
                    var cardMileage = vehicle.Kilometraza.HasValue
                        ? $"{vehicle.Kilometraza.Value.ToString("N0", culture)} km"
                        : L["MileageNotEntered"].Value;

                    <div class="col-md-6 col-lg-4">
                        <article class="home-vehicle-card h-100">
                            <a href="@Url.Action("Details", "Vozilo", new { id = vehicle.VoziloID, returnUrl = "/" })" class="home-vehicle-image-link">
                                <img src="@cardImage" class="home-vehicle-image" alt="@vehicle.Marka @vehicle.Model">
                            </a>

                            <div class="home-vehicle-body">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h3 class="h4 fw-black mb-0">
                                        <a href="@Url.Action("Details", "Vozilo", new { id = vehicle.VoziloID, returnUrl = "/" })"
                                           class="home-vehicle-title-link">@vehicle.Marka @vehicle.Model</a>
                                    </h3>
                                    <span class="fuel-chip @FuelPresentation.GetChipClass(vehicle.Gorivo)">@L[FuelPresentation.GetResourceKey(vehicle.Gorivo)]</span>
                                </div>

                                <p class="home-vehicle-meta mb-3">@vehicle.Godiste · @L[VehicleColorPresentation.GetResourceKey(vehicle.Boja)] · @cardMileage</p>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <span class="home-vehicle-price">@cardPrice</span>
                                    <a href="@Url.Action("Details", "Vozilo", new { id = vehicle.VoziloID, returnUrl = "/" })" class="home-details-link oz-text-link">@L["Details"]</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-vehicles-state">
                <i class="bi bi-car-front-fill"></i>
                <h3 class="h4 fw-bold mb-2">@L["HomeNoFeaturedVehicles"]</h3>
                <p class="section-text mb-0">@L["HomeNoFeaturedVehiclesText"]</p>
            </div>
        }
    </div>
</section>

<section class="section-padding home-contact-section">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="about-card h-100">
                    <p class="section-eyebrow text-info">@L["HomeCurrentOfferEyebrow"]</p>
                    <h2 class="section-title text-white">@L["HomeCurrentOfferTitle"]</h2>
                    <p class="text-light opacity-75 mb-4">@L["HomeCurrentOfferText"]</p>
                    <a href="@Url.Action("Index", "Vozilo")" class="oz-btn oz-btn-quiet">
                        <span>@L["HomeOpenVehicles"]</span>
                    </a>
                </div>
            </div>

            <div class="col-lg-7" id="podrska">
                <div class="support-card h-100">
                    <p class="section-eyebrow">@L["HomeSupportEyebrow"]</p>
                    <h2 class="section-title">@L["HomeSupportTitle"]</h2>
                    <p class="section-text mb-4">@L["HomeSupportText"]</p>
                    <ul class="support-list">
                        <li><i class="bi bi-check-circle-fill"></i>@L["HomeSupportPointResponse"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["HomeSupportPointChoice"]</li>
                        <li><i class="bi bi-check-circle-fill"></i>@L["HomeSupportPointAppointment"]</li>
                    </ul>
                    <a href="@Url.Action("Kontakt", "Home")" class="btn btn-primary btn-lg rounded-4 px-4">@L["HomeSendMessage"]</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/components/animated-search-placeholder.js" asp-append-version="true"></script>
    <script src="~/js/components/hero-vehicle-carousel.js" asp-append-version="true"></script>
}
