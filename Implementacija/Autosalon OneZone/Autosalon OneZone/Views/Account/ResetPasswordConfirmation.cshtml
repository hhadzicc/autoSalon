@{
    ViewData["Title"] = "Lozinka resetovana";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">Sigurnost naloga</p>
                <h1>Lozinka je promijenjena</h1>
                <p>Nova lozinka je sačuvana. Sada se možete prijaviti sa novim podacima.</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card text-center">
                    <div class="form-icon mx-auto">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <h2>Resetovanje završeno</h2>
                    <p class="text-muted mb-4">Vas nalog je spreman za prijavu sa novom lozinkom.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-4 w-100">Prijavi se</a>
                </div>
            </div>
        </div>
    </div>
</section>
