@model Autosalon_OneZone.ViewModels.Admin.PodrskaListViewModel
@using Autosalon_OneZone.Models

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Admin panel</p>
        <h1>Upiti za podršku</h1>
    </div>
</div>

<div class="admin-card" id="podrska-list-container">
    <div class="admin-toolbar">
        <div>
            <h2>Lista upita</h2>
            <span>Pretražite upite prema emailu, naslovu ili sadržaju poruke.</span>
        </div>

        <div class="admin-search-compact">
            <input type="text" id="podrska-search-input" class="form-control" placeholder="Pretraži email, naslov ili sadržaj..." value="@Model.SearchQuery" />
            <button id="podrska-search-button" class="search-submit-btn" type="button" aria-label="Pretraži upite">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Email korisnika</th>
                    <th>Naslov upita</th>
                    <th>Status</th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody id="podrska-table-body">
                <tr>
                    <td colspan="5">Učitavanje upita...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="podrska-mobile-list" class="admin-mobile-list"></div>
    <div id="pagination-controls"></div>
</div>

<div class="modal fade" id="messageModal" tabindex="-1" aria-labelledby="messageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-envelope-open-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="messageModalLabel">Poruka korisnika</h5>
                        <p class="mb-0 text-muted small">Pregled punog sadržaja upita.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="support-meta-grid">
                    <div><span>Email korisnika</span><strong id="messageModalEmail">-</strong></div>
                    <div><span>Naslov</span><strong id="messageModalTitle">-</strong></div>
                    <div><span>Datum</span><strong id="messageModalDate">-</strong></div>
                    <div><span>Status</span><strong id="messageModalStatus">-</strong></div>
                </div>
                <div class="message-box" id="messageModalBody"></div>
            </div>
            <div class="modal-footer modern-modal-footer">
                <a id="messageModalReply" href="#" class="btn btn-primary rounded-4">
                    <i class="bi bi-reply-fill me-2"></i>Odgovori
                </a>
                <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">Zatvori</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $(document).off('click', '.delete-podrska-button');
        $(document).off('click', '.status-option');
        $(document).off('click', '.message-text, .view-message-button');
        $(document).off('app:delete-confirmed', '.delete-podrska-button');
        $('#podrska-search-button').off('click');
        $('#podrska-search-input').off('keypress');

        const podrskaTableBody = $('#podrska-table-body');
        const podrskaMobileList = $('#podrska-mobile-list');
        const searchInput = $('#podrska-search-input');
        const searchButton = $('#podrska-search-button');

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatDateTime(dateString) {
            if (!dateString) return '';
            const date = new Date(dateString);
            if (isNaN(date.getTime())) return '';
            const day = String(date.getDate()).padStart(2, '0');
            const month = String(date.getMonth() + 1).padStart(2, '0');
            return day + '-' + month + '-' + date.getFullYear();
        }

        function statusLabel(status) {
            return status === 'UObradi' ? 'U obradi' : (status || 'N/A');
        }

        function getStatusBadge(status) {
            let className = 'secondary';
            switch (status) {
                case 'Poslat': className = 'info'; break;
                case 'UObradi': className = 'warning'; break;
                case 'Odgovoren': className = 'success'; break;
                case 'Zatvoren': className = 'secondary'; break;
            }
            return '<span class="support-status-badge status-' + className + '">' + escapeHtml(statusLabel(status)) + '</span>';
        }

        function createStatusDropdown(upitId, currentStatus) {
            return '<div class="dropdown status-dropdown">' +
                '<button class="btn btn-sm btn-light border rounded-3 dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">Status</button>' +
                '<ul class="dropdown-menu dropdown-menu-end">' +
                    '<li><a class="dropdown-item status-option ' + (currentStatus === 'Poslat' ? 'active' : '') + '" href="#" data-status="Poslat" data-upit-id="' + upitId + '">Poslat</a></li>' +
                    '<li><a class="dropdown-item status-option ' + (currentStatus === 'UObradi' ? 'active' : '') + '" href="#" data-status="UObradi" data-upit-id="' + upitId + '">U obradi</a></li>' +
                    '<li><a class="dropdown-item status-option ' + (currentStatus === 'Odgovoren' ? 'active' : '') + '" href="#" data-status="Odgovoren" data-upit-id="' + upitId + '">Odgovoren</a></li>' +
                    '<li><a class="dropdown-item status-option ' + (currentStatus === 'Zatvoren' ? 'active' : '') + '" href="#" data-status="Zatvoren" data-upit-id="' + upitId + '">Zatvoren</a></li>' +
                '</ul>' +
            '</div>';
        }

        function supportDataAttributes(upit) {
            const mailSubject = 'Odgovor na Vaš upit: ' + encodeURIComponent(upit.naslov || '');
            const mailBody = 'Poštovani ' + encodeURIComponent(upit.korisnikIme || '') + ',%0D%0A%0D%0AHvala na Vašem upitu.%0D%0A%0D%0A';
            const replyHref = 'mailto:' + encodeURIComponent(upit.korisnikEmail || '') + '?subject=' + mailSubject + '&body=' + mailBody;

            return 'data-full-text="' + encodeURIComponent(upit.sadrzaj || '') + '" ' +
                'data-email="' + encodeURIComponent(upit.korisnikEmail || 'N/A') + '" ' +
                'data-title="' + encodeURIComponent(upit.naslov || '') + '" ' +
                'data-date="' + encodeURIComponent(formatDateTime(upit.datumUpita)) + '" ' +
                'data-status="' + encodeURIComponent(statusLabel(upit.status)) + '" ' +
                'data-reply="' + replyHref + '"';
        }

        function viewMessageButton(upit) {
            return '<button class="btn btn-sm btn-outline-primary rounded-3 view-message-button" ' +
                supportDataAttributes(upit) +
                '><i class="bi bi-eye me-1"></i>Prikaži</button>';
        }

        function supportActions(upit) {
            const mailSubject = 'Odgovor na Vaš upit: ' + encodeURIComponent(upit.naslov || '');
            const mailBody = 'Poštovani ' + encodeURIComponent(upit.korisnikIme || '') + ',%0D%0A%0D%0AHvala na Vašem upitu.%0D%0A%0D%0A';
            const replyHref = 'mailto:' + encodeURIComponent(upit.korisnikEmail || '') + '?subject=' + mailSubject + '&body=' + mailBody;
            const item = 'Upit: ' + (upit.naslov || 'Bez naslova') + ' · ' + (upit.korisnikEmail || 'N/A');

            return '<div class="table-actions support-actions-grid">' +
                viewMessageButton(upit) +
                '<a href="' + replyHref + '" class="btn btn-sm btn-outline-primary rounded-3"><i class="bi bi-reply me-1"></i>Odgovori</a>' +
                createStatusDropdown(upit.upitID, upit.status) +
                '<button class="delete-podrska-button btn btn-sm btn-outline-danger rounded-3" data-id="' + upit.upitID + '" data-confirm-delete="true" data-confirm-title="Obrisati upit?" data-confirm-message="Da li ste sigurni da želite obrisati ovaj upit?" data-confirm-item="' + escapeAttribute(item) + '" data-confirm-action="Da, obriši upit"><i class="bi bi-trash me-1"></i>Obriši</button>' +
                '</div>';
        }

        function renderTickets(upiti) {
            podrskaTableBody.empty();
            podrskaMobileList.empty();

            if (!upiti || upiti.length === 0) {
                podrskaTableBody.html('<tr><td colspan="5"><div class="empty-state"><i class="bi bi-inbox"></i><p>Nema dostupnih upita za podršku.</p></div></td></tr>');
                podrskaMobileList.html('<div class="empty-state"><i class="bi bi-inbox"></i><p>Nema dostupnih upita za podršku.</p></div>');
                return;
            }

            upiti.forEach(upit => {
                const datum = formatDateTime(upit.datumUpita);
                const email = escapeHtml(upit.korisnikEmail || 'N/A');
                const naslov = escapeHtml(upit.naslov || 'Bez naslova');
                const actions = supportActions(upit);

                podrskaTableBody.append(
                    '<tr>' +
                        '<td class="date-cell">' + escapeHtml(datum) + '</td>' +
                        '<td><div class="user-cell"><span class="user-avatar"><i class="bi bi-envelope-fill"></i></span><strong>' + email + '</strong></div></td>' +
                        '<td><strong>' + naslov + '</strong></td>' +
                        '<td>' + getStatusBadge(upit.status) + '</td>' +
                        '<td>' + actions + '</td>' +
                    '</tr>'
                );

                podrskaMobileList.append(
                    '<article class="support-mobile-card">' +
                        '<div class="mobile-card-top">' +
                            '<span class="date-cell">' + escapeHtml(datum) + '</span>' +
                            getStatusBadge(upit.status) +
                        '</div>' +
                        '<h3>' + naslov + '</h3>' +
                        '<p class="mobile-user">' + email + '</p>' +
                        '<div class="review-mobile-meta">' +
                            '<div><span>Status</span><strong>' + escapeHtml(statusLabel(upit.status)) + '</strong></div>' +
                            '<div><span>Korisnik</span><strong>' + email + '</strong></div>' +
                        '</div>' +
                        '<div class="mobile-actions">' + actions + '</div>' +
                    '</article>'
                );
            });
        }

        function loadUpitiList(searchQuery = '', page = 1) {
            podrskaTableBody.html('<tr><td colspan="5">Učitavanje upita...</td></tr>');
            podrskaMobileList.html('<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Učitavanje upita...</p></div>');

            $.get('@Url.Action("GetPodrskaJson", "AdminPanel")', { searchQuery, page }, function (data) {
                renderTickets(data && data.upiti ? data.upiti : []);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                const message = escapeHtml(jqXHR.responseText || errorThrown || 'Greška');
                podrskaTableBody.html('<tr><td colspan="5"><div class="alert alert-danger mb-0">Greška prilikom učitavanja upita: ' + message + '</div></td></tr>');
                podrskaMobileList.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja upita: ' + message + '</div>');
            });
        }

        $(document).on('click', '.view-message-button', function () {
            $('#messageModalBody').text(decodeURIComponent($(this).data('full-text') || ''));
            $('#messageModalEmail').text(decodeURIComponent($(this).data('email') || '-'));
            $('#messageModalTitle').text(decodeURIComponent($(this).data('title') || '-'));
            $('#messageModalDate').text(decodeURIComponent($(this).data('date') || '-'));
            $('#messageModalStatus').text(decodeURIComponent($(this).data('status') || '-'));
            $('#messageModalReply').attr('href', $(this).data('reply') || '#');
            $('#messageModal').modal('show');
        });

        $(document).on('click', '.status-option', function (e) {
            e.preventDefault();
            const status = $(this).data('status');
            const upitId = $(this).data('upit-id');

            $.ajax({
                url: '@Url.Action("UpdatePodrskaStatus", "AdminPanel")',
                method: 'POST',
                data: { id: upitId, status: status },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.successMessage) {
                        alert(response.successMessage);
                    }
                    loadUpitiList(searchInput.val());
                },
                error: function () {
                    alert('Došlo je do greške prilikom promjene statusa.');
                }
            });
        });

        $(document).on('app:delete-confirmed', '.delete-podrska-button', function () {
            const upitId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("DeletePodrska", "AdminPanel")',
                method: 'POST',
                data: { id: upitId },
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.successMessage) {
                        alert(response.successMessage);
                    }
                    loadUpitiList(searchInput.val());
                },
                error: function () {
                    alert('Došlo je do greške prilikom brisanja upita.');
                }
            });
        });

        searchButton.on('click', function () {
            loadUpitiList(searchInput.val());
        });

        searchInput.on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                searchButton.click();
            }
        });

        loadUpitiList('@Model.SearchQuery');
    });
</script>
