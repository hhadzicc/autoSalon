@using Microsoft.AspNetCore.Identity
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager
@inject UserManager<Autosalon_OneZone.Models.ApplicationUser> UserManager
@model Autosalon_OneZone.ViewModels.KontaktViewModel
@{
    ViewData["Title"] = L["ContactTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isSignedIn = SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated;
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["ContactEyebrow"]</p>
                <h1>@L["ContactHeaderTitle"]</h1>
                <p>@L["ContactHeaderText"]</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center align-items-start g-4">
            <div class="col-lg-7 col-xl-6">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi @(isSignedIn ? "bi-chat-dots-fill" : "bi-envelope-paper-fill")"></i>
                        </div>
                        <h2>@(isSignedIn ? L["ContactSendMessageHeading"] : L["ContactSupportRequestHeading"])</h2>
                        <p class="text-muted mb-0">@(isSignedIn ? L["ContactSignedInText"] : L["ContactGuestText"])</p>
                    </div>

                    @if (isSignedIn)
                    {
                        <form asp-controller="Home" asp-action="Kontakt" method="post" id="contact-form">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Naslov" class="form-label">@L["ContactSubject"]</label>
                                <input asp-for="Naslov" class="form-control" placeholder="@L["ContactSubjectPlaceholder"]" />
                                <span asp-validation-for="Naslov" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Sadrzaj" class="form-label">@L["ContactMessage"]</label>
                                <textarea asp-for="Sadrzaj" class="form-control" rows="6" placeholder="@L["ContactMessagePlaceholder"]"></textarea>
                                <span asp-validation-for="Sadrzaj" class="text-danger"></span>
                            </div>

                            <button type="submit" id="send-message" class="btn btn-primary btn-lg rounded-4 w-100">@L["ContactSendMessage"]</button>
                        </form>
                    }
                    else
                    {
                        <div class="contact-choice text-center">
                            <p class="text-muted mb-4">@L["ContactGuestDetails"]</p>
                            <div class="d-grid gap-3">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-4">@L["ContactLoginToSend"]</a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg rounded-4">@L["NavRegister"]</a>
                                <a href="mailto:autosalon@autosalon.com" class="btn btn-light border btn-lg rounded-4">@L["ContactDirectEmail"]</a>
                            </div>
                        </div>
                    }

                    <p class="small text-muted text-center mt-4 mb-0">@L["ContactFooterNote"]</p>
                </div>
            </div>

            <div class="col-lg-5 col-xl-4">
                <aside class="info-card">
                    <h3>@L["ContactInfoTitle"]</h3>

                    <div class="info-item">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <strong>@L["EmailAddress"]</strong>
                            <span>autosalon@autosalon.com</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <strong>@L["ContactPhone"]</strong>
                            <span>+387 000 000 000</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock-fill"></i>
                        <div>
                            <strong>@L["ContactResponseTime"]</strong>
                            <span>@L["ContactResponseSoon"]</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-car-front-fill"></i>
                        <div>
                            <strong>@L["ContactInquiries"]</strong>
                            <span>@L["ContactInquiryTypes"]</span>
                        </div>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
