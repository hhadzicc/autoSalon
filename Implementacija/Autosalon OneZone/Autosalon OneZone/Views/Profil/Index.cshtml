@model Autosalon_OneZone.Models.ViewModels.ProfileViewModel
@using Autosalon_OneZone.Authorization
@{
    ViewData["Title"] = L["NavMyProfile"];
}

<section class="profile-section">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <div class="col-lg-5">
                <div class="profile-card text-center h-100">
                    <div class="profile-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <h2>@Model.ImePrezime</h2>
                    <span class="role-badge">@Model.Role</span>

                    <div class="profile-info mt-4">
                        <div>
                            <span>@L["FullName"]</span>
                            <strong>@Model.ImePrezime</strong>
                        </div>
                        <div>
                            <span>@L["EmailAddress"]</span>
                            <strong>@Model.Email</strong>
                        </div>
                        <div>
                            <span>@L["Username"]</span>
                            <strong>@Model.UserName</strong>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="profile-card h-100">
                    <h3>@L["QuickActions"]</h3>

                    <div class="d-grid gap-3 mt-4">
                        <a href="@Url.Action("Edit", "Profil")" class="btn btn-primary btn-lg rounded-4">
                            <i class="bi bi-pencil-square me-2"></i>@L["EditProfile"]
                        </a>
                        @if (User.IsInRole(AppRoles.Buyer))
                        {
                            <a href="@Url.Action("KupljeniArtikli", "Profil")" class="btn btn-outline-primary btn-lg rounded-4">
                                <i class="bi bi-bag-check me-2"></i>@L["NavPurchasedItems"]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
