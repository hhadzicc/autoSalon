@model Autosalon_OneZone.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = L["ResetPasswordTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["ResetPasswordEyebrow"]</p>
                <h1>@L["ResetPasswordTitle"]</h1>
                <p>@L["ResetPasswordSubtitle"]</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h2>@L["NewPassword"]</h2>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary mb-3"></div>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Code" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@L["NewPassword"]</label>
                            <div class="password-wrapper">
                                <input asp-for="Password" type="password" class="form-control password-input" placeholder="@L["NewPasswordPlaceholder"]" autocomplete="new-password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="@L["PasswordPolicyError"]" />
                                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">@L["ConfirmNewPassword"]</label>
                            <div class="password-wrapper">
                                <input asp-for="ConfirmPassword" type="password" class="form-control password-input" placeholder="@L["ConfirmNewPasswordPlaceholder"]" autocomplete="new-password" required />
                                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg rounded-4 w-100">@L["ResetPasswordSubmit"]</button>

                        <div class="text-center mt-4 d-flex justify-content-center gap-3 flex-wrap">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="fw-bold">@L["RequestNewLink"]</a>
                            <a asp-controller="Account" asp-action="Login" class="fw-bold">@L["BackToLogin"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
