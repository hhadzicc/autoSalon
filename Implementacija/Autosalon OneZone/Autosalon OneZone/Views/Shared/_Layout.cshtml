@using Microsoft.AspNetCore.Identity
@using Autosalon_OneZone.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isAdminArea = currentPath.StartsWith("/adminpanel");
    var isVehiclesArea = currentPath.StartsWith("/vozilo");
    var isContactArea = currentPath.StartsWith("/home/kontakt");
    var isCartArea = currentPath.StartsWith("/korpa");
    var isProfileArea = currentPath.StartsWith("/profil");
    var isLoginArea = currentPath.StartsWith("/account/login");
    var isRegisterArea = currentPath.StartsWith("/account/register");
    var successMessage = Convert.ToString(TempData["SuccessMessage"]);
    var errorMessage = Convert.ToString(TempData["ErrorMessage"]);
    var infoMessage = Convert.ToString(TempData["InfoMessage"]);
    var warningMessage = Convert.ToString(TempData["WarningMessage"]);
    var hasFlashMessage =
        !string.IsNullOrWhiteSpace(successMessage) ||
        !string.IsNullOrWhiteSpace(errorMessage) ||
        !string.IsNullOrWhiteSpace(infoMessage) ||
        !string.IsNullOrWhiteSpace(warningMessage);
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Autosalon OneZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="~/css/kod.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top">
        <div class="container-xxl align-items-center">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" href="/">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                Autosalon OneZone
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Administrator") || User.IsInRole("Prodavac")))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isAdminArea ? "active" : "")" href="/AdminPanel/Index">
                                <i class="bi bi-speedometer2 me-lg-1"></i>Admin Panel
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(isVehiclesArea ? "active" : "")" href="/Vozilo">Vozila</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isContactArea ? "active" : "")" href="/Home/Kontakt">Piši nam</a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link @(isCartArea ? "active" : "")" href="/Korpa">
                                <i class="bi bi-cart-fill me-lg-1"></i>Korpa
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isProfileArea ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-lg-1"></i>Moj profil
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-menu">
                                <li>
                                    <a class="dropdown-item" href="/Profil">
                                        <i class="bi bi-person-fill me-2"></i>Profil
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/KupljeniArtikli">
                                        <i class="bi bi-bag-check-fill me-2"></i>Kupljeni artikli
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/Edit#password">
                                        <i class="bi bi-key-fill me-2"></i>Promijeni lozinku
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Odjavi se
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isLoginArea ? "active" : "")" href="/Account/Login">Prijavi se</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link register-link @(isRegisterArea ? "active" : "")" id="register" href="/Account/Register">Registruj se</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content-container">
        @if (hasFlashMessage)
        {
            <div class="flash-messages" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(infoMessage))
                {
                    <div class="alert alert-info alert-dismissible fade show app-alert" role="alert">
                        @infoMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    <div class="alert alert-warning alert-dismissible fade show app-alert" role="alert">
                        @warningMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Zatvori"></button>
                    </div>
                }
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container-xxl">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h5 class="text-white fw-bold mb-2">Autosalon OneZone</h5>
                    <p class="mb-1">Kontakt: +387 000 000 000 · Email: <a href="mailto:autosalon@autosalon.com">autosalon@autosalon.com</a></p>
                    <p class="mb-0">&copy; @DateTime.Now.Year Autosalon OneZone. Sva prava zadržana.</p>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex justify-content-lg-end gap-3 flex-wrap">
                        <a href="#">Politika privatnosti</a>
                        <a href="#">Uslovi korišćenja</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="globalDeleteConfirmModal" tabindex="-1" aria-labelledby="globalDeleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-confirm-modal">
                <div class="modal-header border-0">
                    <div class="delete-modal-heading">
                        <div class="delete-modal-icon">
                            <i class="bi bi-trash-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="globalDeleteConfirmTitle">Potvrda brisanja</h5>
                            <p class="mb-0 text-muted small">Ova akcija se ne može jednostavno poništiti.</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zatvori"></button>
                </div>
                <div class="modal-body">
                    <p id="globalDeleteConfirmMessage" class="delete-confirm-message">
                        Da li ste sigurni da želite obrisati ovu stavku?
                    </p>
                    <div id="globalDeleteConfirmItem" class="delete-confirm-item d-none"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">Odustani</button>
                    <button type="button" class="btn btn-danger rounded-4" id="globalDeleteConfirmButton">Da, obriši</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("BottomScripts", required: false)
</body>
</html>
