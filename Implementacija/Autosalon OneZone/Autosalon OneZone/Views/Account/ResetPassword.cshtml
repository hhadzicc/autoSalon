@model Autosalon_OneZone.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Postavi novu lozinku";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">Sigurnost naloga</p>
                <h1>Postavi novu lozinku</h1>
                <p>Unesite novu lozinku za svoj nalog i potvrdite je prije čuvanja promjene.</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi bi-key-fill"></i>
                        </div>
                        <h2>Nova lozinka</h2>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary mb-3"></div>

                    <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Code" type="hidden" />

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Nova lozinka</label>
                            <div class="password-wrapper">
                                <input asp-for="Password" type="password" class="form-control password-input" placeholder="Unesite novu lozinku" autocomplete="new-password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" data-val-required="Nova lozinka je obavezna." />
                                <button type="button" class="password-toggle" aria-label="Prikaži lozinku">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Potvrda nove lozinke</label>
                            <div class="password-wrapper">
                                <input asp-for="ConfirmPassword" type="password" class="form-control password-input" placeholder="Potvrdite novu lozinku" autocomplete="new-password" required data-val-required="Potvrda nove lozinke je obavezna." data-val-equalto="Nova lozinka i potvrda lozinke se ne podudaraju." />
                                <button type="button" class="password-toggle" aria-label="Prikaži lozinku">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg rounded-4 w-100">Resetuj lozinku</button>

                        <div class="text-center mt-4 d-flex justify-content-center gap-3 flex-wrap">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="fw-bold">Zatraži novi link</a>
                            <a asp-controller="Account" asp-action="Login" class="fw-bold">Nazad na prijavu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            $('.password-toggle').on('click', function() {
                var button = $(this);
                var input = button.closest('.password-wrapper').find('.password-input');
                var icon = button.find('i');
                var isPassword = input.attr('type') === 'password';

                input.attr('type', isPassword ? 'text' : 'password');
                icon.toggleClass('bi-eye', !isPassword);
                icon.toggleClass('bi-eye-slash', isPassword);
                button.attr('aria-label', isPassword ? 'Sakrij lozinku' : 'Prikaži lozinku');
            });
        });
    </script>
}
