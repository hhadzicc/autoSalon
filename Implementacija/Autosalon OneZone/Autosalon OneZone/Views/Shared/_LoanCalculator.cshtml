@using System.Globalization
@model Autosalon_OneZone.Models.ViewModels.LoanCalculatorViewModel

<div class="loan-card mt-4" data-loan-calculator>
    <div class="loan-card-header">
        <div class="loan-icon">
            <i class="bi bi-calculator"></i>
        </div>
        <div>
            <h3>@L["LoanCalculator"]</h3>
            <p>@L["LoanCalculatorText"]</p>
        </div>
    </div>

    <div class="mb-3">
        <label for="loan-amount" class="form-label">@L["LoanAmountEuro"]</label>
        <input type="number"
               class="form-control"
               id="loan-amount"
               min="0"
               step="0.01"
               value="@(Model.InitialAmount?.ToString(CultureInfo.InvariantCulture))"
               placeholder="@L["EnterAmount"]"
               data-loan-amount>
    </div>

    <div class="mb-3">
        <label for="loan-period" class="form-label">@L["InstallmentCount"]</label>
        <select class="form-select" id="loan-period" data-loan-period>
            @foreach (var period in new[] { 12, 24, 36, 48, 60, 72 })
            {
                <option value="@period" selected="@(Model.DefaultPeriod == period)">@L["MonthsCount", period]</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label for="interest-rate" class="form-label">@L["InterestRate"]</label>
        <input type="number"
               class="form-control"
               id="interest-rate"
               value="@Model.InterestRate.ToString(CultureInfo.InvariantCulture)"
               step="0.1"
               min="0"
               data-loan-interest>
    </div>

    <button type="button" class="btn btn-secondary rounded-4 w-100" data-loan-calculate>@L["Calculate"]</button>

    <div class="loan-result">
        <span>@L["MonthlyInstallment"]</span>
        <strong data-loan-result>€0</strong>
    </div>

</div>
