@model Autosalon_OneZone.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = L["ForgotPasswordTitle"];
}

<section class="auth-section forgot-password-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 forgot-password-shell">
                <div class="modern-form-card forgot-password-card">
                    <h1>@L["ForgotPasswordHeading"]</h1>
                    <p class="forgot-password-intro">@L["ForgotPasswordSubtitle"]</p>

                    <div asp-validation-summary="All" class="account-validation-summary validation-summary"></div>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate
                          data-account-validation="forgot"
                          data-check-fields-message="@L["Validation.CheckMarkedFields"]">
                        <div class="forgot-password-field">
                            <label asp-for="Email" class="form-label">@L["EmailAddress"]</label>
                            <div class="forgot-password-input">
                                <i class="bi bi-envelope" aria-hidden="true"></i>
                                <input asp-for="Email" type="email" class="form-control" placeholder="korisnik@example.com" autocomplete="email" required pattern="@UserInputPatterns.EmailHtml"
                                       data-account-field="email"
                                       data-required-message="@L["Validation.EmailRequired"]"
                                       data-invalid-message="@L["Validation.EmailValid"]" />
                            </div>
                            <span asp-validation-for="Email" class="account-validation-message"></span>
                        </div>

                        <button type="submit" class="btn btn-primary forgot-password-submit">@L["ForgotPasswordSubmit"]</button>

                        <a asp-controller="Account" asp-action="Login" class="forgot-password-back">
                            <i class="bi bi-arrow-left" aria-hidden="true"></i>
                            <span>@L["BackToLogin"]</span>
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/components/account-validation.js" asp-append-version="true"></script>
}
