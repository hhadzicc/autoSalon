@using System.Globalization
@model Autosalon_OneZone.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = L["CartTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
    var culture = CultureInfo.CurrentCulture;
}

<section class="inner-page-header">
    <div class="container text-center">
        <p class="section-eyebrow">@L["Purchase"]</p>
        <h1>@L["CartHeaderTitle"]</h1>
        <p>@L["CartHeaderText"]</p>
    </div>
</section>

<section class="cart-page-section">
    <div class="container">
        @if (Model.VozilaUKorpi.Count == 0)
        {
            <div class="empty-cart-wrap">
                <div class="empty-cart-card">
                    <div class="empty-cart-icon">
                        <i class="bi bi-cart-x"></i>
                    </div>

                    <h2>@L["CartEmptyTitle"]</h2>
                    <p>@L["CartEmptyText"]</p>

                    <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary btn-lg rounded-4">
                        <i class="bi bi-car-front-fill me-2"></i>@L["BrowseVehicles"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="row g-4 align-items-start">
                <div class="col-lg-8">
                    <div class="cart-toolbar d-flex justify-content-between align-items-center flex-wrap gap-3">
                        <div class="fw-bold">
                            @L["TotalVehicles"]
                            <span class="badge rounded-pill text-bg-primary">@Model.VozilaUKorpi.Count</span>
                        </div>

                        <div class="cart-sort d-flex align-items-center gap-2">
                            <label for="sortOptions" class="fw-bold text-secondary">@L["SortBy"]</label>
                            <select id="sortOptions" class="form-select">
                                <option value="naziv_asc">@L["SortNameAsc"]</option>
                                <option value="naziv_desc">@L["SortNameDesc"]</option>
                                <option value="cijena_asc">@L["SortPriceAsc"]</option>
                                <option value="cijena_desc">@L["SortPriceDesc"]</option>
                                <option value="godiste_asc">@L["SortYearAsc"]</option>
                                <option value="godiste_desc">@L["SortYearDesc"]</option>
                            </select>
                        </div>
                    </div>

                    <div id="stavkeKorpe" class="cart-items-list">
                        @foreach (var vozilo in Model.VozilaUKorpi)
                        {
                            <article class="cart-item-card stavka-korpe"
                                     data-naziv="@vozilo.Naziv"
                                     data-cijena="@vozilo.Cijena"
                                     data-godiste="@vozilo.Godiste">
                                <div class="cart-item-image">
                                    <img src="@vozilo.SlikaUrl" alt="@vozilo.Naziv">
                                </div>

                                <div class="cart-item-content">
                                    <div>
                                        <span class="cart-item-badge">@L["InCart"]</span>
                                        <h3 class="card-title">@vozilo.Naziv</h3>

                                        <div class="cart-meta">
                                            <span class="text-muted"><i class="bi bi-calendar3"></i>@L["VehicleYear"]: @vozilo.Godiste</span>
                                            <span class="text-muted"><i class="bi bi-fuel-pump"></i>@L["VehicleFuel"]: @vozilo.Gorivo</span>
                                        </div>

                                        <div class="cart-price text-success">€@vozilo.Cijena.ToString("N0", culture)</div>
                                    </div>

                                    <div class="cart-actions">
                                        <a href="@Url.Action("Details", "Vozilo", new { id = vozilo.Id })" class="btn btn-light border rounded-4">
                                            <i class="bi bi-info-circle me-2"></i>@L["Details"]
                                        </a>
                                        <button type="button" class="btn btn-primary rounded-4 buy-now-btn"
                                                data-bs-toggle="modal" data-bs-target="#paymentModal"
                                                data-id="@vozilo.Id" data-cijena="@vozilo.Cijena" data-naziv="@vozilo.Naziv">
                                            <i class="bi bi-credit-card me-2"></i>@L["Buy"]
                                        </button>
                                        <form asp-controller="Korpa" asp-action="UkloniIzKorpe" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@vozilo.Id">
                                            <button type="submit" class="btn btn-outline-danger rounded-4 w-100">
                                                <i class="bi bi-trash me-2"></i>@L["Remove"]
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <aside class="cart-sidebar">
                        <div class="checkout-card">
                            <h3>@L["PurchaseOverview"]</h3>

                            <div class="summary-row">
                                <span>@L["VehicleCount"]</span>
                                <strong>@Model.VozilaUKorpi.Count</strong>
                            </div>

                            <div class="summary-row">
                                <span>@L["TotalAmount"]</span>
                                <strong>€@Model.UkupnaCijena.ToString("N0", culture)</strong>
                            </div>

                            <div class="summary-total">
                                <span>@L["PaymentDue"]</span>
                                <strong>€@Model.UkupnaCijena.ToString("N0", culture)</strong>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="button" class="btn btn-success btn-lg rounded-4" id="checkoutButton" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                                    <i class="bi bi-bag-check me-2"></i>@L["ContinueToCheckout"]
                                </button>
                                <form asp-controller="Korpa" asp-action="OcistiKorpu" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-danger rounded-4 w-100"
                                            data-confirm-delete="true"
                                            data-confirm-title="@L["ClearCartConfirmTitle"]"
                                            data-confirm-message="@L["ClearCartConfirmMessage"]"
                                            data-confirm-item="@L["ClearCartConfirmItem"]"
                                            data-confirm-action="@L["ClearCartConfirmAction"]">
                                        <i class="bi bi-cart-x me-2"></i>@L["ClearCart"]
                                    </button>
                                </form>
                            </div>
                        </div>

                        @await Html.PartialAsync("_LoanCalculator")
                    </aside>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.VozilaUKorpi.Count > 0)
{
    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content modern-modal">
                <div class="modal-header modern-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="checkoutModalLabel">@L["CheckoutTitle"]</h5>
                            <p class="mb-0 text-muted small">@L["CheckoutText"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <h6>@L["SelectVehiclesForPurchase"]</h6>
                        <div class="alert alert-info small">
                            <i class="bi bi-info-circle-fill"></i> @L["SelectAtLeastOneVehicle"]
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th width="5%">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="selectAll" checked>
                                            </div>
                                        </th>
                                        <th>@L["Vehicle"]</th>
                                        <th class="text-end">@L["VehiclePrice"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vozilo in Model.VozilaUKorpi)
                                    {
                                        <tr>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input vozilo-checkbox" type="checkbox"
                                                           data-id="@vozilo.Id"
                                                           data-naziv="@vozilo.Naziv"
                                                           data-cijena="@vozilo.Cijena.ToString(CultureInfo.InvariantCulture)"
                                                           checked>
                                                </div>
                                            </td>
                                            <td>@vozilo.Naziv (@vozilo.Godiste)</td>
                                            <td class="text-end">€@vozilo.Cijena.ToString("N0", culture)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-active">
                                        <th colspan="2" class="text-end">@L["Total"]</th>
                                        <th class="text-end" id="checkoutTotal">€@Model.UkupnaCijena.ToString("N0", culture)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <form id="checkoutForm" asp-controller="Korpa" asp-action="IzvrsiPlacanjeSvih" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OdabranaVozilaJSON" id="odabranaVozilaJSON" value="" />
                        @await Html.PartialAsync("_PaymentFields", "checkout")
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success" id="checkoutSubmitBtn">@L["ConfirmPurchase"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modern-modal">
                <div class="modal-header modern-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon">
                            <i class="bi bi-credit-card-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="paymentModalLabel">@L["PaymentDetails"]</h5>
                            <p class="mb-0 text-muted small">@L["PaymentDetailsText"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info mb-4">
                        <strong>@L["TotalToPay"]</strong> <span id="modalUkupnaCijena"></span>
                    </div>

                    <form id="paymentForm" asp-controller="Korpa" asp-action="IzvrsiPlacanje" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="VoziloID" id="modalVoziloID" value="" />
                        @await Html.PartialAsync("_PaymentFields", "")
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" id="submitPayment">@L["ConfirmPurchase"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        const cartTexts = {
            processing: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Processing"].Value)),
            confirmPurchase: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["ConfirmPurchase"].Value)),
            selectOne: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["SelectAtLeastOneVehicle"].Value)),
            paymentFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentFailedPrefix"].Value)),
            requestError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentRequestError"].Value)),
            requestErrorWithDetail: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentRequestErrorWithDetail"].Value)),
            holderRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentHolderRequired"].Value)),
            holderFullName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentHolderFullName"].Value)),
            cardRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardRequired"].Value)),
            cardLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardLength"].Value)),
            expiryRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryRequired"].Value)),
            expiryFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryFormat"].Value)),
            cardExpired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardExpired"].Value)),
            cvvRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvRequired"].Value)),
            cvvLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvLength"].Value))
        };

        $(document).ready(function() {
            initializeCartSorting();
            initializeLoanCalculator();
            initializePaymentModal();
            initializeCheckoutModal();
        });

        function initializeCartSorting() {
            $("#sortOptions").change(function() {
                var sortType = $(this).val();
                var stavke = $(".stavka-korpe").get();

                stavke.sort(function(a, b) {
                    var $a = $(a);
                    var $b = $(b);

                    switch (sortType) {
                        case "naziv_asc":
                            return $a.data("naziv").localeCompare($b.data("naziv"));
                        case "naziv_desc":
                            return $b.data("naziv").localeCompare($a.data("naziv"));
                        case "cijena_asc":
                            return parseFloat($a.data("cijena")) - parseFloat($b.data("cijena"));
                        case "cijena_desc":
                            return parseFloat($b.data("cijena")) - parseFloat($a.data("cijena"));
                        case "godiste_asc":
                            return parseInt($a.data("godiste")) - parseInt($b.data("godiste"));
                        case "godiste_desc":
                            return parseInt($b.data("godiste")) - parseInt($a.data("godiste"));
                        default:
                            return 0;
                    }
                });

                $("#stavkeKorpe").append(stavke);
            });
        }

        function initializeLoanCalculator() {
            updateLoanCalculation();
            $("#calculateBtn").click(updateLoanCalculation);
            $("#loan-amount, #loan-period, #interest-rate").on("change input", updateLoanCalculation);
        }

        function updateLoanCalculation() {
            var loanAmount = parseFloat($("#loan-amount").val());
            var loanPeriod = parseInt($("#loan-period").val());
            var interestRate = parseFloat($("#interest-rate").val());

            if (isNaN(loanAmount) || loanAmount <= 0 || isNaN(loanPeriod) || loanPeriod <= 0 || isNaN(interestRate) || interestRate < 0) {
                $("#loan-result").text("€0");
                return;
            }

            var monthlyRate = (interestRate / 100) / 12;
            var monthlyPayment = loanAmount * monthlyRate * Math.pow(1 + monthlyRate, loanPeriod) /
                (Math.pow(1 + monthlyRate, loanPeriod) - 1);

            $("#loan-result").text("€" + monthlyPayment.toFixed(2));
        }

        function initializePaymentModal() {
            $(".buy-now-btn").on("click", function() {
                var button = $(this);
                $("#modalVoziloID").val(button.data("id"));
                $("#modalUkupnaCijena").text("€" + Number(button.data("cijena")).toLocaleString());
            });

            $("#paymentModal").on("show.bs.modal", function() {
                resetPaymentForm("#paymentForm", "#submitPayment");
            });

            bindPaymentFields("");

            $("#paymentForm").on("submit", function(e) {
                e.preventDefault();
                submitPaymentForm($(this), "#submitPayment");
            });
        }

        function initializeCheckoutModal() {
            $("#selectAll").on("change", function() {
                $(".vozilo-checkbox").prop("checked", $(this).is(":checked"));
                updateCheckoutTotal();
            });

            $(".vozilo-checkbox").on("change", updateCheckoutTotal);

            $("#checkoutModal").on("show.bs.modal", updateCheckoutTotal);
            bindPaymentFields("checkout");

            $("#checkoutForm").on("submit", function(e) {
                e.preventDefault();

                var selected = getSelectedVehicles();
                if (!selected.length) {
                    window.showAppFlashMessage(cartTexts.selectOne, "warning");
                    return;
                }

                $("#odabranaVozilaJSON").val(JSON.stringify(selected));
                submitPaymentForm($(this), "#checkoutSubmitBtn");
            });
        }

        function getSelectedVehicles() {
            return $(".vozilo-checkbox:checked").map(function() {
                return {
                    VoziloID: $(this).data("id"),
                    Naziv: $(this).data("naziv"),
                    Cijena: parseFloat($(this).data("cijena"))
                };
            }).get();
        }

        function updateCheckoutTotal() {
            var total = getSelectedVehicles().reduce(function(sum, item) {
                return sum + item.Cijena;
            }, 0);

            $("#checkoutTotal").text("€" + total.toLocaleString(undefined, { maximumFractionDigits: 0 }));
            $("#selectAll").prop("checked", $(".vozilo-checkbox").length === $(".vozilo-checkbox:checked").length);
        }

        function bindPaymentFields(prefix) {
            var idPrefix = prefix || "";
            var holder = "#" + idPrefix + "ImeVlasnika";
            var card = "#" + idPrefix + "BrojKartice";
            var expiry = "#" + idPrefix + "DatumIsteka";
            var cvv = "#" + idPrefix + "Cvv";

            $(holder).on("input", function() {
                var value = $(this).val();
                var filteredValue = value.replace(/[^A-Za-z ]/g, "");
                if (value !== filteredValue) {
                    $(this).val(filteredValue);
                }
                clearError(idPrefix + "ImeVlasnika");
            });

            $(card).on("input", function() {
                var value = $(this).val().replace(/\D/g, "").substring(0, 16);
                var formattedValue = value.replace(/(.{4})/g, "$1 ").trim();
                $(this).val(formattedValue);
                clearError(idPrefix + "BrojKartice");
            });

            $(expiry).on("input", function() {
                var value = $(this).val().replace(/\D/g, "").substring(0, 4);
                if (value.length > 2) {
                    value = value.substring(0, 2) + "/" + value.substring(2);
                }
                $(this).val(value);
                clearError(idPrefix + "DatumIsteka");
            });

            $(cvv).on("input", function() {
                $(this).val($(this).val().replace(/\D/g, "").substring(0, 3));
                clearError(idPrefix + "Cvv");
            });
        }

        function submitPaymentForm(form, buttonSelector) {
            var prefix = form.attr("id") === "checkoutForm" ? "checkout" : "";
            clearAllErrors(form);

            if (!validatePaymentForm(prefix)) {
                return;
            }

            var button = $(buttonSelector);
            button.prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> ' + cartTexts.processing);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function(response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                        return;
                    }

                    if (response.errors) {
                        $.each(response.errors, function(field, message) {
                            showError(prefix + field, message);
                        });
                    } else if (response.message) {
                        $(".modal.show").modal("hide");
                        window.showAppFlashMessage(cartTexts.paymentFailed + response.message, "error");
                    }

                    button.prop("disabled", false).html(cartTexts.confirmPurchase);
                },
                error: function(xhr, status, error) {
                    $(".modal.show").modal("hide");
                    var message = error ? cartTexts.requestErrorWithDetail + error : cartTexts.requestError;
                    window.showAppFlashMessage(message, "error");
                    button.prop("disabled", false).html(cartTexts.confirmPurchase);
                }
            });
        }

        function validatePaymentForm(prefix) {
            var idPrefix = prefix || "";
            var isValid = true;
            var holderValue = $("#" + idPrefix + "ImeVlasnika").val().trim();

            if (!holderValue) {
                showError(idPrefix + "ImeVlasnika", cartTexts.holderRequired);
                isValid = false;
            } else if (!holderValue.includes(" ")) {
                showError(idPrefix + "ImeVlasnika", cartTexts.holderFullName);
                isValid = false;
            }

            var cardValue = $("#" + idPrefix + "BrojKartice").val().replace(/\s+/g, "");
            if (!cardValue) {
                showError(idPrefix + "BrojKartice", cartTexts.cardRequired);
                isValid = false;
            } else if (cardValue.length !== 16) {
                showError(idPrefix + "BrojKartice", cartTexts.cardLength);
                isValid = false;
            }

            var expiryValue = $("#" + idPrefix + "DatumIsteka").val().trim();
            if (!expiryValue) {
                showError(idPrefix + "DatumIsteka", cartTexts.expiryRequired);
                isValid = false;
            } else {
                var parts = expiryValue.split("/");
                if (parts.length !== 2 || !/^(0[1-9]|1[0-2])$/.test(parts[0]) || !/^\d{2}$/.test(parts[1])) {
                    showError(idPrefix + "DatumIsteka", cartTexts.expiryFormat);
                    isValid = false;
                } else {
                    var month = parseInt(parts[0]);
                    var year = parseInt("20" + parts[1]);
                    var now = new Date();
                    if (year < now.getFullYear() || (year === now.getFullYear() && month < now.getMonth() + 1)) {
                        showError(idPrefix + "DatumIsteka", cartTexts.cardExpired);
                        isValid = false;
                    }
                }
            }

            var cvvValue = $("#" + idPrefix + "Cvv").val().trim();
            if (!cvvValue) {
                showError(idPrefix + "Cvv", cartTexts.cvvRequired);
                isValid = false;
            } else if (cvvValue.length !== 3) {
                showError(idPrefix + "Cvv", cartTexts.cvvLength);
                isValid = false;
            }

            return isValid;
        }

        function showError(fieldId, message) {
            $("#" + fieldId).addClass("is-invalid border-danger");
            $("#" + fieldId + "Error").text(message);
        }

        function clearError(fieldId) {
            $("#" + fieldId).removeClass("is-invalid border-danger");
            $("#" + fieldId + "Error").text("");
        }

        function clearAllErrors(scope) {
            var root = scope || $(document);
            root.find(".form-control").removeClass("is-invalid border-danger");
            root.find(".error-message").text("");
        }

        function resetPaymentForm(formSelector, buttonSelector) {
            var form = $(formSelector);
            if (form.length) {
                form[0].reset();
            }
            clearAllErrors(form);
            $(buttonSelector).prop("disabled", false).html(cartTexts.confirmPurchase);
        }
    </script>
}
