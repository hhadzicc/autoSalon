@model Autosalon_OneZone.ViewModels.Admin.AddVoziloViewModel
@using System.Text.Json

@Html.AntiForgeryToken()

@{
    var isEdit = Model.VoziloID > 0;
    var editVehicle = Model as Autosalon_OneZone.ViewModels.Admin.EditVoziloViewModel;
    var hasExistingImage = !string.IsNullOrWhiteSpace(editVehicle?.PostojecaSlikaPath);
    var selectedColor = Model.Boja;
    var selectedColorLabel = selectedColor.HasValue
        ? L[VehicleColorPresentation.GetResourceKey(selectedColor.Value)].Value
        : L["SelectVehicleColor"].Value;
    var selectedFuel = Enum.TryParse<TipGoriva>(Model.Gorivo, true, out var parsedFuel)
        ? parsedFuel
        : (TipGoriva?)null;
    var selectedFuelLabel = selectedFuel.HasValue
        ? L[FuelPresentation.GetResourceKey(selectedFuel.Value)].Value
        : L["SelectFuelType"].Value;
    var vehicleFormTexts = new Dictionary<string, string>
    {
        ["makeRequired"] = L["Validation.VehicleMakeRequiredClient"].Value,
        ["makeMax"] = L["Validation.VehicleMakeMaxLength"].Value,
        ["modelRequired"] = L["Validation.VehicleModelRequiredClient"].Value,
        ["modelMax"] = L["Validation.VehicleModelMaxLength"].Value,
        ["yearRequired"] = L["Validation.VehicleYearRequired"].Value,
        ["yearMin"] = L["Validation.VehicleYearMin", VehicleYearPolicy.MinimumYear].Value,
        ["yearMax"] = L["Validation.VehicleYearMax", VehicleYearPolicy.MaximumYear].Value,
        ["yearDigits"] = L["Validation.VehicleYearDigits"].Value,
        ["fuelRequired"] = L["Validation.VehicleFuelRequired"].Value,
        ["displacementPositive"] = L["Validation.VehicleDisplacementPositive"].Value,
        ["displacementNumber"] = L["Validation.VehicleDisplacementNumber"].Value,
        ["colorRequired"] = L["Validation.VehicleColorRequiredClient"].Value,
        ["mileageRequired"] = L["Validation.VehicleMileageRequired"].Value,
        ["mileagePositive"] = L["Validation.VehicleMileagePositive"].Value,
        ["mileageNumber"] = L["Validation.VehicleMileageNumber"].Value,
        ["mileageDigits"] = L["Validation.VehicleMileageDigits"].Value,
        ["priceRequired"] = L["Validation.VehiclePriceRequired"].Value,
        ["pricePositive"] = L["Validation.VehiclePricePositive"].Value,
        ["priceNumber"] = L["Validation.VehiclePriceNumber"].Value,
        ["priceDigits"] = L["Validation.VehiclePriceDigits"].Value,
        ["imageRequired"] = L["Validation.VehicleImageRequiredClient"].Value,
        ["descriptionRequired"] = L["Validation.VehicleDescriptionRequired"].Value,
        ["descriptionMax"] = L["Validation.VehicleDescriptionMaxLength"].Value,
        ["allowedExtensions"] = L["AllowedImageExtensionsError"].Value,
        ["imageSourceSizeLimit"] = L["ImageSourceSizeLimitError"].Value,
        ["imageProcessingError"] = L["ImageProcessingError"].Value
    };
}

<form id="add-edit-vozilo-form"
      asp-controller="AdminPanel"
      asp-action="SaveVozilo"
      method="post"
      enctype="multipart/form-data"
      novalidate
      data-validation-texts="@JsonSerializer.Serialize(vehicleFormTexts)"
      data-is-edit="@isEdit.ToString().ToLowerInvariant()">
    <input type="hidden" asp-for="VoziloID" />

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Marka" class="form-label">@L["VehicleMake"]</label>
            <input asp-for="Marka" class="form-control" placeholder="@L["VehicleMakePlaceholder"]" required />
            <span asp-validation-for="Marka" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Model" class="form-label">@L["VehicleModel"]</label>
            <input asp-for="Model" class="form-control" placeholder="@L["VehicleModelPlaceholder"]" required />
            <span asp-validation-for="Model" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Godiste" class="form-label">@L["VehicleYear"]</label>
            <input asp-for="Godiste" class="form-control" type="number" min="@VehicleYearPolicy.MinimumYear" max="@VehicleYearPolicy.MaximumYear" required />
            <span asp-validation-for="Godiste" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Gorivo" class="form-label">@L["VehicleFuel"]</label>
            <div class="dropdown admin-option-select" data-option-picker data-placeholder="@L["SelectFuelType"]">
                <select asp-for="Gorivo" class="admin-option-native-select" data-option-select required tabindex="-1" aria-hidden="true">
                    <option value="">@L["SelectFuelType"]</option>
                    @foreach (var fuel in Enum.GetValues<TipGoriva>())
                    {
                        <option value="@fuel">@L[FuelPresentation.GetResourceKey(fuel)]</option>
                    }
                </select>
                <button type="button"
                        class="form-control admin-option-select-toggle dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-validation-proxy-for="Gorivo"
                        aria-labelledby="Gorivo"
                        aria-expanded="false">
                    <span data-selected-option-label>@selectedFuelLabel</span>
                </button>
                <ul class="dropdown-menu admin-option-options">
                    @foreach (var fuel in Enum.GetValues<TipGoriva>())
                    {
                        var fuelLabel = L[FuelPresentation.GetResourceKey(fuel)].Value;
                        <li>
                            <button type="button"
                                    class="dropdown-item admin-option-option"
                                    data-option
                                    data-value="@fuel"
                                    data-label="@fuelLabel"
                                    aria-pressed="@(selectedFuel == fuel ? "true" : "false")">
                                <span>@fuelLabel</span>
                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <span asp-validation-for="Gorivo" class="text-danger"></span>
        </div>

        <div id="vehicle-displacement-field" class="col-md-6">
            <label asp-for="Kubikaza" class="form-label">@L["VehicleDisplacement"]</label>
            <input asp-for="Kubikaza" class="form-control" type="number" min="0.1" step="0.1" />
            <span asp-validation-for="Kubikaza" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Boja" class="form-label" id="vehicle-color-label">@L["VehicleColor"]</label>
            <div class="dropdown admin-color-select" data-color-picker data-placeholder="@L["SelectVehicleColor"]">
                <select asp-for="Boja" class="admin-color-native-select" data-color-select required tabindex="-1" aria-hidden="true">
                    <option value="">@L["SelectVehicleColor"]</option>
                    @foreach (var color in Enum.GetValues<TipBoje>())
                    {
                        <option value="@color">@L[VehicleColorPresentation.GetResourceKey(color)]</option>
                    }
                </select>
                <button type="button"
                        class="form-control admin-color-select-toggle dropdown-toggle"
                        data-bs-toggle="dropdown"
                        data-validation-proxy-for="Boja"
                        aria-labelledby="vehicle-color-label"
                        aria-expanded="false">
                    <span class="vehicle-color-swatch @(selectedColor.HasValue ? VehicleColorPresentation.GetSwatchClass(selectedColor.Value) : "d-none")"
                          data-selected-color-swatch
                          aria-hidden="true"></span>
                    <span data-selected-color-label>@selectedColorLabel</span>
                </button>
                <ul class="dropdown-menu admin-color-options">
                    @foreach (var color in Enum.GetValues<TipBoje>())
                    {
                        var colorLabel = L[VehicleColorPresentation.GetResourceKey(color)].Value;
                        <li>
                            <button type="button"
                                    class="dropdown-item admin-color-option"
                                    data-color-option
                                    data-value="@color"
                                    data-label="@colorLabel"
                                    data-swatch-class="@VehicleColorPresentation.GetSwatchClass(color)"
                                    aria-pressed="@(selectedColor == color ? "true" : "false")">
                                <span class="vehicle-color-swatch @VehicleColorPresentation.GetSwatchClass(color)" aria-hidden="true"></span>
                                <span>@colorLabel</span>
                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                            </button>
                        </li>
                    }
                </ul>
            </div>
            <span asp-validation-for="Boja" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Kilometraza" class="form-label">@L["VehicleMileage"]</label>
            <input asp-for="Kilometraza" class="form-control" type="number" min="0" step="1" inputmode="numeric" required />
            <span asp-validation-for="Kilometraza" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="Cijena" class="form-label">@L["VehiclePrice"]</label>
            <input asp-for="Cijena" class="form-control" type="number" min="1" step="1" inputmode="numeric" required />
            <span asp-validation-for="Cijena" class="text-danger"></span>
        </div>

        <div class="col-12">
            <label asp-for="Slika" class="form-label">@L["VehicleImage"]</label>
            @if (isEdit)
            {
                <input asp-for="Slika" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
            }
            else
            {
                <input asp-for="Slika" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" required />
            }
            <small class="form-text text-muted">@(isEdit ? L["VehicleImageOptional"] : L["VehicleImageRequired"]) · @L["FileExtensionsAllowed"]</small>
            <span asp-validation-for="Slika" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div id="admin-vehicle-media-layout" class="admin-vehicle-media-layout @(hasExistingImage ? "has-image" : "")">
                <div id="admin-vehicle-image-column" class="admin-vehicle-image-column @(!hasExistingImage ? "d-none" : "")">
                    @if (hasExistingImage)
                    {
                    <button type="button"
                            id="current-vehicle-image-preview"
                            class="admin-image-preview-button"
                            data-image-preview
                            data-image-src="@VehicleImageUrl.Detail(Model.VoziloID, editVehicle!.PostojecaSlikaPath!)"
                            aria-label="@L["CurrentImage"]">
                        <img src="@VehicleImageUrl.Detail(Model.VoziloID, editVehicle!.PostojecaSlikaPath!)" alt="@L["CurrentImage"]" class="admin-current-image" />
                        <span class="admin-image-preview-icon" aria-hidden="true"><i class="bi bi-zoom-in"></i></span>
                    </button>
                    <input type="hidden" name="PostojecaSlikaPath" value="@editVehicle!.PostojecaSlikaPath" />
                    }

                    <button type="button"
                            id="selected-vehicle-image-preview"
                            class="admin-image-preview-button d-none"
                            data-image-preview
                            aria-label="@L["VehicleImage"]">
                        <img id="selected-vehicle-image" alt="@L["VehicleImage"]" class="admin-current-image" />
                        <span class="admin-image-preview-icon" aria-hidden="true"><i class="bi bi-zoom-in"></i></span>
                    </button>
                </div>

                <div class="admin-description-field">
                    <label asp-for="Opis" class="form-label">@L["VehicleDescription"]</label>
                    <textarea asp-for="Opis" class="form-control" rows="7" placeholder="@L["VehicleDescriptionPlaceholder"]" required></textarea>
                    <span asp-validation-for="Opis" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="profile-actions mt-4">
        <div class="profile-actions-left">
            <button type="button" id="cancel-add-vozilo" class="btn btn-light border rounded-4">@L["Cancel"]</button>
        </div>
        <button type="submit" class="btn btn-primary rounded-4">
            @(isEdit ? L["SaveChanges"] : L["AddVehicleSubmit"])
        </button>
    </div>
</form>
