@model Autosalon_OneZone.ViewModels.Admin.AddProfilViewModel
@using System.Text.Json

@functions {
    private string RoleLabel(string? role) => role switch
    {
        "Administrator" => L["RoleAdministrator"].Value,
        "Prodavac" => L["RoleSeller"].Value,
        "Kupac" => L["RoleBuyer"].Value,
        _ => role ?? L["NotAvailable"].Value
    };
}

@Html.AntiForgeryToken()

@{
    var profileFormTexts = new Dictionary<string, string>
    {
        ["usernameRequired"] = L["Validation.UsernameRequired"].Value,
        ["usernamePattern"] = L["Validation.UsernameAlphanumeric"].Value,
        ["firstNameRequired"] = L["Validation.FirstNameRequired"].Value,
        ["firstNamePattern"] = L["Validation.FirstNameLettersOnly"].Value,
        ["lastNameRequired"] = L["Validation.LastNameRequired"].Value,
        ["lastNamePattern"] = L["Validation.LastNameLettersOnly"].Value,
        ["passwordRequired"] = L["PasswordRequired"].Value,
        ["passwordPolicy"] = L["PasswordPolicyError"].Value,
        ["confirmPasswordRequired"] = L["ConfirmPasswordRequired"].Value,
        ["confirmNewPasswordRequired"] = L["NewPasswordConfirmationRequired"].Value,
        ["passwordsMatch"] = L["Validation.PasswordsMatch"].Value
    };
}

<form id="add-profil-form" asp-controller="AdminPanel" asp-action="SaveProfil" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        <label asp-for="UserName">@L["Username"]</label>
        <input asp-for="UserName" class="form-control" pattern="@UserInputPatterns.UsernameHtml" title="@L["Validation.UsernameAlphanumeric"]" required />
        <span asp-validation-for="UserName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">@L["Email"]</label>
        <input asp-for="Email" class="form-control" type="email" required pattern="@UserInputPatterns.EmailHtml" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Ime">@L["FirstName"]</label>
        <input asp-for="Ime" class="form-control" pattern="@UserInputPatterns.PersonNameHtml" title="@L["Validation.FirstNameLettersOnly"]" required />
        <span asp-validation-for="Ime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Prezime">@L["LastName"]</label>
        <input asp-for="Prezime" class="form-control" pattern="@UserInputPatterns.PersonNameHtml" title="@L["Validation.LastNameLettersOnly"]" required />
        <span asp-validation-for="Prezime" class="text-danger"></span>
    </div>

    @if (string.IsNullOrEmpty(Model.UserId))
    {
        <div class="form-group">
            <label asp-for="Password">@L["Password"]</label>
            <div class="password-wrapper">
                <input asp-for="Password" class="form-control password-input" type="password" required minlength="@PasswordPolicy.RequiredLength" pattern="@PasswordPolicy.HtmlPattern" title="@L["PasswordPolicyError"]" autocomplete="new-password" />
                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">@L["ConfirmPassword"]</label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" class="form-control password-input" type="password" required autocomplete="new-password" />
                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    }
    else
    {
        <div class="form-group">
            <label asp-for="Password">@L["NewPassword"] <span class="text-muted fw-normal">(@L["Optional"])</span></label>
            <div class="password-wrapper">
                <input asp-for="Password" class="form-control password-input" type="password" autocomplete="new-password" placeholder="@L["AdminNewPasswordPlaceholder"]" minlength="@PasswordPolicy.RequiredLength" pattern="@PasswordPolicy.HtmlPattern" title="@L["PasswordPolicyError"]" />
                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword">@L["ConfirmNewPassword"] <span class="text-muted fw-normal">(@L["Optional"])</span></label>
            <div class="password-wrapper">
                <input asp-for="ConfirmPassword" class="form-control password-input" type="password" autocomplete="new-password" placeholder="@L["AdminConfirmNewPasswordPlaceholder"]" />
                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
    }

    @if (Model.DostupneRole != null && Model.DostupneRole.Any())
    {
        <div class="form-group">
            <label>@L["Role"]</label>
            @foreach (var role in Model.DostupneRole)
            {
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="OdabraneRole" value="@role.Name"
                    @(Model.OdabraneRole != null && Model.OdabraneRole.Contains(role.Name) ? "checked" : "") />
                    <label class="form-check-label">@RoleLabel(role.Name)</label>
                </div>
            }
        </div>
    }

    <div class="form-group mt-3">
        <button type="submit" class="btn btn-primary">@L["Save"]</button>
        <button type="button" id="cancel-add-profil" class="btn btn-secondary">@L["Cancel"]</button>
    </div>
</form>

<script>
    $(document).ready(function () {
        const text = @Html.Raw(JsonSerializer.Serialize(profileFormTexts));
        const form = $("#add-profil-form");

        form.off();

        $("#Ime, #Prezime").on("input", function () {
            const cleanValue = $(this).val().replace(/[^\p{L}\s-]/gu, '');
            $(this).val(cleanValue);
        });

        $("#UserName").on("input", function () {
            const cleanValue = $(this).val().replace(/[^A-Za-z0-9]/g, '');
            $(this).val(cleanValue);
        });

        if (!$.validator.methods.pattern) {
            $.validator.addMethod("pattern", function (value, element, param) {
                if (this.optional(element)) {
                    return true;
                }

                return param instanceof RegExp ? param.test(value) : new RegExp(param, "u").test(value);
            });
        }

        form.validate({
            errorElement: "span",
            errorClass: "text-danger",
            rules: {
                UserName: {
                    required: true,
                    pattern: /^[A-Za-z0-9]+$/
                },
                Ime: {
                    required: true,
                    pattern: /^[\p{L}\s-]+$/u
                },
                Prezime: {
                    required: true,
                    pattern: /^[\p{L}\s-]+$/u
                }
            },
            messages: {
                UserName: {
                    required: text.usernameRequired,
                    pattern: text.usernamePattern
                },
                Ime: {
                    required: text.firstNameRequired,
                    pattern: text.firstNamePattern
                },
                Prezime: {
                    required: text.lastNameRequired,
                    pattern: text.lastNamePattern
                }
            },
            highlight: function (element) {
                $(element).addClass("is-invalid").removeClass("is-valid");
            },
            unhighlight: function (element) {
                $(element).addClass("is-valid").removeClass("is-invalid");
            },
            errorPlacement: function (error, element) {
                const wrapper = element.closest(".password-wrapper");
                if (wrapper.length) {
                    error.insertAfter(wrapper);
                } else {
                    error.insertAfter(element);
                }
            }
        });

        const passwordPattern = new RegExp(@Html.Raw(JsonSerializer.Serialize(PasswordPolicy.Pattern)));

        $("#Password").rules("add", {
            required: function () {
                return $("#UserId").val().length === 0;
            },
            minlength: @PasswordPolicy.RequiredLength,
            pattern: passwordPattern,
            messages: {
                required: text.passwordRequired,
                minlength: text.passwordPolicy,
                pattern: text.passwordPolicy
            }
        });

        $("#ConfirmPassword").rules("add", {
            required: function () {
                return $("#UserId").val().length === 0 || $("#Password").val().length > 0;
            },
            equalTo: "#Password",
            messages: {
                required: $("#UserId").val().length === 0 ? text.confirmPasswordRequired : text.confirmNewPasswordRequired,
                equalTo: text.passwordsMatch
            }
        });
    });
</script>
