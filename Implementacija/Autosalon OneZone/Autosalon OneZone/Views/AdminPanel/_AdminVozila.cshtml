@model Autosalon_OneZone.ViewModels.Admin.VoziloListViewModel

@Html.AntiForgeryToken()

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Admin panel</p>
        <h1>Pregled vozila</h1>
    </div>
</div>

<div id="add-vozilo-form-container" class="admin-form-card" style="display: none;">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <p class="admin-eyebrow mb-1">Vozilo</p>
            <h2 id="add-edit-form-title" class="mb-0">Dodaj novo vozilo</h2>
        </div>
    </div>
    <div id="add-vozilo-form-placeholder"></div>
</div>

<div class="admin-card" id="vozila-list-container">
    <div class="admin-card-header">
        <div>
            <h2>Lista vozila</h2>
            <p>Pregled svih vozila u sistemu.</p>
        </div>
    </div>

    <div class="admin-list-toolbar">
        <button id="add-vozilo-button" class="btn btn-primary rounded-4 add-admin-btn" type="button">
            <i class="bi bi-plus-lg me-2"></i>Dodaj novo vozilo
        </button>

        <div class="admin-filter-chips" aria-label="Filter vozila po gorivu">
            <button type="button" class="filter-chip active" data-vehicle-fuel="">Sva vozila</button>
            <button type="button" class="filter-chip" data-vehicle-fuel="Benzin">Benzin</button>
            <button type="button" class="filter-chip" data-vehicle-fuel="Dizel">Dizel</button>
            <button type="button" class="filter-chip" data-vehicle-fuel="Hibrid">Hibrid</button>
            <button type="button" class="filter-chip" data-vehicle-fuel="Elektro">Elektro</button>
            <button type="button" class="filter-chip" data-vehicle-fuel="Plin">Plin</button>
        </div>

        <div class="admin-search-compact">
            <input type="text" id="vozilo-search-input" class="form-control" placeholder="Pretraži po nazivu..." value="@Model.SearchQuery" />
            <button id="vozilo-search-button" class="search-submit-btn" type="button" aria-label="Pretraži vozila">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>

    <div class="admin-mobile-sort">
        <label for="vozilo-sort-select" class="form-label">Sortiraj po</label>
        <select id="vozilo-sort-select" class="form-select">
            <option value="cijena|desc">Cijena: najviša prvo</option>
            <option value="cijena|asc">Cijena: najniža prvo</option>
            <option value="godiste|desc">Godište: najnovije prvo</option>
            <option value="godiste|asc">Godište: najstarije prvo</option>
            <option value="kilometraza|asc">Kilometraža: najmanja prvo</option>
            <option value="kilometraza|desc">Kilometraža: najveća prvo</option>
        </select>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Naziv</th>
                    <th>
                        <a href="?sort=godiste&direction=desc" class="sortable-th" data-sort-key="godiste">
                            Godište
                            <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>Gorivo</th>
                    <th>
                        <a href="?sort=kilometraza&direction=asc" class="sortable-th" data-sort-key="kilometraza">
                            Kilometraža
                            <i class="bi bi-arrow-down-up"></i>
                        </a>
                    </th>
                    <th>
                        <a href="?sort=cijena&direction=desc" class="sortable-th active" data-sort-key="cijena">
                            Cijena
                            <i class="bi bi-arrow-down-short"></i>
                        </a>
                    </th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody id="vozila-table-body">
                <tr>
                    <td colspan="6">Učitavanje vozila...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="vozila-mobile-list" class="admin-mobile-list"></div>
    <div id="pagination-controls"></div>
</div>

<script>
    $(document).ready(function () {
        $(document).off('click', '.edit-vozilo-button');
        $(document).off('click', '.filter-chip');
        $(document).off('click', '.sortable-th');
        $(document).off('app:delete-confirmed', '.delete-vozilo-button');
        $(document).off('submit', '#add-edit-vozilo-form');

        const vozilaTableBody = $('#vozila-table-body');
        const vozilaMobileList = $('#vozila-mobile-list');
        const searchInput = $('#vozilo-search-input');
        const searchButton = $('#vozilo-search-button');
        const addFormContainer = $('#add-vozilo-form-container');
        const addFormPlaceholder = $('#add-vozilo-form-placeholder');
        const addFormTitle = $('#add-edit-form-title');
        const sortSelect = $('#vozilo-sort-select');
        let currentFuelFilter = '';
        let currentSort = 'cijena';
        let currentDirection = 'desc';

        const sortDefaults = {
            godiste: 'desc',
            kilometraza: 'asc',
            cijena: 'desc'
        };

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function formatCurrency(value) {
            const number = Number(value || 0);
            return '€' + number.toLocaleString('de-DE', { maximumFractionDigits: 0 });
        }

        function formatMileage(value) {
            const number = Number(value || 0);
            return number.toLocaleString('de-DE') + ' km';
        }

        function vehicleActions(id, naziv) {
            return '<div class="table-actions">' +
                '<button class="edit-vozilo-button btn btn-sm btn-outline-primary rounded-3" data-id="' + id + '"><i class="bi bi-pencil-square me-1"></i>Izmijeni</button>' +
                '<button class="delete-vozilo-button btn btn-sm btn-outline-danger rounded-3" data-id="' + id + '" data-confirm-delete="true" data-confirm-title="Obrisati vozilo?" data-confirm-message="Da li ste sigurni da želite obrisati ovo vozilo?" data-confirm-item="' + escapeAttribute(naziv) + '" data-confirm-action="Da, obriši vozilo"><i class="bi bi-trash me-1"></i>Obriši</button>' +
                '</div>';
        }

        function normalizeDirection(value, sortKey) {
            if (value === 'asc' || value === 'desc') {
                return value;
            }

            return sortDefaults[sortKey] || 'desc';
        }

        function sortIconClass(sortKey) {
            if (sortKey !== currentSort) {
                return 'bi-arrow-down-up';
            }

            return currentDirection === 'asc' ? 'bi-arrow-up-short' : 'bi-arrow-down-short';
        }

        function getNextSortDirection(sortKey) {
            if (sortKey === currentSort) {
                return currentDirection === 'desc' ? 'asc' : 'desc';
            }

            return sortDefaults[sortKey] || 'desc';
        }

        function updateSortControls() {
            $('.sortable-th').each(function () {
                const link = $(this);
                const sortKey = link.data('sort-key');
                const nextDirection = getNextSortDirection(sortKey);
                const icon = link.find('i');

                link.toggleClass('active', sortKey === currentSort);
                icon.removeClass('bi-arrow-down-up bi-arrow-down-short bi-arrow-up-short').addClass(sortIconClass(sortKey));

                const params = new URLSearchParams(window.location.search);
                params.set('section', 'Vozila');
                params.set('sort', sortKey);
                params.set('direction', nextDirection);

                const searchValue = searchInput.val();
                if (searchValue) {
                    params.set('searchQuery', searchValue);
                } else {
                    params.delete('searchQuery');
                }

                if (currentFuelFilter) {
                    params.set('gorivoFilter', currentFuelFilter);
                } else {
                    params.delete('gorivoFilter');
                }

                link.attr('href', '?' + params.toString());
            });

            sortSelect.val(currentSort + '|' + currentDirection);
        }

        function updateUrlState() {
            const params = new URLSearchParams(window.location.search);
            params.set('section', 'Vozila');
            params.set('sort', currentSort);
            params.set('direction', currentDirection);

            const searchValue = searchInput.val();
            if (searchValue) {
                params.set('searchQuery', searchValue);
            } else {
                params.delete('searchQuery');
            }

            if (currentFuelFilter) {
                params.set('gorivoFilter', currentFuelFilter);
            } else {
                params.delete('gorivoFilter');
            }

            window.history.replaceState({}, '', window.location.pathname + '?' + params.toString());
            updateSortControls();
        }

        function readInitialState() {
            const params = new URLSearchParams(window.location.search);
            const sortParam = params.get('sort');
            const directionParam = params.get('direction');
            const fuelParam = params.get('gorivoFilter');
            const searchParam = params.get('searchQuery');

            if (sortParam && sortDefaults[sortParam]) {
                currentSort = sortParam;
            }

            currentDirection = normalizeDirection(directionParam, currentSort);

            if (fuelParam) {
                const activeFuelChip = $('.filter-chip[data-vehicle-fuel="' + fuelParam + '"]');
                if (activeFuelChip.length) {
                    currentFuelFilter = fuelParam;
                    $('.filter-chip').removeClass('active');
                    activeFuelChip.addClass('active');
                }
            }

            if (searchParam && !searchInput.val()) {
                searchInput.val(searchParam);
            }

            updateSortControls();
        }

        function renderVehicleRows(vozila) {
            vozilaTableBody.empty();
            vozilaMobileList.empty();

            if (!vozila || vozila.length === 0) {
                vozilaTableBody.html('<tr><td colspan="6"><div class="empty-state"><i class="bi bi-car-front"></i><p>Nema dostupnih vozila.</p></div></td></tr>');
                vozilaMobileList.html('<div class="empty-state"><i class="bi bi-car-front"></i><p>Nema dostupnih vozila.</p></div>');
                return;
            }

            $.each(vozila, function (_, vozilo) {
                const id = vozilo.voziloID;
                const rawNaziv = vozilo.naziv || 'Nepoznato vozilo';
                const naziv = escapeHtml(rawNaziv);
                const godiste = escapeHtml(vozilo.godiste || 'N/A');
                const gorivo = escapeHtml(vozilo.gorivo || 'N/A');
                const kilometraza = formatMileage(vozilo.kilometraza);
                const cijena = formatCurrency(vozilo.cijena);
                const actions = vehicleActions(id, naziv);

                vozilaTableBody.append(
                    '<tr>' +
                        '<td><div class="vehicle-name-cell" title="' + escapeAttribute(rawNaziv) + '"><strong>' + naziv + '</strong><span>ID #' + id + '</span></div></td>' +
                        '<td>' + godiste + '</td>' +
                        '<td><span class="admin-badge">' + gorivo + '</span></td>' +
                        '<td>' + kilometraza + '</td>' +
                        '<td><strong class="price-cell">' + cijena + '</strong></td>' +
                        '<td>' + actions + '</td>' +
                    '</tr>'
                );

                vozilaMobileList.append(
                    '<article class="admin-vehicle-card">' +
                        '<div class="d-flex justify-content-between gap-3">' +
                            '<div><span class="admin-badge">' + gorivo + '</span><h3>' + naziv + '</h3></div>' +
                            '<strong class="price-cell">' + cijena + '</strong>' +
                        '</div>' +
                        '<div class="mobile-specs">' +
                            '<div><span>Godište</span><strong>' + godiste + '</strong></div>' +
                            '<div><span>Kilometraža</span><strong>' + kilometraza + '</strong></div>' +
                        '</div>' +
                        '<div class="mobile-actions">' + actions + '</div>' +
                    '</article>'
                );
            });
        }

        function loadVozilaList(searchQuery = '', page = 1, sort = currentSort, direction = currentDirection, gorivoFilter = currentFuelFilter) {
            vozilaTableBody.html('<tr><td colspan="6">Učitavanje vozila...</td></tr>');
            vozilaMobileList.html('<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Učitavanje vozila...</p></div>');

            $.get('@Url.Action("GetVozilaJson", "AdminPanel")', { searchQuery: searchQuery, page: page, sort: sort, direction: direction, gorivoFilter: gorivoFilter }, function (data) {
                renderVehicleRows(data && data.vozila ? data.vozila : []);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                const message = escapeHtml(jqXHR.responseText || errorThrown || 'Greška');
                vozilaTableBody.html('<tr><td colspan="6"><div class="alert alert-danger mb-0">Greška prilikom učitavanja vozila: ' + message + '</div></td></tr>');
                vozilaMobileList.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja vozila: ' + message + '</div>');
            });
        }

        readInitialState();
        loadVozilaList(searchInput.val() || '@Model.SearchQuery', 1, currentSort, currentDirection, currentFuelFilter);

        searchButton.on('click', function () {
            updateUrlState();
            loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
        });

        searchInput.on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                searchButton.click();
            }
        });

        $(document).off('click.adminVozilaFilter', '.filter-chip').on('click.adminVozilaFilter', '.filter-chip', function () {
            currentFuelFilter = $(this).data('vehicle-fuel') || '';
            $('.filter-chip').removeClass('active');
            $(this).addClass('active');
            updateUrlState();
            loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
        });

        $(document).off('click.adminVozilaSort', '.sortable-th').on('click.adminVozilaSort', '.sortable-th', function (e) {
            e.preventDefault();
            const sortKey = $(this).data('sort-key');

            if (!sortDefaults[sortKey]) {
                return;
            }

            currentDirection = getNextSortDirection(sortKey);
            currentSort = sortKey;
            updateUrlState();
            loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
        });

        sortSelect.on('change', function () {
            const [sortKey, direction] = ($(this).val() || 'cijena|desc').split('|');
            currentSort = sortDefaults[sortKey] ? sortKey : 'cijena';
            currentDirection = normalizeDirection(direction, currentSort);
            updateUrlState();
            loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
        });

        $('#add-vozilo-button').on('click', function () {
            addFormTitle.text('Dodaj novo vozilo');
            $.get('@Url.Action("GetAddVoziloForm", "AdminPanel")', function (data) {
                addFormPlaceholder.html(data);
                addFormContainer.show();
                const form = addFormPlaceholder.find('form');
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            }).fail(function () {
                addFormPlaceholder.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja forme za dodavanje.</div>');
                addFormContainer.show();
            });
        });

        $(document).off('click.adminVozilaEdit', '.edit-vozilo-button').on('click.adminVozilaEdit', '.edit-vozilo-button', function () {
            const voziloId = $(this).data('id');
            addFormTitle.text('Izmijeni vozilo');

            $.get('@Url.Action("GetEditVoziloForm", "AdminPanel")', { id: voziloId }, function (data) {
                addFormPlaceholder.html(data);
                addFormContainer.show();
                const form = addFormPlaceholder.find('form');
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            }).fail(function () {
                addFormPlaceholder.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja forme za izmjenu.</div>');
                addFormContainer.show();
            });
        });

        $(document).off('click.adminVozilaCancel', '#cancel-add-vozilo').on('click.adminVozilaCancel', '#cancel-add-vozilo', function () {
            addFormContainer.hide();
            addFormPlaceholder.empty();
        });

        $(document).off('submit.adminVozilaSave', '#add-edit-vozilo-form').on('submit.adminVozilaSave', '#add-edit-vozilo-form', function (e) {
            e.preventDefault();
            const form = $(this);

            if (!form.valid()) {
                return;
            }

            $.ajax({
                url: form.attr('action'),
                method: form.attr('method'),
                data: new FormData(this),
                processData: false,
                contentType: false,
                success: function () {
                    addFormContainer.hide();
                    addFormPlaceholder.empty();
                    loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
                    window.showAppFlashMessage('Vozilo uspješno sačuvano.', 'success');
                },
                error: function (jqXHR) {
                    if (jqXHR.status === 400 && jqXHR.responseJSON) {
                        window.showAppFlashMessage('Greška prilikom spremanja. Provjerite unesene podatke.', 'error');
                    } else {
                        window.showAppFlashMessage('Došlo je do greške prilikom spremanja vozila. Slika je obavezna za novo vozilo.', 'error');
                    }
                }
            });
        });

        $(document).off('app:delete-confirmed.adminVozilaDelete', '.delete-vozilo-button').on('app:delete-confirmed.adminVozilaDelete', '.delete-vozilo-button', function () {
            const voziloId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("DeleteVozilo", "AdminPanel")',
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: { id: voziloId },
                success: function (response) {
                    window.showAppFlashMessage(response.successMessage || 'Vozilo uspješno obrisano.', 'success');
                    loadVozilaList(searchInput.val(), 1, currentSort, currentDirection, currentFuelFilter);
                },
                error: function () {
                    window.showAppFlashMessage('Došlo je do greške prilikom brisanja vozila.', 'error');
                }
            });
        });
    });
</script>
