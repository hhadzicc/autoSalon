@Html.AntiForgeryToken()
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    var currentSection = ViewBag.CurrentSection;
    var user = await UserManager.GetUserAsync(User);
    bool isAdmin = user != null && await UserManager.IsInRoleAsync(user, "Administrator");
    var panelTitleKey = isAdmin ? "AdminPanel" : "SellerPanel";
    var menuTitleKey = isAdmin ? "AdminMenu" : "SellerMenu";
    ViewData["Title"] = L[panelTitleKey];
}

<section class="admin-section"
         id="admin-panel-root"
          data-default-section="@(currentSection ?? "Dashboard")"
          data-is-admin="@isAdmin.ToString().ToLowerInvariant()"
          data-edit-vehicle-id="@ViewBag.EditVehicleId"
          data-return-url="@ViewBag.ReturnUrl"
         data-url-dashboard="@Url.Action("GetDashboardSection", "AdminPanel")"
         data-url-vozila="@Url.Action("GetVozilaSection", "AdminPanel")"
         data-url-profili="@Url.Action("GetProfiliSection", "AdminPanel")"
         data-url-recenzije="@Url.Action("GetRecenzijeSection", "AdminPanel")"
         data-url-podrska="@Url.Action("GetPodrskaSection", "AdminPanel")"
         data-text-not-found="@L["AdminSectionNotFound"]"
         data-text-loading="@L["AdminSectionLoading"]"
         data-text-load-error="@L["AdminSectionLoadError"]">
    <div class="admin-container">
        <div class="admin-layout">
            <aside class="admin-sidebar">
                <nav class="admin-menu" aria-label="@L[menuTitleKey]">
                    <a href="#" class="admin-menu-link" data-section="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        @L["Dashboard"]
                    </a>

                    <a href="#" class="admin-menu-link" data-section="Vozila">
                        <i class="bi bi-car-front-fill"></i>
                        @L["NavVehicles"]
                    </a>

                    @if (isAdmin)
                    {
                        <a href="#" class="admin-menu-link" data-section="Profili">
                            <i class="bi bi-people-fill"></i>
                            @L["DashboardUsers"]
                        </a>
                    }

                    <a href="#" class="admin-menu-link" data-section="Recenzije">
                        <i class="bi bi-star-fill"></i>
                        @L["Reviews"]
                    </a>

                    <a href="#" class="admin-menu-link" data-section="Podrska">
                        <i class="bi bi-headset"></i>
                        @L["DashboardSupportInquiries"]
                    </a>
                </nav>
            </aside>

            <main class="admin-content">
                <div id="admin-section-content" class="admin-section-content">
                    <div class="admin-card">
                        <div class="empty-state">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <p>@L["AdminSectionLoading"]</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin/admin-core.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-panel.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-combobox.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-filter-controls.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-lazy-list.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-reviews.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-support.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-users.js" asp-append-version="true"></script>
    <script src="~/js/admin/admin-vehicles.js" asp-append-version="true"></script>
}
