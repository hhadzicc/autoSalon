@{
    ViewData["Title"] = L["ForgotPasswordConfirmationTitle"];
}

<section class="auth-section forgot-password-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8 forgot-password-shell">
                <div class="modern-form-card forgot-password-card forgot-password-confirmation-card">
                    <div class="form-icon forgot-password-confirmation-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h1>@L["ForgotPasswordConfirmationTitle"]</h1>
                    <p class="forgot-password-intro">@L["ForgotPasswordConfirmationText"]</p>
                    <div class="forgot-password-confirmation-actions">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary forgot-password-submit">@L["BackToLogin"]</a>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="btn forgot-password-secondary">@L["RequestNewLink"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
