@model Autosalon_OneZone.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = L["AuthLoginTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["AuthAccountEyebrow"]</p>
                <h1>@L["AuthLoginTitle"]</h1>
                <p>@L["AuthLoginSubtitle"]</p>
            </div>
        </div>
    </div>
</section>
<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <h2>@L["AuthLoginHeading"]</h2>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary mb-3"></div>

                    <form asp-controller="Account" asp-action="Login" method="post">
                        <div class="mb-3">
                            <label asp-for="LoginIdentifier" class="form-label">@L["AuthLoginIdentifier"]</label>
                            <input asp-for="LoginIdentifier" type="text" class="form-control" placeholder="@L["AuthLoginIdentifierPlaceholder"]" autocomplete="username" required data-val-required="@L["ValidationRequired"]" />
                            <span asp-validation-for="LoginIdentifier" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">@L["AuthPassword"]</label>
                            <div class="password-wrapper">
                                <input asp-for="Password" type="password" class="form-control password-input" placeholder="@L["AuthPasswordPlaceholder"]" autocomplete="current-password" required data-val-required="@L["ValidationRequired"]" />
                                <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="RememberMe" type="checkbox" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">@L["AuthRememberMe"]</label>
                            <span asp-validation-for="RememberMe" class="text-danger d-block"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg rounded-4 w-100">@L["AuthLoginSubmit"]</button>

                        <div class="text-center mt-4">
                            <p class="mb-2">
                                @L["AuthNoAccount"]
                                <a href="/Account/Register" class="fw-bold">@L["AuthRegisterLink"]</a>
                            </p>
                            <a href="/Account/ForgotPassword" class="small">@L["AuthForgotPassword"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>