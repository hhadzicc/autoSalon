@using System.Globalization
@model Autosalon_OneZone.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = L["CartTitle"];
    var culture = CultureInfo.CurrentCulture;
}

<section class="cart-page-section">
    <div class="container">
        @if (Model.VozilaUKorpi.Count == 0)
        {
            <div class="empty-cart-wrap">
                <div class="empty-cart-card">
                    <div class="empty-cart-icon">
                        <i class="bi bi-cart-x"></i>
                    </div>

                    <h2>@L["CartEmptyTitle"]</h2>
                    <p>@L["CartEmptyText"]</p>

                    <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary btn-lg rounded-4">
                        <i class="bi bi-car-front-fill me-2"></i>@L["BrowseVehicles"]
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="cart-page-intro">
                <h1>@L["CartHeaderTitle"]</h1>
                <p>@L["CartHeaderText"]</p>
            </div>

            <div class="row g-4 align-items-start cart-content-row">
                <div class="col-lg-8 cart-content-column">
                    <div id="stavkeKorpe" class="cart-items-list">
                        @foreach (var vozilo in Model.VozilaUKorpi)
                        {
                            <article class="cart-item-card stavka-korpe"
                                     data-naziv="@vozilo.Naziv"
                                     data-cijena="@vozilo.Cijena"
                                     data-godiste="@vozilo.Godiste"
                                     data-cijena-numeric="@vozilo.Cijena.ToString(CultureInfo.InvariantCulture)">
                                <div class="cart-item-image">
                                    <img src="@vozilo.SlikaUrl" alt="@vozilo.Naziv">
                                </div>

                                <div class="cart-item-content">
                                    <div>
                                        <span class="cart-item-badge fuel-chip @FuelPresentation.GetChipClass(vozilo.Gorivo)">@L[FuelPresentation.GetResourceKey(vozilo.Gorivo)]</span>
                                        <h3 class="card-title">@vozilo.Naziv</h3>

                                        <div class="cart-meta">
                                            <span class="text-muted"><i class="bi bi-calendar3"></i>@L["VehicleYear"]: @vozilo.Godiste</span>
                                            <span class="text-muted"><i class="bi bi-speedometer2"></i>@L["VehicleMileage"]: @vozilo.Kilometraza km</span>
                                        </div>

                                        <div class="cart-price text-success">€@vozilo.Cijena.ToString("N0", culture)</div>
                                    </div>

                                    <div class="cart-actions">
                                        <a href="@Url.Action("Details", "Vozilo", new { id = vozilo.Id, returnUrl = Url.Action("Index", "Korpa") })" class="btn btn-light border rounded-4">
                                            <i class="bi bi-info-circle me-2"></i>@L["Details"]
                                        </a>
                                        <button type="button" class="btn btn-primary rounded-4 buy-now-btn"
                                                data-bs-toggle="modal" data-bs-target="#paymentModal"
                                                data-id="@vozilo.Id" data-cijena-numeric="@vozilo.Cijena.ToString(CultureInfo.InvariantCulture)" data-naziv="@vozilo.Naziv">
                                            <i class="bi bi-credit-card me-2"></i>@L["Buy"]
                                        </button>
                                        <form asp-controller="Korpa" asp-action="UkloniIzKorpe" method="post"
                                              class="remove-from-cart-form"
                                              data-vehicle-name="@vozilo.Naziv"
                                              data-remove-message="@L["CartVehicleRemovedToast"]"
                                              data-remove-error="@L["CartRemoveError"]"
                                              data-undo-text="@L["Undo"]"
                                              data-undo-url="@Url.Action("DodajUKorpu", "Korpa")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@vozilo.Id">
                                            <button type="submit" class="btn btn-outline-danger rounded-4 w-100">
                                                <i class="bi bi-trash me-2 cart-remove-desktop-icon"></i><i class="bi bi-trash3-fill cart-remove-mobile-icon" aria-hidden="true"></i><span class="cart-remove-label">@L["Remove"]</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>

                <div class="col-lg-4 cart-sidebar-column">
                    <aside class="cart-sidebar" data-cart-sidebar>
                        <form asp-controller="Korpa" asp-action="OcistiKorpu" method="post"
                              class="clear-cart-form mobile-clear-cart-form"
                              data-clear-success="@L["CartClearedSuccess"]"
                              data-clear-error="@L["CartClearError"]">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-danger rounded-4 w-100"
                                    data-confirm-delete="true"
                                    data-confirm-title="@L["ClearCartConfirmTitle"]"
                                    data-confirm-message="@L["ClearCartConfirmMessage"]"
                                    data-confirm-item="@L["ClearCartConfirmItem", Model.VozilaUKorpi.Count]"
                                    data-confirm-action="@L["ClearCartConfirmAction"]"
                                    data-confirm-event-only>
                                <i class="bi bi-cart-x me-2"></i>@L["ClearCart"]
                            </button>
                        </form>

                        <div class="checkout-card">
                            <div class="checkout-card-title">
                                <h3>@L["PurchaseOverview"]</h3>
                                <button type="button" class="mobile-summary-close" data-mobile-cart-summary-close aria-label="@L["Close"]">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </div>

                            <div class="summary-row">
                                <span>@L["VehicleCount"]</span>
                                <strong data-cart-vehicle-count>@Model.VozilaUKorpi.Count</strong>
                            </div>

                            <div class="summary-total">
                                <span>@L["PaymentDue"]</span>
                                <strong data-cart-total>€@Model.UkupnaCijena.ToString("N0", culture)</strong>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button type="button" class="btn btn-primary btn-lg rounded-4" id="checkoutButton" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                                    <i class="bi bi-bag-check me-2"></i>@L["ContinueToCheckout"]
                                </button>
                                <form asp-controller="Korpa" asp-action="OcistiKorpu" method="post"
                                      class="clear-cart-form"
                                      data-clear-success="@L["CartClearedSuccess"]"
                                      data-clear-error="@L["CartClearError"]">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="btn btn-outline-danger rounded-4 w-100"
                                            data-confirm-delete="true"
                                            data-confirm-title="@L["ClearCartConfirmTitle"]"
                                            data-confirm-message="@L["ClearCartConfirmMessage"]"
                                            data-confirm-item="@L["ClearCartConfirmItem", Model.VozilaUKorpi.Count]"
                                            data-confirm-action="@L["ClearCartConfirmAction"]"
                                            data-confirm-event-only>
                                        <i class="bi bi-cart-x me-2"></i>@L["ClearCart"]
                                    </button>
                                </form>
                            </div>
                        </div>

                        @await Html.PartialAsync("_LoanCalculator", new Autosalon_OneZone.Models.ViewModels.LoanCalculatorViewModel
                        {
                            DefaultPeriod = 36
                        })
                    </aside>
                </div>
            </div>

            <div id="cart-empty-state" class="empty-cart-wrap" hidden>
                <div class="empty-cart-card">
                    <div class="empty-cart-icon">
                        <i class="bi bi-cart-x"></i>
                    </div>
                    <h2>@L["CartEmptyTitle"]</h2>
                    <p>@L["CartEmptyText"]</p>
                    <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary btn-lg rounded-4">
                        <i class="bi bi-car-front-fill me-2"></i>@L["BrowseVehicles"]
                    </a>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.VozilaUKorpi.Count > 0)
{
    <div class="mobile-cart-checkout" data-mobile-cart-checkout>
        <div class="mobile-cart-checkout-inner">
            <button type="button" class="mobile-cart-summary-toggle" data-mobile-cart-summary-toggle aria-expanded="false">
                <span>
                <small>@L["PaymentDue"]</small>
                <strong data-cart-total>€@Model.UkupnaCijena.ToString("N0", culture)</strong>
                </span>
                <i class="bi bi-chevron-up" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#checkoutModal">
                @L["ContinueToCheckout"]
            </button>
        </div>
    </div>
    <div class="mobile-cart-summary-backdrop" data-mobile-cart-summary-backdrop></div>

    <div class="modal fade" id="checkoutModal" tabindex="-1" aria-labelledby="checkoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content modern-modal">
                <div class="modal-header modern-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon">
                            <i class="bi bi-bag-check-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="checkoutModalLabel">@L["CheckoutTitle"]</h5>
                            <p class="mb-0 text-muted small">@L["CheckoutText"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <div class="alert alert-info small d-none" id="checkoutSelectionWarning">
                            <i class="bi bi-info-circle-fill"></i> @L["SelectAtLeastOneVehicle"]
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th width="5%">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="selectAll" checked>
                                            </div>
                                        </th>
                                        <th>@L["Vehicle"]</th>
                                        <th class="text-end">@L["VehiclePrice"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vozilo in Model.VozilaUKorpi)
                                    {
                                        <tr>
                                            <td>
                                                <div class="form-check">
                                                    <input class="form-check-input vozilo-checkbox" type="checkbox"
                                                           data-id="@vozilo.Id"
                                                           data-naziv="@vozilo.Naziv"
                                                           data-cijena="@vozilo.Cijena.ToString(CultureInfo.InvariantCulture)"
                                                           checked>
                                                </div>
                                            </td>
                                            <td>@vozilo.Naziv (@vozilo.Godiste)</td>
                                            <td class="text-end">€@vozilo.Cijena.ToString("N0", culture)</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-active">
                                        <th colspan="2" class="text-end">@L["Total"]</th>
                                        <th class="text-end text-success" id="checkoutTotal">€@Model.UkupnaCijena.ToString("N0", culture)</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <div class="payment-modal-error alert alert-danger d-none py-2 px-3 mb-3" id="checkoutPaymentRequestError" role="alert"></div>

                    <form id="checkoutForm" asp-controller="Korpa" asp-action="IzvrsiPlacanjeSvih" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OdabranaVozilaJSON" id="odabranaVozilaJSON" value="" />
                        @await Html.PartialAsync("_PaymentFields", new Autosalon_OneZone.Models.ViewModels.PaymentFieldsViewModel
                        {
                            IdPrefix = "checkout"
                        })
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success" id="checkoutSubmitBtn">@L["ConfirmPurchase"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modern-modal">
                <div class="modal-header modern-modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon">
                            <i class="bi bi-credit-card-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="paymentModalLabel">@L["PaymentDetails"]</h5>
                            <p class="payment-vehicle-name mb-0" id="paymentVehicleName"></p>
                            <p class="mb-0 text-muted small">@L["PaymentDetailsText"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <div class="payment-total-alert mb-4">
                        <strong>@L["TotalToPay"]</strong> <span id="modalUkupnaCijena" class="text-success fw-bold"></span>
                    </div>

                    <div class="payment-modal-error alert alert-danger d-none py-2 px-3 mb-3" id="paymentRequestError" role="alert"></div>

                    <form id="paymentForm" asp-controller="Korpa" asp-action="IzvrsiPlacanje" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="VoziloID" id="modalVoziloID" value="" />
                        @await Html.PartialAsync("_PaymentFields", new Autosalon_OneZone.Models.ViewModels.PaymentFieldsViewModel())
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success" id="submitPayment">@L["ConfirmPurchase"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/components/loan-calculator.js" asp-append-version="true"></script>
    <script src="~/js/components/payment-form.js" asp-append-version="true"></script>
    <script>
        (() => {
            const updateCartSummary = (count) => {
                $("[data-cart-vehicle-count]").text(count);
                window.updateCartBadge(count);
                $("[data-mobile-cart-checkout]").toggle(count > 0);
                if (count < 1) setSummaryOpen(false);

                let total = 0;
                $("#stavkeKorpe .stavka-korpe").each(function() {
                    total += Number($(this).data("cijenaNumeric")) || 0;
                });

                const locale = document.documentElement.lang === "en" ? "en-US" : "bs-BA";
                $("[data-cart-total]").text("€" + total.toLocaleString(locale, { maximumFractionDigits: 0 }));
            };

            const loanCard = document.querySelector("[data-cart-sidebar] .loan-card");
            const loanHeader = loanCard?.querySelector(".loan-card-header");
            const mobileQuery = window.matchMedia("(max-width: 575.98px)");
            const summarySheet = document.querySelector(".cart-sidebar .checkout-card");
            const summaryToggle = document.querySelector("[data-mobile-cart-summary-toggle]");
            const summaryBackdrop = document.querySelector("[data-mobile-cart-summary-backdrop]");
            const summaryClose = document.querySelector("[data-mobile-cart-summary-close]");
            const mobileCheckout = document.querySelector("[data-mobile-cart-checkout]");

            const setSummaryOpen = (open) => {
                summarySheet?.classList.toggle("is-mobile-open", open);
                summaryBackdrop?.classList.toggle("is-visible", open);
                summaryToggle?.classList.toggle("is-open", open);
                mobileCheckout?.classList.toggle("is-summary-open", open);
                summaryToggle?.setAttribute("aria-expanded", String(open));
            };

            summaryToggle?.addEventListener("click", () => {
                setSummaryOpen(!summarySheet?.classList.contains("is-mobile-open"));
            });
            summaryBackdrop?.addEventListener("click", () => setSummaryOpen(false));
            summaryClose?.addEventListener("click", () => setSummaryOpen(false));
            document.querySelectorAll('[data-bs-target="#checkoutModal"]').forEach(button => {
                button.addEventListener("click", () => setSummaryOpen(false));
            });

            const setLoanExpanded = (expanded) => {
                if (!loanCard || !loanHeader) return;
                loanCard.classList.toggle("is-mobile-collapsed", !expanded);
                loanHeader.setAttribute("aria-expanded", String(expanded));
            };

            const syncLoanCard = () => {
                if (!loanCard || !loanHeader) return;
                if (mobileQuery.matches) {
                    loanHeader.setAttribute("role", "button");
                    loanHeader.setAttribute("tabindex", "0");
                    setLoanExpanded(false);
                } else {
                    loanHeader.removeAttribute("role");
                    loanHeader.removeAttribute("tabindex");
                    loanHeader.removeAttribute("aria-expanded");
                    loanCard.classList.remove("is-mobile-collapsed");
                }
            };

            loanHeader?.addEventListener("click", () => {
                if (mobileQuery.matches) {
                    setLoanExpanded(loanCard.classList.contains("is-mobile-collapsed"));
                }
            });

            loanHeader?.addEventListener("keydown", event => {
                if (mobileQuery.matches && (event.key === "Enter" || event.key === " ")) {
                    event.preventDefault();
                    loanHeader.click();
                }
            });

            mobileQuery.addEventListener?.("change", syncLoanCard);
            syncLoanCard();

            const showRemoveToast = (message, undo) => {
                window.showAppToast(message, {
                    type: "success",
                    duration: 5200,
                    actionText: undo?.text,
                    onAction: undo ? (actionButton) => {
                        $(actionButton).prop("disabled", true);
                        window.appApi.post(undo.url, undo.data).done((result) => {
                            if (!result.success) {
                                $(actionButton).prop("disabled", false);
                                return;
                            }

                            const $card = $(undo.cardHtml);
                            const $cards = $("#stavkeKorpe .stavka-korpe");
                            if (undo.index >= $cards.length) {
                                $("#stavkeKorpe").append($card);
                            } else {
                                $cards.eq(undo.index).before($card);
                            }

                            $(".cart-content-row").show();
                            $("#cart-empty-state").prop("hidden", true);
                            updateCartSummary(result.cartCount);
                            window.dismissAppToast();
                        }).fail(() => {
                            $(actionButton).prop("disabled", false);
                        });
                    } : undefined
                });
            };

            $(document).on("submit", ".remove-from-cart-form", function(event) {
                event.preventDefault();

                const form = this;
                const $form = $(form);
                const $card = $form.closest(".stavka-korpe");
                const cardHtml = $card.prop("outerHTML");
                const index = $card.index();
                const vehicleName = form.dataset.vehicleName;
                const removeMessage = form.dataset.removeMessage.replace("{0}", vehicleName);

                $form.find("button").prop("disabled", true);

                window.appApi.postForm(form).done((result) => {
                    if (!result.success) {
                        $form.find("button").prop("disabled", false);
                        return;
                    }

                    $card.remove();
                    updateCartSummary(result.cartCount);
                    if (result.cartCount < 1) {
                        $(".cart-content-row").hide();
                        $("#cart-empty-state").prop("hidden", false);
                    }

                    showRemoveToast(removeMessage, {
                        text: form.dataset.undoText,
                        url: form.dataset.undoUrl,
                        data: $form.serialize(),
                        cardHtml,
                        index
                    });
                }).fail(() => {
                    $form.find("button").prop("disabled", false);
                    window.showAppToast(form.dataset.removeError, { type: "error" });
                });
            });

            $(document).on("app:delete-confirmed", ".clear-cart-form [data-confirm-delete]", function() {
                const form = this.closest("form");
                const $form = $(form);

                window.appApi.postForm(form).done((result) => {
                    if (!result.success) {
                        window.showAppToast(form.dataset.clearError, { type: "error" });
                        return;
                    }

                    $("#stavkeKorpe").empty();
                    $(".cart-content-row").hide();
                    $("#cart-empty-state").prop("hidden", false);
                    updateCartSummary(0);
                    showRemoveToast(form.dataset.clearSuccess);
                }).fail(() => {
                    window.showAppToast(form.dataset.clearError, { type: "error" });
                });
            });
        })();

        const paymentTexts = {
            processing: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Processing"].Value)),
            confirmPurchase: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["ConfirmPurchase"].Value)),
            paymentFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentFailedPrefix"].Value)),
            requestError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentRequestError"].Value)),
            holderRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentHolderRequired"].Value)),
            cardRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardRequired"].Value)),
            cardLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardLength"].Value)),
            expiryRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryRequired"].Value)),
            expiryFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryFormat"].Value)),
            cardExpired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardExpired"].Value)),
            cvvRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvRequired"].Value)),
            cvvLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvLength"].Value))
        };

        const singlePaymentOptions = {
            buttonSelector: "#submitPayment",
            errorSelector: "#paymentRequestError",
            texts: paymentTexts
        };

        const checkoutPaymentOptions = {
            buttonSelector: "#checkoutSubmitBtn",
            errorSelector: "#checkoutPaymentRequestError",
            texts: paymentTexts,
            beforeSubmit: function() {
                const selected = getSelectedVehicles();
                if (!selected.length) {
                    $("#checkoutSelectionWarning").removeClass("d-none");
                    return false;
                }

                $("#odabranaVozilaJSON").val(JSON.stringify(selected));
                return true;
            }
        };

        $(document).ready(function() {
            initializePaymentModal();
            initializeCheckoutModal();
        });

        function initializePaymentModal() {
            window.paymentForm.initialize("#paymentForm", singlePaymentOptions);
            $("#paymentModal").on("show.bs.modal", function(event) {
                window.paymentForm.reset("#paymentForm", singlePaymentOptions);

                const button = $(event.relatedTarget);
                $("#modalVoziloID").val(button.data("id"));
                $("#paymentVehicleName").text(button.data("naziv") || "");
                $("#modalUkupnaCijena").text("€" + Number(button.data("cijenaNumeric")).toLocaleString());
            });
        }

        function initializeCheckoutModal() {
            $("#selectAll").on("change", function() {
                $(".vozilo-checkbox").prop("checked", $(this).is(":checked"));
                updateCheckoutTotal();
            });

            $(".vozilo-checkbox").on("change", function() {
                updateCheckoutTotal();
                if ($(".vozilo-checkbox:checked").length) {
                    $("#checkoutSelectionWarning").addClass("d-none");
                }
            });

            window.paymentForm.initialize("#checkoutForm", checkoutPaymentOptions);
            $("#checkoutModal").on("show.bs.modal", function() {
                $("#checkoutSelectionWarning").addClass("d-none");
                window.paymentForm.clear("#checkoutForm", checkoutPaymentOptions);
                updateCheckoutTotal();
            });
        }

        function getSelectedVehicles() {
            return $(".vozilo-checkbox:checked").map(function() {
                return {
                    id: $(this).data("id"),
                    naziv: $(this).data("naziv"),
                    cijena: Number.parseFloat($(this).data("cijena"))
                };
            }).get();
        }

        function updateCheckoutTotal() {
            const total = getSelectedVehicles().reduce(function(sum, item) {
                return sum + (Number(item.cijena) || 0);
            }, 0);

            $("#checkoutTotal").text("€" + total.toLocaleString(undefined, { maximumFractionDigits: 0 }));
            $("#selectAll").prop("checked", $(".vozilo-checkbox").length === $(".vozilo-checkbox:checked").length);
        }
    </script>
}
