@model Autosalon_OneZone.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = L["ForgotPasswordTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["AuthAccountEyebrow"]</p>
                <h1>@L["ForgotPasswordTitle"]</h1>
                <p>@L["ForgotPasswordSubtitle"]</p>
            </div>
        </div>
    </div>
</section>
<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi bi-envelope-lock-fill"></i>
                        </div>
                        <h2>@L["ForgotPasswordHeading"]</h2>
                        <p class="text-muted mb-0">@L["ForgotPasswordText"]</p>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary mb-3"></div>

                    <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label">@L["EmailAddress"]</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="korisnik@example.com" autocomplete="email" required pattern="@UserInputPatterns.EmailHtml" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg rounded-4 w-100">@L["ForgotPasswordSubmit"]</button>

                        <div class="text-center mt-4">
                            <a asp-controller="Account" asp-action="Login" class="fw-bold">@L["BackToLogin"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>