@model Autosalon_OneZone.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = L["EditProfile"];
}

<section class="profile-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-xl-6">
                <div class="profile-edit-toolbar">
                    <a asp-controller="Profil" asp-action="Index" class="btn btn-light border rounded-4">
                        <i class="bi bi-arrow-left me-2"></i>@L["BackToProfile"]
                    </a>
                </div>

                <div class="profile-card">
                    <div class="text-center mb-4">
                        <div class="profile-avatar small-avatar">
                            <i class="bi bi-pencil-square"></i>
                        </div>
                        <h2>@L["EditData"]</h2>
                    </div>

                    <div asp-validation-summary="All" class="account-validation-summary validation-summary"></div>

                    <form asp-controller="Profil" asp-action="Edit" method="post" novalidate autocomplete="off"
                          data-account-validation="profile"
                          data-check-fields-message="@L["Validation.CheckMarkedFields"]">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Ime" class="form-label">@L["FirstName"]</label>
                                <input asp-for="Ime" type="text" class="form-control" placeholder="@L["FirstName"]" required maxlength="100" pattern="@UserInputPatterns.PersonNameHtml" autocomplete="off"
                                       data-account-field="firstName"
                                       data-required-message="@L["Validation.FirstNameRequired"]"
                                       data-invalid-message="@L["Validation.FirstNameLettersOnly"]"
                                       data-max-message="@L["Validation.FirstNameMaxLength"]" />
                                <span asp-validation-for="Ime" class="account-validation-message"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Prezime" class="form-label">@L["LastName"]</label>
                                <input asp-for="Prezime" type="text" class="form-control" placeholder="@L["LastName"]" required maxlength="100" pattern="@UserInputPatterns.PersonNameHtml" autocomplete="off"
                                       data-account-field="lastName"
                                       data-required-message="@L["Validation.LastNameRequired"]"
                                       data-invalid-message="@L["Validation.LastNameLettersOnly"]"
                                       data-max-message="@L["Validation.LastNameMaxLength"]" />
                                <span asp-validation-for="Prezime" class="account-validation-message"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label">@L["EmailAddress"]</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="@L["EmailAddress"]" required pattern="@UserInputPatterns.EmailHtml" autocomplete="off"
                                       data-account-field="email"
                                       data-required-message="@L["Validation.EmailRequired"]"
                                       data-invalid-message="@L["Validation.EmailValid"]" />
                                <span asp-validation-for="Email" class="account-validation-message"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="UserName" class="form-label">@L["Username"]</label>
                                <input asp-for="UserName" type="text" class="form-control" placeholder="@L["Username"]" required maxlength="100" pattern="@UserInputPatterns.UsernameHtml" autocomplete="off"
                                       data-account-field="username"
                                       data-required-message="@L["Validation.UsernameRequired"]"
                                       data-invalid-message="@L["Validation.UsernameAlphanumeric"]"
                                       data-max-message="@L["Validation.UsernameMaxLength"]"
                                       data-hint-message="@L["Validation.UsernameHint"]" />
                                <span asp-validation-for="UserName" class="account-validation-message"></span>
                            </div>
                        </div>

                        <div class="profile-actions profile-submit-actions">
                            <button type="submit" class="btn btn-primary rounded-4">@L["SaveChanges"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="passwordChangeModal" tabindex="-1" aria-labelledby="passwordChangeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal profile-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="passwordChangeModalLabel">@L["PasswordChangeTitle"]</h5>
                        <p class="mb-0 text-muted small">@L["PasswordChangeText"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <form id="change-password-form" class="password-form">
                    @Html.AntiForgeryToken()
                    <div id="password-errors" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">@L["CurrentPassword"]</label>
                        <div class="password-wrapper">
                            <input type="password" class="form-control password-input" id="currentPassword" name="currentPassword" required>
                            <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="password-error" id="currentPassword-error"></div>
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label">@L["NewPassword"]</label>
                        <div class="password-wrapper">
                            <input type="password" class="form-control password-input" id="newPassword" name="newPassword" required minlength="@PasswordPolicy.RequiredLength" pattern="@PasswordPolicy.HtmlPattern" title="@L["PasswordPolicyError"]">
                            <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="password-error" id="newPassword-error"></div>
                    </div>

                    <div class="mb-2">
                        <label for="confirmPassword" class="form-label">@L["ConfirmNewPassword"]</label>
                        <div class="password-wrapper">
                            <input type="password" class="form-control password-input" id="confirmPassword" name="confirmPassword" required>
                            <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <div class="password-error" id="confirmPassword-error"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer modern-modal-footer">
                <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">@L["Cancel"]</button>
                <button type="button" class="btn btn-primary rounded-4" id="submit-password-change">@L["ResetPasswordSubmit"]</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/components/account-validation.js" asp-append-version="true"></script>
    <script>
        const profileTexts = {
            currentRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Validation.CurrentPasswordRequired"].Value)),
            newRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Validation.NewPasswordRequired"].Value)),
            confirmRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Validation.ConfirmNewPasswordRequired"].Value)),
            passwordPolicy: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PasswordPolicyError"].Value)),
            passwordsMatch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Validation.NewPasswordsMatch"].Value)),
            passwordChanged: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PasswordChangedSuccess"].Value)),
            genericError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["CommonError"].Value)),
            passwordPattern: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(PasswordPolicy.Pattern))
        };

        $(document).ready(function() {
            const passwordModalElement = document.getElementById("passwordChangeModal");

            const openPasswordChangeModal = function() {
                $("#change-password-form")[0].reset();
                $("#password-errors").html("");
                $(".password-error").html("");
                bootstrap.Modal.getOrCreateInstance(passwordModalElement).show();
            };

            const openPasswordModalFromHash = function() {
                if (window.location.hash === "#password") {
                    openPasswordChangeModal();
                }
            };

            window.addEventListener("hashchange", openPasswordModalFromHash);
            passwordModalElement.addEventListener("hidden.bs.modal", function() {
                if (window.location.hash === "#password") {
                    window.history.replaceState(null, "", window.location.pathname + window.location.search);
                }
            });

            openPasswordModalFromHash();

            $("#submit-password-change").click(function() {
                let isValid = true;

                if ($("#currentPassword").val() === "") {
                    $("#currentPassword-error").text(profileTexts.currentRequired);
                    isValid = false;
                } else {
                    $("#currentPassword-error").text("");
                }

                const newPasswordValue = $("#newPassword").val();
                const passwordPolicy = new RegExp(profileTexts.passwordPattern);

                if (newPasswordValue === "") {
                    $("#newPassword-error").text(profileTexts.newRequired);
                    isValid = false;
                } else if (!passwordPolicy.test(newPasswordValue)) {
                    $("#newPassword-error").text(profileTexts.passwordPolicy);
                    isValid = false;
                } else {
                    $("#newPassword-error").text("");
                }

                if ($("#confirmPassword").val() === "") {
                    $("#confirmPassword-error").text(profileTexts.confirmRequired);
                    isValid = false;
                } else if ($("#confirmPassword").val() !== $("#newPassword").val()) {
                    $("#confirmPassword-error").text(profileTexts.passwordsMatch);
                    isValid = false;
                } else {
                    $("#confirmPassword-error").text("");
                }

                if (!isValid) {
                    return;
                }

                window.appApi.post("@Url.Action("ChangePassword", "Profil")", {
                        currentPassword: $("#currentPassword").val(),
                        newPassword: $("#newPassword").val(),
                        confirmPassword: $("#confirmPassword").val()
                    }).done(function(response) {
                        bootstrap.Modal.getInstance(document.getElementById("passwordChangeModal")).hide();
                        window.showAppToast(response.message || profileTexts.passwordChanged, "success");
                    }).fail(function(xhr) {
                        if (xhr.responseJSON && xhr.responseJSON.errors) {
                            let errorHtml = "";
                            Object.keys(xhr.responseJSON.errors).forEach(function(key) {
                                xhr.responseJSON.errors[key].forEach(function(error) {
                                    errorHtml += `<div>${error}</div>`;
                                });
                            });

                            $("#password-errors").html(errorHtml);
                            return;
                        }

                        $("#password-errors").html(`<div>${profileTexts.genericError}</div>`);
                    });
            });
        });
    </script>
}
