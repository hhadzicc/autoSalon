# Local Docker demo defaults

MSSQL_SA_PASSWORD=AutoSalon_Demo123!

DEMO_ADMIN_EMAIL=admin@autosalon.local
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_ADMIN_FIRST_NAME=Demo
DEMO_ADMIN_LAST_NAME=Admin

DEMO_BUYER_EMAIL=kupac@autosalon.local
DEMO_BUYER_PASSWORD=Kupac123!

DEMO_SELLER_EMAIL=prodavac@autosalon.local
DEMO_SELLER_PASSWORD=Prodavac123!

# Public demo behavior. Demo data is seeded at startup and reset every 60 minutes.
# For a non-demo deployment, disable all three switches and replace the database
# and administrator credentials above.
DEMO_MODE=true
DEMO_RESET_ENABLED=true
DATABASE_SEED_DEMO_DATA=true
DEMO_RESET_INTERVAL_MINUTES=60

# Optional real Stripe test keys for private local testing.
# The Docker demo uses mock payments by default.
STRIPE_USE_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional password reset email provider. Delivery remains off unless explicitly
# enabled. Reset links and tokens are never written to logs.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
FROM_EMAIL=

# Runtime settings for the default docker-compose.yml.
ASPNETCORE_ENVIRONMENT=Development
APP_HTTP_PORT=8080
SEQ_HTTP_PORT=5341

# Set this on a server that runs behind the configured reverse proxy.
REVERSE_PROXY_KNOWN_PROXY=172.30.250.1

# Private Seq log viewer. Generate the password hash with:
# 'your-password' | docker run --rm -i datalust/seq:latest config hash
SEQ_ADMIN_PASSWORD_HASH=

# Used only with docker-compose.standalone.yml for a separate Caddy deployment.
# Set a published image, a real domain and private production passwords.
WEB_IMAGE=
APP_DOMAIN=
STANDALONE_NETWORK_SUBNET=172.30.251.0/24
STANDALONE_PROXY_IP=172.30.251.10
