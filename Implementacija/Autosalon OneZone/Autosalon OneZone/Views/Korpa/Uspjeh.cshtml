@model Autosalon_OneZone.Models.Narudzba
@{
    ViewData["Title"] = L["PurchaseSuccessTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container text-center">
        <p class="section-eyebrow">@L["Purchase"]</p>
        <h1>@L["PurchaseCompleted"]</h1>
        <p>@L["PurchaseRecorded"]</p>
    </div>
</section>

<section class="success-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="success-card">
                    <div class="success-icon">
                        <i class="bi bi-check-lg"></i>
                    </div>

                    <h2>@L["ThankYouForPurchase"]</h2>
                    <p class="success-text">@L["PurchaseSuccessText"]</p>

                    <div class="order-summary">
                        <div>
                            <span>@L["OrderNumber"]</span>
                            <strong>#@Model.NarudzbaID</strong>
                        </div>

                        <div>
                            <span>@L["Date"]</span>
                            <strong>@Model.DatumNarudzbe.ToString("dd.MM.yyyy. HH:mm")</strong>
                        </div>

                        <div>
                            <span>@L["TotalAmount"]</span>
                            <strong>€@Model.UkupnaCijena.ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="purchase-details">
                        <h3>@L["PurchaseDetails"]</h3>

                        <div class="purchase-row purchase-head">
                            <span>@L["Vehicle"]</span>
                            <span>@L["VehiclePrice"]</span>
                        </div>

                        @foreach (var stavka in Model.StavkeKorpe)
                        {
                            <div class="purchase-row">
                                <span>@stavka.Vozilo.Marka @stavka.Vozilo.Model (@stavka.Vozilo.Godiste)</span>
                                <strong>€@stavka.CijenaStavke.ToString("N2")</strong>
                            </div>
                        }
                    </div>

                    <div class="success-note">
                        <i class="bi bi-info-circle-fill"></i>
                        <div>
                            <strong>@L["WhatNext"]</strong>
                            <p>@L["PurchaseNextText"] <strong>autosalon@autosalon.com</strong>.</p>
                        </div>
                    </div>

                    <div class="success-actions">
                        <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary rounded-4">
                            <i class="bi bi-car-front-fill me-2"></i>@L["BackToVehicles"]
                        </a>

                        <a href="@Url.Action("KupljeniArtikli", "Profil")" class="btn btn-outline-primary rounded-4">
                            <i class="bi bi-bag-check me-2"></i>@L["NavPurchasedItems"]
                        </a>

                        <a href="@Url.Action("Index", "Profil")" class="btn btn-light border rounded-4">
                            <i class="bi bi-person-fill me-2"></i>@L["NavMyProfile"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
