@using System.Globalization
@using Autosalon_OneZone.ViewModels
@model HomeIndexViewModel

@{
    ViewData["Title"] = "Početna Stranica";

    var culture = CultureInfo.GetCultureInfo("bs-BA");
    var featuredVehicle = Model.FeaturedVehicle;
    var featuredVehicles = Model.FeaturedVehicles;
    var hasFeaturedVehicle = featuredVehicle != null;
    var vehicleName = hasFeaturedVehicle ? $"{featuredVehicle!.Marka} {featuredVehicle.Model}" : "Izdvojeno vozilo";
    var vehicleImage = hasFeaturedVehicle && !string.IsNullOrWhiteSpace(featuredVehicle!.Slika)
        ? Url.Content($"~/images/vozila/{featuredVehicle.Slika}")
        : null;
    var vehiclePrice = hasFeaturedVehicle && featuredVehicle!.Cijena.HasValue
        ? $"€{featuredVehicle.Cijena.Value.ToString("N0", culture)}"
        : "Cijena na upit";
    var vehicleMileage = hasFeaturedVehicle && featuredVehicle!.Kilometraza.HasValue
        ? $"{featuredVehicle.Kilometraza.Value.ToString("N0", culture)} km"
        : "Nije uneseno";
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-badge"><i class="bi bi-lightning-charge-fill me-2"></i>Brza kupovina, provjerena vozila</div>

                <h1 class="hero-title">
                    Pronađite vozilo koje izgleda dobro, vozi bolje i <span>odgovara vašem budžetu.</span>
                </h1>

                <p class="hero-text">
                    OneZone donosi preglednu ponudu automobila, jednostavnu pretragu, transparentne cijene i podršku tokom cijelog procesa kupovine.
                </p>

                <div class="hero-actions d-flex flex-wrap gap-3 mb-4">
                    <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary btn-lg rounded-4 px-4">Pogledaj ponudu</a>
                    <a href="@Url.Action("Kontakt", "Home")" class="btn btn-outline-light btn-lg rounded-4 px-4">Kontaktiraj nas</a>
                </div>

                <form class="hero-search d-flex gap-2" action="/Vozilo/Index" method="get" role="search">
                    <input class="form-control" type="search" name="searchTerm" placeholder="Marka, model, godina ili cijena..." aria-label="Pretraži vozila">
                    <button class="btn btn-primary" type="submit">Pronađi vozilo</button>
                </form>
            </div>

            <div class="col-lg-5">
                <div class="featured-car-card">
                    @if (hasFeaturedVehicle)
                    {
                        if (!string.IsNullOrWhiteSpace(vehicleImage))
                        {
                            <div class="car-image" style="background-image: url('@vehicleImage');"></div>
                        }
                        else
                        {
                            <div class="car-image car-image-placeholder">
                                <i class="bi bi-car-front-fill"></i>
                                <span>Slika nije dostupna</span>
                            </div>
                        }

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start gap-3 mb-4">
                            <div>
                                <h2 class="fw-black mb-1">@vehicleName</h2>
                                <p class="text-light opacity-75 mb-0">@featuredVehicle!.Godiste · @featuredVehicle.Gorivo · @featuredVehicle.Boja</p>
                            </div>
                            <span class="price-badge">@vehiclePrice</span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-4">
                                <div class="glass-stat">
                                    <strong>@featuredVehicle.Godiste</strong>
                                    <span>godište</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="glass-stat">
                                    <strong>@vehicleMileage</strong>
                                    <span>kilometraža</span>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="glass-stat">
                                    <strong>@featuredVehicle.Gorivo</strong>
                                    <span>gorivo</span>
                                </div>
                            </div>
                        </div>

                        <a href="@Url.Action("Details", "Vozilo", new { id = featuredVehicle.VoziloID })" class="btn btn-light rounded-4 px-4 fw-bold">
                            Pogledaj detalje
                        </a>
                    }
                    else
                    {
                        <div class="empty-featured-car">
                            <i class="bi bi-car-front-fill"></i>
                            <h2 class="fw-black mb-2">Izdvojeno vozilo trenutno nije dostupno</h2>
                            <p class="text-light opacity-75 mb-4">Ponuda se može pregledati na stranici vozila.</p>
                            <a href="@Url.Action("Index", "Vozilo")" class="btn btn-light rounded-4 px-4 fw-bold">Pogledaj ponudu</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <p class="section-eyebrow">Zašto OneZone?</p>
                <h2 class="section-title">Kupovina automobila treba biti jednostavna, brza i sigurna.</h2>
                <p class="section-text mb-0">
                    Ponuda je organizovana za brzo poređenje vozila, pregled detalja i direktan nastavak kupovine.
                </p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-car-front-fill"></i></div>
                        <h3 class="h5 fw-bold">Veliki izbor vozila</h3>
                        <p class="text-secondary mb-0">Pregled vozila je filtriran, pretraživ i prilagođen brzom poređenju osnovnih podataka.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
                        <h3 class="h5 fw-bold">Jasne cijene</h3>
                        <p class="text-secondary mb-0">Cijena vozila je prikazana na listi, detaljima i u korpi bez oslanjanja na podatke iz forme.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-patch-check-fill"></i></div>
                        <h3 class="h5 fw-bold">Provjeren tok kupovine</h3>
                        <p class="text-secondary mb-0">Narudžba, korpa i plaćanje koriste podatke iz baze i vode korisnika kroz jasan proces.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card modern-card h-100 p-4">
                    <div class="card-body p-0">
                        <div class="feature-icon"><i class="bi bi-headset"></i></div>
                        <h3 class="h5 fw-bold">Podrška</h3>
                        <p class="text-secondary mb-0">Korisnici mogu poslati upit kroz kontakt formu i nastaviti komunikaciju sa timom salona.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-padding bg-white" id="izdvojena-vozila">
    <div class="container">
        <div class="row justify-content-center text-center mb-5">
            <div class="col-lg-8">
                <p class="section-eyebrow">Izdvojena vozila</p>
                <h2 class="section-title">Aktuelna vozila iz ponude</h2>
                <p class="section-text mb-0">
                    Kartice se popunjavaju direktno iz baze, tako da se prikazuje ono što trenutno postoji u sistemu.
                </p>
            </div>
        </div>

        @if (featuredVehicles.Any())
        {
            <div class="row g-4">
                @foreach (var vehicle in featuredVehicles)
                {
                    var cardImage = !string.IsNullOrWhiteSpace(vehicle.Slika)
                        ? Url.Content($"~/images/vozila/{vehicle.Slika}")
                        : Url.Content("~/img/no-image.png");
                    var cardPrice = vehicle.Cijena.HasValue
                        ? $"€{vehicle.Cijena.Value.ToString("N0", culture)}"
                        : "Cijena na upit";
                    var cardMileage = vehicle.Kilometraza.HasValue
                        ? $"{vehicle.Kilometraza.Value.ToString("N0", culture)} km"
                        : "Kilometraža nije unesena";

                    <div class="col-md-6 col-lg-4">
                        <article class="home-vehicle-card h-100">
                            <a href="@Url.Action("Details", "Vozilo", new { id = vehicle.VoziloID })" class="home-vehicle-image-link">
                                <img src="@cardImage" class="home-vehicle-image" alt="@vehicle.Marka @vehicle.Model">
                            </a>

                            <div class="home-vehicle-body">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h3 class="h4 fw-black mb-0">@vehicle.Marka @vehicle.Model</h3>
                                    <span class="home-vehicle-tag">@vehicle.Gorivo</span>
                                </div>

                                <p class="home-vehicle-meta mb-3">@vehicle.Godiste · @vehicle.Boja · @cardMileage</p>

                                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                    <span class="home-vehicle-price">@cardPrice</span>
                                    <a href="@Url.Action("Details", "Vozilo", new { id = vehicle.VoziloID })" class="home-details-link">Detalji</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-vehicles-state">
                <i class="bi bi-car-front-fill"></i>
                <h3 class="h4 fw-bold mb-2">Trenutno nema izdvojenih vozila</h3>
                <p class="section-text mb-0">Kada se vozila dodaju u bazu, ova sekcija će se automatski popuniti.</p>
            </div>
        }
    </div>
</section>

<section class="section-padding bg-white">
    <div class="container">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5">
                <div class="about-card h-100">
                    <p class="section-eyebrow text-info">Aktuelna ponuda</p>
                    <h2 class="section-title text-white">Pregled vozila bez nepotrebnog čekanja.</h2>
                    <p class="text-light opacity-75 mb-4">
                        Stranica vozila vodi prema stvarnim zapisima iz baze, sa slikama, filterima, detaljima i nastavkom kupovine.
                    </p>
                    <a href="@Url.Action("Index", "Vozilo")" class="btn btn-primary btn-lg rounded-4 px-4">Otvori vozila</a>
                </div>
            </div>

            <div class="col-lg-7" id="podrska">
                <div class="support-card h-100">
                    <p class="section-eyebrow">Brza podrška</p>
                    <h2 class="section-title">Pošaljite upit za vozilo ili proces kupovine.</h2>
                    <p class="section-text mb-4">
                        Kontakt forma je povezana sa postojećim dijelom aplikacije, pa se poruke obrađuju kroz realan tok podrške.
                    </p>
                    <ul class="support-list">
                        <li><i class="bi bi-check-circle-fill"></i>Odgovor u najkraćem roku</li>
                        <li><i class="bi bi-check-circle-fill"></i>Pomoć pri izboru vozila</li>
                        <li><i class="bi bi-check-circle-fill"></i>Dogovor oko pregleda i kupovine</li>
                    </ul>
                    <a href="@Url.Action("Kontakt", "Home")" class="btn btn-primary btn-lg rounded-4 px-4">Pošaljite poruku</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
}
