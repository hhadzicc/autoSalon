@using Microsoft.AspNetCore.Identity
@using Autosalon_OneZone.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "";
    var isAdminArea = currentPath.StartsWith("/adminpanel");
    var isVehiclesArea = currentPath.StartsWith("/vozilo");
    var isContactArea = currentPath.StartsWith("/home/kontakt");
    var isCartArea = currentPath.StartsWith("/korpa");
    var isProfileArea = currentPath.StartsWith("/profil");
    var isLoginArea = currentPath.StartsWith("/account/login");
    var isRegisterArea = currentPath.StartsWith("/account/register");
    var successMessage = Convert.ToString(TempData["SuccessMessage"]);
    var errorMessage = Convert.ToString(TempData["ErrorMessage"]);
    var infoMessage = Convert.ToString(TempData["InfoMessage"]);
    var warningMessage = Convert.ToString(TempData["WarningMessage"]);
    var hasFlashMessage =
        !string.IsNullOrWhiteSpace(successMessage) ||
        !string.IsNullOrWhiteSpace(errorMessage) ||
        !string.IsNullOrWhiteSpace(infoMessage) ||
        !string.IsNullOrWhiteSpace(warningMessage);
    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture.Name;
    var isBosnian = currentCulture.StartsWith("bs", StringComparison.OrdinalIgnoreCase);
    var languageLabel = isBosnian ? "BS" : "EN";
    var returnUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
}

<!DOCTYPE html>
<html lang="@(isBosnian ? "bs" : "en")">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Autosalon OneZone</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" type="text/css" href="~/css/kod.css" asp-append-version="true">
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar sticky-top">
        <div class="container-xxl align-items-center">
            <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" href="/">
                <span class="brand-icon"><i class="bi bi-car-front-fill"></i></span>
                Autosalon OneZone
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="@L["CommonShow"]">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Administrator") || User.IsInRole("Prodavac")))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isAdminArea ? "active" : "")" href="/AdminPanel/Index">
                                @L["NavAdminPanel"]
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link @(isVehiclesArea ? "active" : "")" href="/Vozilo">@L["NavVehicles"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(isContactArea ? "active" : "")" href="/Home/Kontakt">@L["NavContact"]</a>
                    </li>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link cart-link @(isCartArea ? "active" : "")" href="/Korpa">
                                <i class="bi bi-cart-fill me-lg-1"></i>@L["NavCart"]
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle @(isProfileArea ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-lg-1"></i>@L["NavMyProfile"]
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-menu">
                                <li>
                                    <a class="dropdown-item" href="/Profil">
                                        <i class="bi bi-person-fill me-2"></i>@L["NavProfile"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/KupljeniArtikli">
                                        <i class="bi bi-bag-check-fill me-2"></i>@L["NavPurchasedItems"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="/Profil/Edit#password">
                                        <i class="bi bi-key-fill me-2"></i>@L["NavChangePassword"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>@L["NavLogout"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(isLoginArea ? "active" : "")" href="/Account/Login">@L["NavLogin"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link register-link @(isRegisterArea ? "active" : "")" id="register" href="/Account/Register">@L["NavRegister"]</a>
                        </li>
                    }

                    <li class="nav-item dropdown language-switcher">
                        <a class="nav-link dropdown-toggle language-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@L["Language"]">
                            <i class="bi bi-globe2 me-lg-1"></i>@languageLabel
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end language-menu">
                            <li>
                                <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="en-US" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "EN" ? "active" : "")">
                                        <span class="language-code">EN</span>@L["LanguageEnglish"]
                                    </button>
                                </form>
                            </li>
                            <li>
                                <form asp-controller="Language" asp-action="SetLanguage" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="culture" value="bs-Latn-BA" />
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <button type="submit" class="dropdown-item @(languageLabel == "BS" ? "active" : "")">
                                        <span class="language-code">BS</span>@L["LanguageBosnian"]
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="main-content-container">
        @if (hasFlashMessage)
        {
            <div class="flash-messages" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show app-alert" role="alert">
                        @successMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show app-alert" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(infoMessage))
                {
                    <div class="alert alert-info alert-dismissible fade show app-alert" role="alert">
                        @infoMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(warningMessage))
                {
                    <div class="alert alert-warning alert-dismissible fade show app-alert" role="alert">
                        @warningMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@L["Close"]"></button>
                    </div>
                }
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container-xxl">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <h5 class="text-white fw-bold mb-2">Autosalon OneZone</h5>
                    <p class="mb-1">@L["FooterContact"]: +387 000 000 000 · Email: <a href="mailto:autosalon@autosalon.com">autosalon@autosalon.com</a></p>
                    <p class="mb-0">&copy; @DateTime.Now.Year Autosalon OneZone. @L["FooterRights"]</p>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex justify-content-lg-end gap-3 flex-wrap">
                        <a href="#">@L["FooterPrivacy"]</a>
                        <a href="#">@L["FooterTerms"]</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="globalDeleteConfirmModal" tabindex="-1" aria-labelledby="globalDeleteConfirmTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-confirm-modal">
                <div class="modal-header border-0">
                    <div class="delete-modal-heading">
                        <div class="delete-modal-icon">
                            <i class="bi bi-trash-fill"></i>
                        </div>
                        <div>
                            <h5 class="modal-title" id="globalDeleteConfirmTitle">@L["DeleteConfirmTitle"]</h5>
                            <p class="mb-0 text-muted small">@L["DeleteConfirmSubtitle"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p id="globalDeleteConfirmMessage" class="delete-confirm-message">
                        @L["DeleteConfirmMessage"]
                    </p>
                    <div id="globalDeleteConfirmItem" class="delete-confirm-item d-none"></div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="btn btn-danger rounded-4" id="globalDeleteConfirmButton">@L["DeleteConfirmAction"]</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.appTexts = {
            close: @Json.Serialize(L["Close"].Value),
            showPassword: @Json.Serialize(L["ShowPassword"].Value),
            hidePassword: @Json.Serialize(L["HidePassword"].Value),
            deleteConfirmTitle: @Json.Serialize(L["DeleteConfirmTitle"].Value),
            deleteConfirmMessage: @Json.Serialize(L["DeleteConfirmMessage"].Value),
            deleteConfirmAction: @Json.Serialize(L["DeleteConfirmAction"].Value),
            validationRequired: @Json.Serialize(L["ValidationRequired"].Value),
            validationEmail: @Json.Serialize(L["ValidationEmail"].Value),
            validationUrl: @Json.Serialize(L["ValidationUrl"].Value),
            validationDate: @Json.Serialize(L["ValidationDate"].Value),
            validationDateIso: @Json.Serialize(L["ValidationDateIso"].Value),
            validationNumber: @Json.Serialize(L["ValidationNumber"].Value),
            validationDigits: @Json.Serialize(L["ValidationDigits"].Value),
            validationCreditCard: @Json.Serialize(L["ValidationCreditCard"].Value),
            validationEqualTo: @Json.Serialize(L["ValidationEqualTo"].Value),
            validationMaxLength: @Json.Serialize(L["ValidationMaxLength"].Value),
            validationMinLength: @Json.Serialize(L["ValidationMinLength"].Value),
            validationRangeLength: @Json.Serialize(L["ValidationRangeLength"].Value),
            validationRange: @Json.Serialize(L["ValidationRange"].Value),
            validationMax: @Json.Serialize(L["ValidationMax"].Value),
            validationMin: @Json.Serialize(L["ValidationMin"].Value)
        };
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("BottomScripts", required: false)
</body>
</html>
