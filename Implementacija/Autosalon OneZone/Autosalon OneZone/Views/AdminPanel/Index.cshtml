@Html.AntiForgeryToken()
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = L["AdminPanel"];
    var currentSection = ViewBag.CurrentSection;
    var user = await UserManager.GetUserAsync(User);
    bool isAdmin = user != null && await UserManager.IsInRoleAsync(user, "Administrator");
}

<section class="admin-section">
    <div class="admin-container">
        <div class="admin-layout">
            <aside class="admin-sidebar">
                <div class="admin-sidebar-title">
                    <i class="bi bi-speedometer2"></i>
                    <span>@L["AdminMenu"]</span>
                </div>

                <nav class="admin-menu" aria-label="@L["AdminMenu"]">
                    <a href="#" class="admin-menu-link" data-section="Dashboard">
                        <i class="bi bi-grid-1x2-fill"></i>
                        @L["Dashboard"]
                    </a>

                    <a href="#" class="admin-menu-link" data-section="Vozila">
                        <i class="bi bi-car-front-fill"></i>
                        @L["NavVehicles"]
                    </a>

                    @if (isAdmin)
                    {
                        <a href="#" class="admin-menu-link" data-section="Profili">
                            <i class="bi bi-people-fill"></i>
                            @L["DashboardUsers"]
                        </a>
                    }

                    <a href="#" class="admin-menu-link" data-section="Recenzije">
                        <i class="bi bi-star-fill"></i>
                        @L["Reviews"]
                    </a>

                    <a href="#" class="admin-menu-link" data-section="Podrska">
                        <i class="bi bi-headset"></i>
                        @L["DashboardSupportInquiries"]
                    </a>
                </nav>
            </aside>

            <main class="admin-content">
                <div id="admin-section-content" class="admin-section-content">
                    <div class="admin-card">
                        <div class="empty-state">
                            <i class="bi bi-grid-1x2-fill"></i>
                            <p>@L["AdminSectionLoading"]</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {
            const adminTexts = {
                notFound: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AdminSectionNotFound"].Value)),
                loading: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AdminSectionLoading"].Value)),
                loadError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AdminSectionLoadError"].Value))
            };
            const adminSectionContent = $('#admin-section-content');
            const adminSidebarLinks = $('.admin-menu-link');

            function loadSection(sectionName, params = {}) {
                let url = '';

                switch (sectionName) {
                    case 'Dashboard':
                        url = '@Url.Action("GetDashboardSection", "AdminPanel")';
                        break;
                    case 'Vozila':
                        url = '@Url.Action("GetVozilaSection", "AdminPanel")';
                        break;
                    case 'Profili':
                        url = '@Url.Action("GetProfiliSection", "AdminPanel")';
                        break;
                    case 'Recenzije':
                        url = '@Url.Action("GetRecenzijeSection", "AdminPanel")';
                        break;
                    case 'Podrska':
                        url = '@Url.Action("GetPodrskaSection", "AdminPanel")';
                        break;
                    default:
                        adminSectionContent.html('<div class="admin-card"><div class="alert alert-warning mb-0">' + adminTexts.notFound + '</div></div>');
                        return;
                }

                adminSectionContent.html('<div class="admin-card"><div class="empty-state"><i class="bi bi-hourglass-split"></i><p>' + adminTexts.loading + '</p></div></div>');

                $.get(url, params, function (data) {
                    $('script.dynamic-partial-script').remove();
                    const tempDiv = $('<div>').html(data);
                    const scripts = [];

                    tempDiv.find('script').each(function () {
                        scripts.push({
                            src: this.src,
                            text: this.textContent
                        });
                        $(this).remove();
                    });

                    adminSectionContent.html(tempDiv.html());

                    scripts.forEach(function (scriptData) {
                        const newScript = document.createElement('script');

                        if (scriptData.src) {
                            newScript.src = scriptData.src;
                        } else {
                            newScript.textContent = scriptData.text;
                        }

                        newScript.type = 'text/javascript';
                        newScript.classList.add('dynamic-partial-script');
                        document.body.appendChild(newScript);
                    });
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    adminSectionContent.html('<div class="admin-card"><div class="alert alert-danger mb-0">' + adminTexts.loadError + errorThrown + '</div></div>');
                });

                adminSidebarLinks.removeClass('active');
                $(`.admin-menu-link[data-section="${sectionName}"]`).addClass('active');
            }

            adminSidebarLinks.on('click', function (e) {
                e.preventDefault();
                loadSection($(this).data('section'));
            });

            let defaultSection = '@(currentSection ?? "Dashboard")';

            if (defaultSection === 'Profili' && !@Json.Serialize(isAdmin)) {
                defaultSection = 'Dashboard';
            }

            loadSection(defaultSection);
            window.loadSection = loadSection;
        });
    </script>
}
