@using Microsoft.AspNetCore.Identity
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager
@model Autosalon_OneZone.ViewModels.KontaktViewModel
@{
    ViewData["Title"] = L["ContactTitle"];
    var isSignedIn = SignInManager.IsSignedIn(User);
    var returnUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
}

<section class="inner-page-header contact-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <h1>@L["ContactHeaderTitle"]</h1>
                <p>@L["ContactHeaderText"]</p>
            </div>
        </div>
    </div>
</section>
<section class="auth-section contact-content-section">
    <div class="container">
        <div class="row justify-content-center align-items-start g-4">
            <div class="col-lg-7 col-xl-6">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi @(isSignedIn ? "bi-chat-dots-fill" : "bi-envelope-paper-fill")"></i>
                        </div>
                        <h2>@(isSignedIn ? L["ContactSendMessageHeading"] : L["ContactSupportRequestHeading"])</h2>
                        <p class="text-muted mb-0">@(isSignedIn ? L["ContactSignedInText"] : L["ContactGuestText"])</p>
                    </div>

                    @if (isSignedIn)
                    {
                        <form asp-controller="Home" asp-action="Kontakt" method="post" id="contact-form" autocomplete="off">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="Naslov" class="form-label">@L["ContactSubject"]</label>
                                <input asp-for="Naslov" class="form-control" placeholder="@L["ContactSubjectPlaceholder"]" autocomplete="off" />
                                <span asp-validation-for="Naslov" class="text-danger"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Sadrzaj" class="form-label">@L["ContactMessage"]</label>
                                <textarea asp-for="Sadrzaj" class="form-control" rows="6" maxlength="5000" placeholder="@L["ContactMessagePlaceholder"]" autocomplete="off"></textarea>
                                <span asp-validation-for="Sadrzaj" class="text-danger"></span>
                            </div>

                            <button type="submit" id="send-message" class="btn btn-primary btn-lg rounded-4 w-100">@L["ContactSendMessage"]</button>
                        </form>
                    }
                    else
                    {
                        <div class="contact-choice text-center">
                            <div class="contact-login-action">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" class="oz-btn">
                                    <span>@L["ContactLoginToSend"]</span>
                                    <span class="oz-btn-arrow" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M5 12h14"></path>
                                            <path d="m14 7 5 5-5 5"></path>
                                        </svg>
                                    </span>
                                </a>
                            </div>
                            <p class="contact-register-prompt">
                                @L["ContactRegisterPrompt"]
                                <a asp-controller="Account" asp-action="Register" asp-route-returnUrl="@returnUrl">@L["ContactRegisterAction"]</a>
                            </p>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5 col-xl-4">
                <aside class="info-card contact-info-card">
                    <h3>@L["ContactInfoTitle"]</h3>

                    <div class="info-item">
                        <i class="bi bi-envelope-fill"></i>
                        <div>
                            <strong>@L["EmailAddress"]</strong>
                            <span>autosalon@autosalon.com</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-telephone-fill"></i>
                        <div>
                            <strong>@L["ContactPhone"]</strong>
                            <span>+387 000 000 000</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-clock-fill"></i>
                        <div>
                            <strong>@L["ContactResponseTime"]</strong>
                            <span>@L["ContactResponseSoon"]</span>
                        </div>
                    </div>

                    <div class="info-item">
                        <i class="bi bi-car-front-fill"></i>
                        <div>
                            <strong>@L["ContactInquiries"]</strong>
                            <span>@L["ContactInquiryTypes"]</span>
                        </div>
                    </div>

                    <a href="mailto:autosalon@autosalon.com" class="contact-direct-email">
                        <i class="bi bi-envelope"></i>
                        <span>@L["ContactDirectEmail"]</span>
                    </a>
                </aside>
            </div>
        </div>
    </div>
</section>
