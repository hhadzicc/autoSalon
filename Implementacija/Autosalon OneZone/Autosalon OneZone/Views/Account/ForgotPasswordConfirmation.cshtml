@{
    ViewData["Title"] = L["ForgotPasswordConfirmationTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["ResetPasswordEyebrow"]</p>
                <h1>@L["ForgotPasswordConfirmationTitle"]</h1>
                <p>@L["ForgotPasswordConfirmationIntro"]</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card text-center">
                    <div class="form-icon mx-auto">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h2>@L["ForgotPasswordConfirmationTitle"]</h2>
                    <p class="text-muted mb-4">@L["ForgotPasswordConfirmationText"]</p>
                    <div class="d-grid gap-3">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-4">@L["BackToLogin"]</a>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-light border btn-lg rounded-4">@L["RequestNewLink"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
