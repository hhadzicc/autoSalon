@model Autosalon_OneZone.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = L["AuthRegisterTitle"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">@L["AuthRegisterEyebrow"]</p>
                <h1>@L["AuthRegisterTitle"]</h1>
                <p>@L["AuthRegisterSubtitle"]</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-9">
                <div class="modern-form-card">
                    <div class="text-center mb-4">
                        <div class="form-icon mx-auto">
                            <i class="bi bi-person-plus-fill"></i>
                        </div>
                        <h2>@L["AuthCreateAccount"]</h2>
                    </div>

                    <div asp-validation-summary="All" class="text-danger validation-summary mb-3"></div>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Ime" class="form-label">@L["FirstName"]</label>
                                <input asp-for="Ime" type="text" class="form-control" placeholder="@L["FirstName"]" required pattern="[A-Za-z\s]+" />
                                <span asp-validation-for="Ime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Prezime" class="form-label">@L["LastName"]</label>
                                <input asp-for="Prezime" type="text" class="form-control" placeholder="@L["LastName"]" required pattern="[A-Za-z\s]+" />
                                <span asp-validation-for="Prezime" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="UserName" class="form-label">@L["Username"]</label>
                                <input asp-for="UserName" type="text" class="form-control" placeholder="@L["Username"]" required pattern="[A-Za-z0-9]+" />
                                <span asp-validation-for="UserName" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Email" class="form-label">@L["EmailAddress"]</label>
                                <input asp-for="Email" type="email" class="form-control" placeholder="@L["EmailAddress"]" autocomplete="email" required />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label">@L["AuthPassword"]</label>
                                <div class="password-wrapper">
                                    <input asp-for="Password" type="password" class="form-control password-input" placeholder="@L["AuthPassword"]" autocomplete="new-password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="@L["PasswordPolicyError"]" />
                                    <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label">@L["ConfirmPassword"]</label>
                                <div class="password-wrapper">
                                    <input asp-for="ConfirmPassword" type="password" class="form-control password-input" placeholder="@L["ConfirmPassword"]" autocomplete="new-password" required />
                                    <button type="button" class="password-toggle" aria-label="@L["ShowPassword"]">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary btn-lg rounded-4 w-100 mt-2">@L["NavRegister"]</button>
                            </div>
                        </div>

                        <div class="text-center mt-4">
                            <p class="mb-0">
                                @L["AuthAlreadyHaveAccount"]
                                <a asp-controller="Account" asp-action="Login" class="fw-bold">@L["AuthSignInLink"]</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
