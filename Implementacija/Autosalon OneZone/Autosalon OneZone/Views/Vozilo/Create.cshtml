@model Autosalon_OneZone.Models.Vozilo

@{
    ViewData["Title"] = L["CreateVehicleTitle"];
}

<section class="inner-page-header">
    <div class="container text-center">
        <p class="section-eyebrow">@L["VehiclesOverview"]</p>
        <h1>@L["CreateVehicleTitle"]</h1>
        <p>@L["CreateVehicleText"]</p>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="modern-form-card">
                    <form asp-controller="Vozilo" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Marka" class="form-label">@L["VehicleMake"]</label>
                            <input asp-for="Marka" class="form-control" />
                            <span asp-validation-for="Marka" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model" class="form-label">@L["VehicleModel"]</label>
                            <input asp-for="Model" class="form-control" />
                            <span asp-validation-for="Model" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Godiste" class="form-label">@L["VehicleYear"]</label>
                            <input asp-for="Godiste" class="form-control" />
                            <span asp-validation-for="Godiste" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Gorivo" class="form-label">@L["VehicleFuel"]</label>
                            <select asp-for="Gorivo" class="form-control" asp-items="Html.GetEnumSelectList<Autosalon_OneZone.Models.TipGoriva>()"></select>
                            <span asp-validation-for="Gorivo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Kubikaza" class="form-label">@L["VehicleDisplacement"]</label>
                            <input asp-for="Kubikaza" class="form-control" />
                            <span asp-validation-for="Kubikaza" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Boja" class="form-label">@L["VehicleColor"]</label>
                            <input asp-for="Boja" class="form-control" />
                            <span asp-validation-for="Boja" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Kilometraza" class="form-label">@L["VehicleMileage"]</label>
                            <input asp-for="Kilometraza" class="form-control" />
                            <span asp-validation-for="Kilometraza" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Cijena" class="form-label">@L["VehiclePrice"]</label>
                            <input asp-for="Cijena" class="form-control" />
                            <span asp-validation-for="Cijena" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary rounded-4">@L["CommonSave"]</button>
                        <a asp-controller="Vozilo" asp-action="Index" class="btn btn-light border rounded-4 ms-2">@L["BackToList"]</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
