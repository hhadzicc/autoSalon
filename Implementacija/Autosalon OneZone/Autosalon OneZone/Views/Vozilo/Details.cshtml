@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager

@model Autosalon_OneZone.Models.ViewModels.VehicleDetailsViewModel
@{
    var vehicle = Model.Vehicle;
    ViewData["Title"] = $"{vehicle.Marka} {vehicle.Model}";
    var culture = CultureInfo.CurrentCulture;
    var voziloNaziv = $"{vehicle.Marka} {vehicle.Model}".Trim();
    var cijena = vehicle.Cijena ?? 0;
    var slikaUrl = !string.IsNullOrEmpty(vehicle.Slika) ? Url.Content($"~/images/vozila/{vehicle.Slika}") : Url.Content("~/img/no-image.png");
    var isInCart = ViewData["IsInCart"] as bool? ?? false;
    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    var returningToCart = string.Equals(returnUrl, "/Korpa", StringComparison.OrdinalIgnoreCase);
}

<section class="vehicle-details-section">
    <div class="container">
        <div class="vehicle-details-back-row">
            <button type="button"
                    class="vehicle-back-button"
                    data-vehicle-back
                    data-return-url="@(returningToCart ? Url.Action("Index", "Korpa") : "")"
                    data-fallback-url="@Url.Action("Index", returningToCart ? "Korpa" : "Vozilo")">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>@L[returningToCart ? "BackToCart" : "BackToVehicles"]</span>
            </button>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <article class="vehicle-details-card">
                    <div class="vehicle-gallery">
                        <img src="@slikaUrl" alt="@voziloNaziv">
                    </div>

                    <div class="vehicle-details-body">
                        <div class="vehicle-title-row">
                            <div>
                                <h2>@voziloNaziv</h2>
                                <p class="vehicle-subtitle">@vehicle.Godiste · @L[FuelPresentation.GetResourceKey(vehicle.Gorivo)] · @L[VehicleColorPresentation.GetResourceKey(vehicle.Boja)]</p>
                            </div>

                            <div class="vehicle-price">€@cijena.ToString("N0", culture)</div>
                        </div>

                        <div class="vehicle-actions">
                            @if (SignInManager.IsSignedIn(User))
                            {
                                <form class="add-to-cart-form"
                                      asp-controller="Korpa"
                                      asp-action="DodajUKorpu"
                                      method="post"
                                      data-vehicle-name="@voziloNaziv"
                                      data-adding-text="@L["CartAdding"]"
                                      data-added-text="@L["CartInCart"]"
                                      data-view-cart-text="@L["CartView"]"
                                      data-success-template="@L["CartVehicleAddedToast"]"
                                      data-cart-url="@Url.Action("Index", "Korpa")"
                                      data-error-text="@L["CartAddError"]">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@vehicle.VoziloID" />
                                    <button type="submit"
                                            class="btn btn-outline-primary rounded-4 @(isInCart ? "is-added" : "")"
                                            data-cart-button
                                            disabled="@isInCart">
                                        <i class="bi @(isInCart ? "bi-check-lg" : "bi-cart-plus") me-2" data-cart-icon></i><span data-cart-button-text>@(isInCart ? L["CartInCart"] : L["AddToCart"])</span>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-primary rounded-4" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                    <i class="bi bi-lightning-charge-fill me-2"></i>@L["BuyNow"]
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })" class="btn btn-primary rounded-4">
                                    <i class="bi bi-person-check me-2"></i>@L["LoginToBuy"]
                                </a>
                            }
                        </div>

                        <div class="details-block">
                            <h3>@L["Specifications"]</h3>

                            <div class="spec-grid">
                                <div class="spec-item">
                                    <span>@L["VehicleYear"]</span>
                                    <strong>@vehicle.Godiste</strong>
                                </div>
                                <div class="spec-item">
                                    <span>@L["VehicleFuel"]</span>
                                    <strong>@L[FuelPresentation.GetResourceKey(vehicle.Gorivo)]</strong>
                                </div>
                                <div class="spec-item">
                                    <span>@L["VehicleColor"]</span>
                                    <strong>@L[VehicleColorPresentation.GetResourceKey(vehicle.Boja)]</strong>
                                </div>
                                @if (vehicle.Gorivo != Autosalon_OneZone.Models.TipGoriva.Elektro)
                                {
                                    <div class="spec-item">
                                        <span>@L["VehicleDisplacement"]</span>
                                        <strong>@vehicle.Kubikaza</strong>
                                    </div>
                                }
                                <div class="spec-item">
                                    <span>@L["VehicleMileage"]</span>
                                    <strong>@vehicle.Kilometraza km</strong>
                                </div>
                            </div>
                        </div>

                        <div class="details-block">
                            <h3>@L["VehicleDescription"]</h3>
                            <p>@(vehicle.Opis ?? L["NoVehicleDescription"].Value)</p>
                        </div>
                    </div>
                </article>

                <section class="reviews-card customer-experiences-card">
                    <div class="reviews-header">
                        <div>
                            <h2>@L["CustomerExperiencesTitle"]</h2>
                            <p>@L["CustomerExperiencesSubtitle"]</p>
                        </div>
                        @if (Model.CustomerExperiences.AverageRating.HasValue)
                        {
                            <div class="experience-summary" aria-label="@L["AverageCustomerRating"]">
                                <i class="bi bi-star-fill" aria-hidden="true"></i>
                                <strong>@Model.CustomerExperiences.AverageRating.Value.ToString("0.0", culture)</strong>
                                <span>@L["ExperienceCount", Model.CustomerExperiences.TotalCount]</span>
                            </div>
                        }
                    </div>

                    @if (Model.CustomerExperiences.Recent.Any())
                    {
                        <div class="details-review-list">
                            @foreach (var experience in Model.CustomerExperiences.Recent)
                            {
                                <article class="review-item">
                                    <div class="review-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="review-content">
                                        <div class="review-top">
                                            <div>
                                                <strong>@experience.CustomerName</strong>
                                                <span class="verified-purchase-badge">
                                                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i>@L["VerifiedPurchase"]
                                                </span>
                                            </div>
                                            <span class="review-stars" aria-label="@L["RatingOutOfFive", experience.Rating]">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= experience.Rating ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </span>
                                        </div>
                                        <p>@experience.Comment</p>
                                        <div class="experience-meta">
                                            <span>@L["PurchasedVehicle"] <strong>@experience.VehicleName</strong></span>
                                            <small>@experience.CreatedAt.ToString("dd.MM.yyyy")</small>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-reviews">
                            <i class="bi bi-chat-square-text"></i>
                            <h3>@L["NoCustomerExperiencesTitle"]</h3>
                            <p>@L["NoCustomerExperiencesText"]</p>
                        </div>
                    }
                </section>
            </div>

            <div class="col-lg-4">
                <aside class="details-sidebar">
                    @await Html.PartialAsync("_LoanCalculator", new Autosalon_OneZone.Models.ViewModels.LoanCalculatorViewModel
                    {
                        InitialAmount = cijena,
                        DefaultPeriod = 60
                    })
                </aside>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-credit-card-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="paymentModalLabel">@L["PaymentDetails"]</h5>
                        <p class="payment-vehicle-name mb-0">@voziloNaziv</p>
                        <p class="mb-0 text-muted small">@L["PaymentDetailsText"]</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
            </div>
            <div class="modal-body">
                <div class="payment-total-alert mb-4">
                    <strong>@L["TotalToPay"]</strong> <span class="text-success fw-bold">€@cijena.ToString("N0", culture)</span>
                </div>

                <div class="payment-modal-error alert alert-danger d-none py-2 px-3 mb-3" id="paymentRequestError" role="alert"></div>

                <form id="paymentForm" asp-controller="Korpa" asp-action="IzvrsiPlacanje" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="VoziloID" value="@vehicle.VoziloID" />
                    @await Html.PartialAsync("_PaymentFields", new Autosalon_OneZone.Models.ViewModels.PaymentFieldsViewModel())

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-success" id="submitPayment">@L["ConfirmPurchase"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/components/cart-actions.js" asp-append-version="true"></script>
    <script src="~/js/components/vehicle-details-navigation.js" asp-append-version="true"></script>
    <script src="~/js/components/loan-calculator.js" asp-append-version="true"></script>
    <script src="~/js/components/payment-form.js" asp-append-version="true"></script>
    <script>
        const paymentTexts = {
            processing: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["Processing"].Value)),
            confirmPurchase: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["ConfirmPurchase"].Value)),
            paymentFailed: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentFailedPrefix"].Value)),
            requestError: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentRequestError"].Value)),
            holderRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentHolderRequired"].Value)),
            cardRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardRequired"].Value)),
            cardLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardLength"].Value)),
            expiryRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryRequired"].Value)),
            expiryFormat: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentExpiryFormat"].Value)),
            cardExpired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCardExpired"].Value)),
            cvvRequired: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvRequired"].Value)),
            cvvLength: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["PaymentCvvLength"].Value))
        };

        $(document).ready(function() {
            const paymentOptions = {
                buttonSelector: "#submitPayment",
                errorSelector: "#paymentRequestError",
                texts: paymentTexts
            };

            window.paymentForm.initialize("#paymentForm", paymentOptions);
            $("#paymentModal").on("show.bs.modal", function() {
                window.paymentForm.reset("#paymentForm", paymentOptions);
            });
        });
    </script>
}
