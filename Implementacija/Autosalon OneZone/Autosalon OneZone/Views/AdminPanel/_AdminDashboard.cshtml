@model Autosalon_OneZone.ViewModels.Admin.AdminDashboardViewModel
@using Autosalon_OneZone.Models
@using Autosalon_OneZone.Authorization
@using System.Globalization
@using System.Linq

@functions {
    private static string FormatDate(DateTime date) => date.ToString("dd-MM-yyyy", CultureInfo.CurrentCulture);

    private string SupportStatusLabel(StatusUpita status) => status switch
    {
        StatusUpita.CekaPodrsku => L["SupportStatus.CekaPodrsku"].Value,
        StatusUpita.UObradi => L["SupportStatus.UObradi"].Value,
        StatusUpita.CekaKorisnika => L["SupportStatus.CekaKorisnika"].Value,
        StatusUpita.Rijesen => L["SupportStatus.Rijesen"].Value,
        _ => L["SupportStatus.Zatvoren"].Value
    };

    private static string SupportStatusClass(StatusUpita status) => status switch
    {
        StatusUpita.CekaPodrsku => "info",
        StatusUpita.UObradi => "warning",
        StatusUpita.CekaKorisnika => "waiting",
        StatusUpita.Rijesen => "waiting",
        StatusUpita.Zatvoren => "secondary",
        _ => "secondary"
    };
}

<div class="admin-page-header dashboard-page-header">
    <div>
        <h1>@L["AdminDashboardTitle"]</h1>
    </div>

    <div class="dashboard-header-actions">
        @if (User.IsInRole(AppRoles.Administrator))
        {
            <button type="button"
                    class="btn btn-primary rounded-4 dashboard-create-link"
                    data-section="Profili"
                    data-form-trigger="#add-profil-button"
                    data-return-section="Dashboard">
                <i class="bi bi-person-plus-fill me-2"></i>@L["AdminAddUser"]
            </button>
        }
        <button type="button"
                class="btn @(User.IsInRole(AppRoles.Administrator) ? "btn-outline-primary" : "btn-primary") rounded-4 dashboard-create-link"
                data-section="Vozila"
                data-form-trigger="#add-vozilo-button"
                data-return-section="Dashboard">
            <i class="bi bi-plus-lg me-2"></i>@L["AdminAddVehicle"]
        </button>
    </div>
</div>

<div class="dashboard-stats-grid">
    <article class="dashboard-stat-card">
        <span class="dashboard-stat-icon stat-blue"><i class="bi bi-car-front-fill"></i></span>
        <div>
            <span>@L["Vehicles"]</span>
            <strong>@Model.BrojVozila</strong>
            <p>@L["AdminDashboardVehiclesTotal"]</p>
        </div>
    </article>

    @if (Model.IsAdministrator)
    {
        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-cyan"><i class="bi bi-people-fill"></i></span>
            <div>
                <span>@L["AdminUsersTitle"]</span>
                <strong>@Model.BrojKorisnika</strong>
                <p>@L["AdminDashboardUsersTotal"]</p>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-green"><i class="bi bi-bag-check-fill"></i></span>
            <div>
                <span>@L["DashboardOrders"]</span>
                <strong>@Model.BrojNarudzbi</strong>
                <p>@L["AdminDashboardOrdersTotal"]</p>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-emerald"><i class="bi bi-cash-stack"></i></span>
            <div>
                <span>@L["AdminDashboardRevenue"]</span>
                <strong>€@Model.UkupanPromet.ToString("N0", CultureInfo.CurrentCulture)</strong>
                <p>@L["AdminDashboardRevenueDesc"]</p>
            </div>
        </article>
    }
    else
    {
        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-green"><i class="bi bi-check-circle-fill"></i></span>
            <div>
                <span>@L["SellerDashboardAvailable"]</span>
                <strong>@Model.BrojDostupnihVozila</strong>
                <p>@L["SellerDashboardAvailableDesc"]</p>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-cyan"><i class="bi bi-bag-check-fill"></i></span>
            <div>
                <span>@L["SellerDashboardSold"]</span>
                <strong>@Model.BrojProdatihVozila</strong>
                <p>@L["SellerDashboardSoldDesc"]</p>
            </div>
        </article>

        <article class="dashboard-stat-card">
            <span class="dashboard-stat-icon stat-emerald"><i class="bi bi-headset"></i></span>
            <div>
                <span>@L["SellerDashboardMyInquiries"]</span>
                <strong>@Model.BrojMojihAktivnihUpita</strong>
                <p>@L["SellerDashboardMyInquiriesDesc"]</p>
            </div>
        </article>
    }
</div>

<div class="dashboard-content-grid">
    <section class="admin-card dashboard-panel dashboard-panel-main">
        <div class="dashboard-panel-header">
            <div>
                <h2>@L["AdminDashboardLatestPurchases"]</h2>
                <p>@L["AdminDashboardLatestPurchasesText"]</p>
            </div>
            <span class="dashboard-count-pill">@Model.ZadnjeKupovine.Count</span>
        </div>

        @if (!Model.ZadnjeKupovine.Any())
        {
            <div class="empty-state dashboard-empty-state">
                <i class="bi bi-bag"></i>
                <p>@L["AdminDashboardNoPurchases"]</p>
            </div>
        }
        else
        {
            <div class="dashboard-timeline">
                @foreach (var kupovina in Model.ZadnjeKupovine)
                {
                    var vozila = kupovina.Vozila.Any() ? string.Join(", ", kupovina.Vozila) : L["AdminDashboardVehicleUnavailable"].Value;

                    <article class="dashboard-list-item">
                        <div class="dashboard-list-icon">
                            <i class="bi bi-receipt-cutoff"></i>
                        </div>
                        <div class="dashboard-list-body">
                            <div class="dashboard-list-top">
                                <div>
                                    <h3>@L["AdminDashboardOrder"] #@kupovina.NarudzbaID</h3>
                                    <p>@FormatDate(kupovina.DatumNarudzbe) · @kupovina.Korisnik</p>
                                </div>
                                <strong class="dashboard-price">€@kupovina.UkupanIznos.ToString("N0", CultureInfo.CurrentCulture)</strong>
                            </div>
                            <div class="dashboard-list-bottom">
                                <span title="@vozila">@vozila</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="dashboard-side-stack">
        <section class="admin-card dashboard-panel">
            <div class="dashboard-panel-header">
                <div>
                    <h2>@L["AdminDashboardSupportInquiries"]</h2>
                    <p>@L[Model.IsAdministrator ? "AdminDashboardLatestInquiriesText" : "SellerDashboardLatestInquiriesText"]</p>
                </div>
                <div class="dashboard-panel-header-actions">
                    <span class="dashboard-active-inquiries-count" title="@L["AdminDashboardActiveInquiries"]">
                        @Model.BrojAktivnihUpita
                    </span>
                    <button type="button" class="btn btn-light border rounded-4 dashboard-section-link" data-section="Podrska">
                        @L["AdminDashboardOpen"]
                    </button>
                </div>
            </div>

            @if (!Model.ZadnjiUpiti.Any())
            {
                <div class="empty-state dashboard-empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>@L["AdminDashboardNoInquiries"]</p>
                </div>
            }
            else
            {
                <div class="dashboard-mini-list">
                    @foreach (var upit in Model.ZadnjiUpiti)
                    {
                        <article class="dashboard-mini-item">
                            <div>
                                <h3>@upit.Naslov</h3>
                                <p>@FormatDate(upit.DatumUpita) · @upit.KorisnikEmail</p>
                            </div>
                            <span class="support-status-badge status-@SupportStatusClass(upit.Status)">
                                @SupportStatusLabel(upit.Status)
                            </span>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="admin-card dashboard-panel">
            <div class="dashboard-panel-header">
                <div>
                    <h2>@L["Reviews"]</h2>
                    <p>@L["AdminDashboardLatestReviewsText"]</p>
                </div>
                <button type="button" class="btn btn-light border rounded-4 dashboard-section-link" data-section="Recenzije">
                    @L["AdminDashboardOpen"]
                </button>
            </div>

            @if (!Model.ZadnjeRecenzije.Any())
            {
                <div class="empty-state dashboard-empty-state">
                    <i class="bi bi-star"></i>
                    <p>@L["AdminDashboardNoReviews"]</p>
                </div>
            }
            else
            {
                <div class="dashboard-mini-list">
                    @foreach (var recenzija in Model.ZadnjeRecenzije)
                    {
                        <article class="dashboard-mini-item">
                            <div>
                                <h3>@recenzija.Vozilo</h3>
                                <p>@FormatDate(recenzija.DatumRecenzije) · @recenzija.Korisnik</p>
                            </div>
                            <span class="rating-badge">@recenzija.Ocjena <i class="bi bi-star-fill"></i></span>
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>
