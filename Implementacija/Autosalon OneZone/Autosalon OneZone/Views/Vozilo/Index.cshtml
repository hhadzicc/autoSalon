@using Autosalon_OneZone.Models.ViewModels
@using Autosalon_OneZone.Authorization

@model VehicleListingViewModel
@{
    ViewData["Title"] = L["VehiclesTitle"];
    ViewData["CompactVehicleNav"] = true;
    var currentYear = VehicleYearPolicy.MaximumYear;
    var searchTerm = Model.SearchTerm;
    var clearSearchParameters = Context.Request.Query
        .Where(parameter => !string.Equals(parameter.Key, "searchTerm", StringComparison.OrdinalIgnoreCase))
        .SelectMany(parameter => parameter.Value.Select(value =>
            new KeyValuePair<string, string?>(parameter.Key, value)));
    var clearSearchUrl = $"{Url.Action("Index", "Vozilo")}{QueryString.Create(clearSearchParameters)}";
    var selectedColors = ViewData["Boje"] as IReadOnlyCollection<TipBoje> ?? Array.Empty<TipBoje>();
    var availableColors = Enum.GetValues<TipBoje>();
    const int initiallyVisibleColorCount = 8;
    var initiallyVisibleColors = availableColors.Take(initiallyVisibleColorCount).ToHashSet();
    var showAllColors = selectedColors.Any(color => !initiallyVisibleColors.Contains(color));
    var hasActiveFilters =
        ViewData["GodisteOd"] != null ||
        ViewData["GodisteDo"] != null ||
        ViewData["Gorivo"] != null ||
        selectedColors.Count > 0 ||
        ViewData["KubikazaOd"] != null ||
        ViewData["KubikazaDo"] != null ||
        ViewData["KilometrazaOd"] != null ||
        ViewData["KilometrazaDo"] != null ||
        ViewData["CijenaOd"] != null ||
        ViewData["CijenaDo"] != null;
    var selectedFuel = Enum.TryParse<TipGoriva>(ViewData["Gorivo"]?.ToString(), out var parsedFuel)
        ? parsedFuel
        : (TipGoriva?)null;

    string FormatRange(object? from, object? to, string prefix = "", string suffix = "")
    {
        var fromText = Convert.ToString(from);
        var toText = Convert.ToString(to);

        if (!string.IsNullOrWhiteSpace(fromText) && !string.IsNullOrWhiteSpace(toText))
        {
            return $"{prefix}{fromText}–{prefix}{toText}{suffix}";
        }

        return !string.IsNullOrWhiteSpace(fromText)
            ? $"{prefix}{fromText}+{suffix}"
            : $"≤{prefix}{toText}{suffix}";
    }
}

<section class="vehicles-hero">
    <div class="container">
        <div class="vehicles-hero-grid">
            <div class="vehicles-hero-copy">
                <h1>@L["VehiclesHeroTitle"]</h1>
                <p>@L["VehiclesHeroText"]</p>
            </div>

            <div>
                <form class="vehicles-search" method="get" action="@Url.Action("Index", "Vozilo")" role="search" autocomplete="off">
                    <input type="text"
                           class="form-control animated-search-placeholder"
                           name="searchTerm"
                           autocomplete="off"
                           spellcheck="false"
                           value="@searchTerm"
                           placeholder="@L["VehiclesSearchPlaceholder"]"
                           data-animated-search-placeholder
                           data-static-placeholder="@L["VehiclesSearchPlaceholder"]"
                           data-placeholder-phrases="@L["VehicleSearchAnimatedPhrases"]"
                           aria-label="@L["VehicleSearchAria"]">
                    <button class="btn btn-primary" type="submit">
                        <svg class="oz-btn-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="11" cy="11" r="6.5"></circle>
                            <path d="m16 16 4 4"></path>
                        </svg>
                        <span>@L["CommonSearch"]</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="vehicles-listing-section">
    <div class="container">
        <div class="vehicles-market-grid">
            <aside class="vehicles-filter-panel collapse @(hasActiveFilters ? "show" : "")"
                   id="vehicleFilters"
                   data-mobile-filter-sheet
                   aria-label="@L["Filters"]">
                <div class="vehicles-filter-header">
                    <h2><i class="bi bi-sliders"></i> @L["Filters"]</h2>
                    <div class="vehicles-filter-header-actions">
                        @if (hasActiveFilters)
                        {
                            <button type="button" class="vehicles-clear-button" data-clear-filters>@L["ClearAllFilters"]</button>
                        }
                        <button type="button" class="vehicles-mobile-sheet-close" data-mobile-sheet-close aria-label="@L["Close"]">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <form id="filterForm"
                      method="get"
                      action="@Url.Action("Index", "Vozilo")"
                      novalidate
                      data-year-error="@L["FilterYearRangeError", currentYear]"
                      data-range-order-error="@L["FilterRangeOrderError"]"
                      data-non-negative-error="@L["FilterNonNegativeError"]">
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <input type="hidden" name="searchTerm" value="@searchTerm" />
                    }

                    <div class="vehicles-filter-group">
                        <label for="gorivo" class="form-label">@L["VehicleFuel"]</label>
                        <select class="form-select" id="gorivo" name="gorivo">
                            <option value="">@L["AllFuelTypes"]</option>
                            @{
                                var gorivoOptions = Enum.GetValues<TipGoriva>();
                                foreach (var option in gorivoOptions)
                                {
                                    <option value="@option" selected="@(selectedFuel == option)">@L[FuelPresentation.GetResourceKey(option)]</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="vehicles-filter-group" data-manual-filter-group>
                        <span class="vehicles-filter-label">@L["VehicleYear"]</span>
                        <div class="vehicles-range-fields">
                            <div>
                                <label for="godisteOd">@L["From"]</label>
                                <input type="number" class="form-control" placeholder="@L["From"]" id="godisteOd" name="godisteOd" min="1900" max="@currentYear" value="@ViewData["GodisteOd"]">
                            </div>
                            <div>
                                <label for="godisteDo">@L["To"]</label>
                                <input type="number" class="form-control" placeholder="@L["To"]" id="godisteDo" name="godisteDo" min="1900" max="@currentYear" value="@ViewData["GodisteDo"]">
                            </div>
                        </div>
                        <p class="vehicles-filter-error" data-filter-error>@ViewData["YearFilterError"]</p>
                        <button type="submit" class="vehicles-group-apply" data-filter-apply hidden>@L["Apply"]</button>
                    </div>

                    <div class="vehicles-filter-group" data-manual-filter-group>
                        <span class="vehicles-filter-label">@L["VehiclePrice"] (€)</span>
                        <div class="vehicles-range-fields">
                            <div>
                                <label for="cijenaOd">@L["From"]</label>
                                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" placeholder="@L["From"]" id="cijenaOd" name="cijenaOd" value="@ViewData["CijenaOd"]">
                            </div>
                            <div>
                                <label for="cijenaDo">@L["To"]</label>
                                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" placeholder="@L["To"]" id="cijenaDo" name="cijenaDo" value="@ViewData["CijenaDo"]">
                            </div>
                        </div>
                        <p class="vehicles-filter-error" data-filter-error>@ViewData["PriceFilterError"]</p>
                        <button type="submit" class="vehicles-group-apply" data-filter-apply hidden>@L["Apply"]</button>
                    </div>

                    <div class="vehicles-filter-group" data-manual-filter-group>
                        <span class="vehicles-filter-label">@L["VehicleMileage"] (km)</span>
                        <div class="vehicles-range-fields">
                            <div>
                                <label for="kilometrazaOd">@L["From"]</label>
                                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" placeholder="@L["From"]" id="kilometrazaOd" name="kilometrazaOd" value="@ViewData["KilometrazaOd"]">
                            </div>
                            <div>
                                <label for="kilometrazaDo">@L["To"]</label>
                                <input type="number" min="0" step="1" inputmode="numeric" class="form-control" placeholder="@L["To"]" id="kilometrazaDo" name="kilometrazaDo" value="@ViewData["KilometrazaDo"]">
                            </div>
                        </div>
                        <p class="vehicles-filter-error" data-filter-error>@ViewData["MileageFilterError"]</p>
                        <button type="submit" class="vehicles-group-apply" data-filter-apply hidden>@L["Apply"]</button>
                    </div>

                    <div class="vehicles-filter-group" data-manual-filter-group>
                        <span class="vehicles-filter-label">@L["VehicleDisplacement"]</span>
                        <div class="vehicles-range-fields">
                            <div>
                                <label for="kubikazaOd">@L["From"]</label>
                                <input type="number" step="0.1" min="0" class="form-control" placeholder="@L["From"]" id="kubikazaOd" name="kubikazaOd" value="@ViewData["KubikazaOd"]">
                            </div>
                            <div>
                                <label for="kubikazaDo">@L["To"]</label>
                                <input type="number" step="0.1" min="0" class="form-control" placeholder="@L["To"]" id="kubikazaDo" name="kubikazaDo" value="@ViewData["KubikazaDo"]">
                            </div>
                        </div>
                        <p class="vehicles-filter-error" data-filter-error>@ViewData["DisplacementFilterError"]</p>
                        <button type="submit" class="vehicles-group-apply" data-filter-apply hidden>@L["Apply"]</button>
                    </div>

                    <div class="vehicles-filter-group">
                        <fieldset class="vehicles-color-filter">
                            <legend class="form-label">@L["VehicleColor"]</legend>
                            <div class="vehicles-color-options @(showAllColors ? "is-expanded" : string.Empty)" data-color-options>
                                @for (var index = 0; index < availableColors.Length; index++)
                                {
                                    var color = availableColors[index];
                                    var colorId = $"boja-{color}";
                                    var additionalClass = index >= initiallyVisibleColorCount ? "is-extra" : string.Empty;
                                    <label class="vehicles-color-option @additionalClass" for="@colorId">
                                        <input type="checkbox"
                                               id="@colorId"
                                               name="boja"
                                               value="@color"
                                               checked="@selectedColors.Contains(color)" />
                                        <span class="vehicle-color-swatch @VehicleColorPresentation.GetSwatchClass(color)" aria-hidden="true"></span>
                                        <span>@L[VehicleColorPresentation.GetResourceKey(color)]</span>
                                    </label>
                                }
                            </div>
                            <button type="button"
                                    class="vehicles-color-toggle"
                                    data-color-toggle
                                    data-show-label="@L["ShowAllColors"]"
                                    data-hide-label="@L["ShowFewerColors"]"
                                    aria-expanded="@showAllColors.ToString().ToLowerInvariant()">
                                <span data-color-toggle-label>@(showAllColors ? L["ShowFewerColors"] : L["ShowAllColors"])</span>
                                <i class="bi @(showAllColors ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
                            </button>
                        </fieldset>
                    </div>

                    <div class="vehicles-mobile-filter-footer">
                        <button type="submit" class="btn btn-primary">@L["ApplyFilters"]</button>
                    </div>

                </form>
            </aside>

            <div class="vehicles-results-area">
                <div class="vehicles-results-header">
                    <div class="vehicles-results-summary">
                        <p class="results-count">
                            @if (!string.IsNullOrWhiteSpace(searchTerm))
                            {
                                @(Model.TotalCount == 1
                                    ? L["VehicleSearchFoundSingle", searchTerm]
                                    : L["VehicleSearchFoundPlural", Model.TotalCount, searchTerm])
                            }
                            else
                            {
                                @(Model.TotalCount == 1
                                    ? L["VehicleFoundSingle"]
                                    : L["VehiclesFound", Model.TotalCount])
                            }
                        </p>
                        @if (!string.IsNullOrWhiteSpace(searchTerm))
                        {
                            <a class="vehicles-clear-search" href="@clearSearchUrl">
                                @L["ClearSearch"] <i class="bi bi-x" aria-hidden="true"></i>
                            </a>
                        }
                    </div>
                    <div class="vehicles-sort-control">
                        <label for="sortOrder">@L["Sorting"]</label>
                        <select class="form-select" id="sortOrder" name="sortOrder" form="filterForm">
                            <option value="" selected="@(ViewData["CurrentSort"] == null)">@L["SortNameAsc"]</option>
                            <option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">@L["SortNameDesc"]</option>
                            <option value="price" selected="@(ViewData["CurrentSort"]?.ToString() == "price")">@L["SortPriceAsc"]</option>
                            <option value="price_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "price_desc")">@L["SortPriceDesc"]</option>
                            <option value="year" selected="@(ViewData["CurrentSort"]?.ToString() == "year")">@L["SortYearAsc"]</option>
                            <option value="year_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "year_desc")">@L["SortYearDesc"]</option>
                        </select>
                    </div>
                </div>

                @if (hasActiveFilters)
                {
                    <div class="vehicles-active-filters" aria-label="@L["ActiveFilters"]">
                        <div class="vehicles-active-filter-chips">
                        @if (selectedFuel.HasValue)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@L[FuelPresentation.GetResourceKey(selectedFuel.Value)]</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-filter="gorivo" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        @foreach (var color in selectedColors)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@L[VehicleColorPresentation.GetResourceKey(color)]</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-color="@color" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        @if (ViewData["GodisteOd"] != null || ViewData["GodisteDo"] != null)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@FormatRange(ViewData["GodisteOd"], ViewData["GodisteDo"])</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-filter="godisteOd,godisteDo" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        @if (ViewData["CijenaOd"] != null || ViewData["CijenaDo"] != null)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@FormatRange(ViewData["CijenaOd"], ViewData["CijenaDo"], "€")</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-filter="cijenaOd,cijenaDo" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        @if (ViewData["KilometrazaOd"] != null || ViewData["KilometrazaDo"] != null)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@FormatRange(ViewData["KilometrazaOd"], ViewData["KilometrazaDo"], suffix: " km")</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-filter="kilometrazaOd,kilometrazaDo" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        @if (ViewData["KubikazaOd"] != null || ViewData["KubikazaDo"] != null)
                        {
                            <span class="vehicles-filter-chip">
                                <span class="vehicles-filter-chip-label">@FormatRange(ViewData["KubikazaOd"], ViewData["KubikazaDo"])</span>
                                <button type="button" class="vehicles-filter-chip-remove" data-clear-filter="kubikazaOd,kubikazaDo" aria-label="@L["ClearFiltersShort"]">
                                    <i class="bi bi-x" aria-hidden="true"></i>
                                </button>
                            </span>
                        }
                        </div>
                        <button type="button" class="vehicles-clear-all-chips" data-clear-filters>@L["ClearFiltersShort"]</button>
                    </div>
                }

                @if (Model.Vehicles.Count == 0)
                {
                    <div class="vehicles-empty-state">
                        <i class="bi bi-search"></i>
                        <h2>@L["NoVehiclesTitle"]</h2>
                        <p>@L["NoVehiclesText"]</p>
                    </div>
                }
                else
                {
                    <div class="vehicles-cards-grid"
                         id="vehicles-cards-grid"
                         data-load-url="@Url.Action("LoadMore", "Vozilo")"
                         data-next-page="@(Model.CurrentPage + 1)"
                         data-has-more="@Model.HasMore.ToString().ToLowerInvariant()">
                        <partial name="_VehicleCards" model="Model.Vehicles" />
                    </div>

                    @if (Model.HasMore)
                    {
                        <div class="vehicles-infinite-loader" data-vehicles-loader hidden aria-live="polite">
                            <span class="visually-hidden">@L["LoadingMoreVehicles"]</span>
                            <div class="vehicles-skeleton-card" aria-hidden="true"></div>
                            <div class="vehicles-skeleton-card" aria-hidden="true"></div>
                        </div>
                        <div class="vehicles-scroll-sentinel" data-vehicles-sentinel aria-hidden="true"></div>
                    }
                }
            </div>
        </div>
    </div>
</section>

<div class="vehicles-mobile-backdrop" data-mobile-catalog-backdrop hidden></div>

<section class="vehicles-mobile-sort-sheet" data-mobile-sort-sheet aria-label="@L["Sorting"]">
    <div class="vehicles-mobile-sheet-handle" aria-hidden="true"></div>
    <div class="vehicles-mobile-sheet-heading">
        <h2>@L["Sorting"]</h2>
        <button type="button" class="vehicles-mobile-sheet-close" data-mobile-sheet-close aria-label="@L["Close"]">
            <i class="bi bi-x-lg" aria-hidden="true"></i>
        </button>
    </div>
    <div class="vehicles-mobile-sort-options">
        <div class="vehicles-mobile-sort-group">
            <h3>@L["SortNameGroup"]</h3>
            <button type="button" data-mobile-sort-value="" class="@(ViewData["CurrentSort"] == null ? "is-selected" : null)"><i class="bi bi-arrow-down" aria-hidden="true"></i><span>@L["SortNameAsc"]</span></button>
            <button type="button" data-mobile-sort-value="name_desc" class="@(ViewData["CurrentSort"]?.ToString() == "name_desc" ? "is-selected" : null)"><i class="bi bi-arrow-up" aria-hidden="true"></i><span>@L["SortNameDesc"]</span></button>
        </div>
        <div class="vehicles-mobile-sort-group">
            <h3>@L["VehiclePrice"]</h3>
            <button type="button" data-mobile-sort-value="price" class="@(ViewData["CurrentSort"]?.ToString() == "price" ? "is-selected" : null)"><i class="bi bi-arrow-down" aria-hidden="true"></i><span>@L["SortPriceAsc"]</span></button>
            <button type="button" data-mobile-sort-value="price_desc" class="@(ViewData["CurrentSort"]?.ToString() == "price_desc" ? "is-selected" : null)"><i class="bi bi-arrow-up" aria-hidden="true"></i><span>@L["SortPriceDesc"]</span></button>
        </div>
        <div class="vehicles-mobile-sort-group">
            <h3>@L["VehicleYear"]</h3>
            <button type="button" data-mobile-sort-value="year" class="@(ViewData["CurrentSort"]?.ToString() == "year" ? "is-selected" : null)"><i class="bi bi-arrow-down" aria-hidden="true"></i><span>@L["SortYearAsc"]</span></button>
            <button type="button" data-mobile-sort-value="year_desc" class="@(ViewData["CurrentSort"]?.ToString() == "year_desc" ? "is-selected" : null)"><i class="bi bi-arrow-up" aria-hidden="true"></i><span>@L["SortYearDesc"]</span></button>
        </div>
    </div>
</section>

<div class="vehicles-mobile-actions" data-mobile-catalog-actions>
    <button type="button" data-mobile-sort-open>
        <i class="bi bi-sort-down" aria-hidden="true"></i>
        <span>@L["Sorting"]</span>
    </button>
    <span aria-hidden="true"></span>
    <button type="button" data-mobile-filter-open>
        <i class="bi bi-funnel" aria-hidden="true"></i>
        <span>@L["Filters"]</span>
        @if (hasActiveFilters)
        {
            <strong>@((selectedFuel.HasValue ? 1 : 0) + selectedColors.Count +
                       (ViewData["GodisteOd"] != null || ViewData["GodisteDo"] != null ? 1 : 0) +
                       (ViewData["CijenaOd"] != null || ViewData["CijenaDo"] != null ? 1 : 0) +
                       (ViewData["KilometrazaOd"] != null || ViewData["KilometrazaDo"] != null ? 1 : 0) +
                       (ViewData["KubikazaOd"] != null || ViewData["KubikazaDo"] != null ? 1 : 0))</strong>
        }
    </button>
</div>

@section Scripts {
    <script src="~/js/components/animated-search-placeholder.js" asp-append-version="true"></script>
    @if (User.IsInRole(AppRoles.Buyer))
    {
        <script src="~/js/components/cart-actions.js" asp-append-version="true"></script>
    }
    <script src="~/js/components/vehicle-infinite-scroll.js" asp-append-version="true"></script>
    <script src="~/js/components/mobile-vehicle-catalog.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            $('[data-clear-filters]').click(function() {
                var searchTerm = '@searchTerm';

                $('#filterForm').find('input:not([name="searchTerm"])').each(function() {
                    if (this.type === 'checkbox' || this.type === 'radio') {
                        this.checked = false;
                    } else {
                        $(this).val('');
                    }
                });
                $('#filterForm').find('select:not([name="searchTerm"])').val('');
                $('#sortOrder').val('');

                if (searchTerm) {
                    $('#filterForm').find('input[name="searchTerm"]').remove();
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'searchTerm',
                        value: searchTerm
                    }).appendTo('#filterForm');
                }

                $('#filterForm').submit();
            });

            $('[data-clear-filter]').click(function() {
                var fieldNames = ($(this).attr('data-clear-filter') || '').split(',');

                fieldNames.forEach(function(fieldName) {
                    $('#filterForm').find('[name="' + fieldName + '"]').val('');
                });

                $('#filterForm').submit();
            });

            $('[data-clear-color]').click(function() {
                var color = $(this).attr('data-clear-color');
                $('#filterForm').find('input[name="boja"][value="' + color + '"]').prop('checked', false);
                $('#filterForm').submit();
            });

            $('#sortOrder').change(function() {
                $('#filterForm').submit();
            });

            $('#gorivo').change(function() {
                if (!window.matchMedia('(max-width: 720px)').matches) {
                    $('#filterForm').submit();
                }
            });

            $('.vehicles-color-option input').change(function() {
                if (!window.matchMedia('(max-width: 720px)').matches) {
                    $('#filterForm').submit();
                }
            });

            $('[data-color-toggle]').click(function() {
                var button = $(this);
                var options = button.closest('.vehicles-color-filter').find('[data-color-options]');
                var expanded = !options.hasClass('is-expanded');

                options.toggleClass('is-expanded', expanded);
                button.attr('aria-expanded', expanded);
                button.find('[data-color-toggle-label]').text(
                    expanded ? button.attr('data-hide-label') : button.attr('data-show-label')
                );
                button.find('i')
                    .toggleClass('bi-chevron-up', expanded)
                    .toggleClass('bi-chevron-down', !expanded);
            });

            $('[data-manual-filter-group] input').on('input', function() {
                var group = $(this).closest('[data-manual-filter-group]');
                group.find('[data-filter-apply]').prop('hidden', false);
                group.find('[data-filter-error]').text('');
                group.find('input').removeClass('is-invalid').removeAttr('aria-invalid');
            });

            function readNumber(id) {
                var rawValue = $('#' + id).val();
                return rawValue === '' ? null : Number(rawValue);
            }

            function setRangeError(fromId, toId, message) {
                var inputs = $('#' + fromId + ', #' + toId);
                var group = inputs.first().closest('[data-manual-filter-group]');
                inputs.addClass('is-invalid').attr('aria-invalid', 'true');
                group.find('[data-filter-error]').text(message);
                group.find('[data-filter-apply]').prop('hidden', false);
            }

            function validateNonNegativeRange(fromId, toId) {
                var fromValue = readNumber(fromId);
                var toValue = readNumber(toId);

                if ((fromValue !== null && fromValue < 0) || (toValue !== null && toValue < 0)) {
                    setRangeError(fromId, toId, $('#filterForm').data('non-negative-error'));
                    return false;
                }

                if (fromValue !== null && toValue !== null && fromValue > toValue) {
                    setRangeError(fromId, toId, $('#filterForm').data('range-order-error'));
                    return false;
                }

                return true;
            }

            $('#filterForm').on('submit', function(event) {
                var yearFrom = readNumber('godisteOd');
                var yearTo = readNumber('godisteDo');
                var yearIsValid = true;

                if ((yearFrom !== null && (!Number.isInteger(yearFrom) || yearFrom < 1900 || yearFrom > @currentYear)) ||
                    (yearTo !== null && (!Number.isInteger(yearTo) || yearTo < 1900 || yearTo > @currentYear))) {
                    setRangeError('godisteOd', 'godisteDo', $(this).data('year-error'));
                    yearIsValid = false;
                } else if (yearFrom !== null && yearTo !== null && yearFrom > yearTo) {
                    setRangeError('godisteOd', 'godisteDo', $(this).data('range-order-error'));
                    yearIsValid = false;
                }

                var rangesAreValid = [
                    validateNonNegativeRange('cijenaOd', 'cijenaDo'),
                    validateNonNegativeRange('kilometrazaOd', 'kilometrazaDo'),
                    validateNonNegativeRange('kubikazaOd', 'kubikazaDo')
                ].every(Boolean);

                if (!yearIsValid || !rangesAreValid) {
                    event.preventDefault();
                    $('.is-invalid').first().trigger('focus');
                }
            });
        });
    </script>
}
