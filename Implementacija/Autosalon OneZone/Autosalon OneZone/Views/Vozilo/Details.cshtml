@using Microsoft.AspNetCore.Identity
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager
@inject UserManager<Autosalon_OneZone.Models.ApplicationUser> UserManager

@model Autosalon_OneZone.Models.Vozilo
@{
    ViewData["Title"] = $"{Model.Marka} {Model.Model}";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var voziloNaziv = $"{Model.Marka} {Model.Model}".Trim();
    var cijena = Model.Cijena ?? 0;
    var slikaUrl = !string.IsNullOrEmpty(Model.Slika) ? Url.Content($"~/images/vozila/{Model.Slika}") : Url.Content("~/img/no-image.png");
}

<section class="inner-page-header">
    <div class="container text-center">
        <p class="section-eyebrow">Detalji vozila</p>
        <h1>@voziloNaziv</h1>
        <p>Pregledajte specifikacije, cijenu, opis i opcije kupovine za odabrano vozilo.</p>
    </div>
</section>

<section class="vehicle-details-section">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-8">
                <article class="vehicle-details-card">
                    <div class="vehicle-gallery">
                        <img src="@slikaUrl" alt="@voziloNaziv">
                    </div>

                    <div class="vehicle-details-body">
                        <div class="vehicle-title-row">
                            <div>
                                <span class="vehicle-badge">Dostupno</span>
                                <h2>@voziloNaziv</h2>
                                <p class="vehicle-subtitle">@Model.Godiste · @Model.Gorivo · @Model.Boja</p>
                            </div>

                            <div class="vehicle-price">€@cijena.ToString("N0")</div>
                        </div>

                        <div class="vehicle-actions">
                            @if (SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <form asp-controller="Korpa" asp-action="DodajUKorpu" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.VoziloID" />
                                    <button type="submit" class="btn btn-success rounded-4">
                                        <i class="bi bi-cart-plus me-2"></i>Dodaj u korpu
                                    </button>
                                </form>
                                <button type="button" class="btn btn-primary rounded-4" data-bs-toggle="modal" data-bs-target="#paymentModal">
                                    <i class="bi bi-lightning-charge-fill me-2"></i>Kupi odmah
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })" class="btn btn-primary rounded-4">
                                    <i class="bi bi-person-check me-2"></i>Prijavite se za kupovinu
                                </a>
                            }
                        </div>

                        <div class="details-block">
                            <h3>Specifikacije</h3>

                            <div class="spec-grid">
                                <div class="spec-item">
                                    <span>Godište</span>
                                    <strong>@Model.Godiste</strong>
                                </div>
                                <div class="spec-item">
                                    <span>Gorivo</span>
                                    <strong>@Model.Gorivo</strong>
                                </div>
                                <div class="spec-item">
                                    <span>Boja</span>
                                    <strong>@Model.Boja</strong>
                                </div>
                                <div class="spec-item">
                                    <span>Kubikaža</span>
                                    <strong>@Model.Kubikaza</strong>
                                </div>
                                <div class="spec-item">
                                    <span>Kilometraža</span>
                                    <strong>@Model.Kilometraza km</strong>
                                </div>
                            </div>
                        </div>

                        <div class="details-block">
                            <h3>Opis</h3>
                            <p>@(Model.Opis ?? "Nema dostupnog opisa za ovo vozilo.")</p>
                        </div>
                    </div>
                </article>

                <section class="reviews-card">
                    <div class="reviews-header">
                        <div>
                            <p class="section-eyebrow mb-1">Recenzije</p>
                            <h2>Recenzije korisnika</h2>
                        </div>
                    </div>

                    @if (Model.Recenzije != null && Model.Recenzije.Any())
                    {
                        <div class="details-review-list">
                            @foreach (var recenzija in Model.Recenzije)
                            {
                                var komentarText = recenzija.Komentar ?? "";
                                var skraceniKomentar = komentarText.Length > 120 ? komentarText.Substring(0, 120) + "..." : komentarText;

                                <article class="review-item">
                                    <div class="review-avatar">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="review-content">
                                        <div class="review-top">
                                            <strong>@recenzija.Korisnik.Ime @recenzija.Korisnik.Prezime</strong>
                                            <span>
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="bi @(i <= recenzija.Ocjena ? "bi-star-fill" : "bi-star")"></i>
                                                }
                                            </span>
                                        </div>
                                        <a href="#" class="view-komentar-recenzije" data-komentar="@System.Net.WebUtility.HtmlEncode(komentarText)">
                                            <p>@skraceniKomentar</p>
                                        </a>
                                        <small>@recenzija.DatumRecenzije.ToString("dd.MM.yyyy")</small>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-reviews">
                            <i class="bi bi-chat-square-text"></i>
                            <h3>Trenutno nema recenzija</h3>
                            @if (SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <p>Kupite ovo vozilo kako biste mogli dodati recenziju.</p>
                            }
                            else
                            {
                                <p>Prijavite se kako biste mogli kupiti i recenzirati ovo vozilo.</p>
                            }
                        </div>
                    }
                </section>
            </div>

            <div class="col-lg-4">
                <aside class="details-sidebar">
                    <div class="summary-card">
                        <h3>Pregled kupovine</h3>

                        <div class="summary-row">
                            <span>Vozilo</span>
                            <strong>@voziloNaziv</strong>
                        </div>
                        <div class="summary-row">
                            <span>Cijena</span>
                            <strong>€@cijena.ToString("N0")</strong>
                        </div>
                        <div class="summary-row">
                            <span>Status</span>
                            <strong>Dostupno</strong>
                        </div>
                    </div>

                    <div class="loan-card mt-4">
                        <div class="loan-card-header">
                            <div class="loan-icon">
                                <i class="bi bi-calculator"></i>
                            </div>
                            <div>
                                <h3>Kalkulator kredita</h3>
                                <p>Izračunajte okvirnu mjesečnu ratu.</p>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="loan-amount" class="form-label">Visina kredita (€)</label>
                            <input type="number" class="form-control" id="loan-amount" value="@cijena">
                        </div>
                        <div class="mb-3">
                            <label for="loan-period" class="form-label">Broj rata</label>
                            <select class="form-select" id="loan-period">
                                <option value="12">12 mjeseci</option>
                                <option value="24">24 mjeseca</option>
                                <option value="36" selected>36 mjeseci</option>
                                <option value="48">48 mjeseci</option>
                                <option value="60">60 mjeseci</option>
                                <option value="72">72 mjeseca</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="interest-rate" class="form-label">Kamatna stopa (%)</label>
                            <input type="number" class="form-control" id="interest-rate" value="5.0" step="0.1" min="0">
                        </div>
                        <button id="calculateBtn" class="btn btn-primary rounded-4 w-100">Izračunaj</button>

                        <div class="loan-result">
                            <span>Mjesečna rata</span>
                            <strong id="loan-result">€0</strong>
                        </div>

                        <p class="loan-note">* Kalkulator je informativnog karaktera i ne predstavlja ponudu za kredit.</p>
                    </div>
                </aside>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="komentarRecenzijeModal" tabindex="-1" aria-labelledby="komentarRecenzijeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-chat-square-text-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="komentarRecenzijeModalLabel">Komentar recenzije</h5>
                        <p class="mb-0 text-muted small">Pregled punog komentara korisnika.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="review-comment-box" id="komentarRecenzijeModalText"></div>
            </div>
            <div class="modal-footer modern-modal-footer">
                <button type="button" class="btn btn-light border rounded-4" data-bs-dismiss="modal">Zatvori</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header modern-modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon">
                        <i class="bi bi-credit-card-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="paymentModalLabel">Podaci za plaćanje - @voziloNaziv</h5>
                        <p class="mb-0 text-muted small">Unesite podatke kartice za završetak kupovine.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="alert alert-info mb-4">
                    <strong>Ukupno za plaćanje:</strong> €@cijena.ToString("N0")
                </div>

                <form id="paymentForm" asp-controller="Korpa" asp-action="IzvrsiPlacanje" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="VoziloID" value="@Model.VoziloID" />

                    <div class="form-group mb-3">
                        <label for="imeVlasnika" class="form-label">Ime i prezime vlasnika kartice <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="imeVlasnika" name="ImeVlasnika"
                               required maxlength="100" autocomplete="off">
                        <div class="error-message text-danger mt-1" id="imeVlasnikaError"></div>
                    </div>

                    <div class="form-group mb-3">
                        <label for="brojKartice" class="form-label">Broj kartice <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brojKartice" name="BrojKartice"
                               required placeholder="XXXX XXXX XXXX XXXX" autocomplete="off">
                        <div class="error-message text-danger mt-1" id="brojKarticeError"></div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="datumIsteka" class="form-label">Datum isteka <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="datumIsteka" name="DatumIsteka"
                                       required placeholder="MM/YY" autocomplete="off">
                                <div class="error-message text-danger mt-1" id="datumIstekaError"></div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label for="cvv" class="form-label">CVV kod <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="cvv" name="Cvv"
                                       required placeholder="XXX" autocomplete="off">
                                <div class="error-message text-danger mt-1" id="cvvError"></div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-primary" id="submitPayment">
                            Potvrdi kupovinu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        $(document).ready(function() {

            updateCalculation();

            $("#calculateBtn").click(function() {
                updateCalculation();
            });

            $("#loan-amount, #loan-period, #interest-rate").on('change input', function() {
                updateCalculation();
            });

            function updateCalculation() {
                var loanAmount = parseFloat($("#loan-amount").val());
                var loanPeriod = parseInt($("#loan-period").val());
                var interestRate = parseFloat($("#interest-rate").val());

                if (isNaN(loanAmount) || loanAmount <= 0 ||
                    isNaN(loanPeriod) || loanPeriod <= 0 ||
                    isNaN(interestRate) || interestRate < 0) {
                    $("#loan-result").text("€0");
                    return;
                }

                var monthlyRate = (interestRate / 100) / 12;

                var monthlyPayment = loanAmount * monthlyRate * Math.pow(1 + monthlyRate, loanPeriod) /
                                    (Math.pow(1 + monthlyRate, loanPeriod) - 1);

                $("#loan-result").text("€" + monthlyPayment.toFixed(2));
            }

            setupPaymentFormValidation();

            $(".view-komentar-recenzije").on("click", function(e) {
                e.preventDefault();
                const komentar = $(this).data("komentar");
                $("#komentarRecenzijeModalText").text(komentar);
                $("#komentarRecenzijeModal").modal("show");
            });
        });

        function setupPaymentFormValidation() {

            clearAllErrors();

            $('#paymentModal').on('show.bs.modal', function() {
                resetPaymentForm();
            });

            $("#imeVlasnika").on('input', function() {
                var value = $(this).val();
                var filteredValue = value.replace(/[^A-Za-z ]/g, '');

                if (value !== filteredValue) {
                    $(this).val(filteredValue);
                }

                clearError('imeVlasnika');
            });

            $("#brojKartice").on('input', function() {
                var value = $(this).val().replace(/\D/g, '');

                if (value.length > 16) {
                    value = value.substring(0, 16);
                }

                var formattedValue = '';
                for (var i = 0; i < value.length; i++) {
                    if (i > 0 && i % 4 === 0) {
                        formattedValue += ' ';
                    }
                    formattedValue += value[i];
                }

                $(this).val(formattedValue);
                clearError('brojKartice');
            });

            $("#datumIsteka").on('input', function() {
                var value = $(this).val().replace(/\D/g, '');

                if (value.length > 4) {
                    value = value.substring(0, 4);
                }

                if (value.length > 2) {
                    value = value.substring(0, 2) + '/' + value.substring(2);
                }

                $(this).val(value);
                clearError('datumIsteka');
            });

            $("#cvv").on('input', function() {
                var value = $(this).val().replace(/\D/g, '');

                if (value.length > 3) {
                    value = value.substring(0, 3);
                }

                $(this).val(value);
                clearError('cvv');
            });

            $("#paymentForm").on('submit', function(e) {
                e.preventDefault();

                clearAllErrors();

                var isValid = validatePaymentForm();

                if (isValid) {

                    $("#submitPayment").prop("disabled", true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Obrađivanje...');

                    var formData = $(this).serialize();

                    $.ajax({
                        url: $(this).attr('action'),
                        type: 'POST',
                        data: formData,
                        success: function(response) {
                            if (response.success) {

                                window.location.href = response.redirectUrl;
                            } else {

                                if (response.errors) {

                                    $.each(response.errors, function(field, message) {
                                        showError(field, message);
                                    });
                                } else if (response.message) {

                                    $('#paymentModal').modal('hide');
                                    window.showAppFlashMessage("Plaćanje nije uspjelo: " + response.message, "error");
                                }

                                $("#submitPayment").prop("disabled", false).html('Potvrdi kupovinu');
                            }
                        },
                        error: function(xhr, status, error) {

                            $('#paymentModal').modal('hide');
                            window.showAppFlashMessage("Došlo je do greške prilikom obrade zahtjeva. Molimo pokušajte ponovo.", "error");
                            $("#submitPayment").prop("disabled", false).html('Potvrdi kupovinu');
                        }
                    });
                }
            });
        }

        function validatePaymentForm() {
            var isValid = true;

            var imePrezime = $("#imeVlasnika").val().trim();
            if (!imePrezime) {
                showError('imeVlasnika', 'Ime i prezime su obavezni.');
                isValid = false;
            } else if (!imePrezime.includes(' ')) {
                showError('imeVlasnika', 'Unesite ime i prezime (mora sadržavati razmak).');
                isValid = false;
            }

            var brojKartice = $("#brojKartice").val().replace(/\s+/g, '');
            if (!brojKartice) {
                showError('brojKartice', 'Broj kartice je obavezan.');
                isValid = false;
            } else if (brojKartice.length !== 16) {
                showError('brojKartice', 'Broj kartice mora sadržavati tačno 16 cifara.');
                isValid = false;
            }

            var datumIsteka = $("#datumIsteka").val().trim();
            if (!datumIsteka) {
                showError('datumIsteka', 'Datum isteka je obavezan.');
                isValid = false;
            } else {
                var parts = datumIsteka.split('/');
                if (parts.length !== 2 || !/^(0[1-9]|1[0-2])$/.test(parts[0]) || !/^\d{2}$/.test(parts[1])) {
                    showError('datumIsteka', 'Neispravan format (MM/YY).');
                    isValid = false;
                } else {
                    var month = parseInt(parts[0]);
                    var year = parseInt("20" + parts[1]);
                    var now = new Date();
                    var currentYear = now.getFullYear();
                    var currentMonth = now.getMonth() + 1;

                    if (year < currentYear || (year === currentYear && month < currentMonth)) {
                        showError('datumIsteka', 'Kartica je istekla.');
                        isValid = false;
                    }
                }
            }

            var cvv = $("#cvv").val().trim();
            if (!cvv) {
                showError('cvv', 'CVV kod je obavezan.');
                isValid = false;
            } else if (cvv.length !== 3) {
                showError('cvv', 'CVV kod mora sadržavati tačno 3 cifre.');
                isValid = false;
            }

            if (!isValid) {
                $(".form-control").each(function() {
                    var id = $(this).attr("id");
                    if ($("#" + id + "Error").text()) {
                        $(this).focus();
                        return false;
                    }
                });
            }

            return isValid;
        }

        function showError(fieldId, message) {
            $("#" + fieldId).addClass("is-invalid border-danger");
            $("#" + fieldId + "Error").text(message);
        }

        function clearError(fieldId) {
            $("#" + fieldId).removeClass("is-invalid border-danger");
            $("#" + fieldId + "Error").text("");
        }

        function clearAllErrors() {
            $(".form-control").removeClass("is-invalid border-danger");
            $(".error-message").text("");
        }

        function resetPaymentForm() {
            $("#paymentForm")[0].reset();
            clearAllErrors();
            $("#submitPayment").prop("disabled", false).html('Potvrdi kupovinu');
        }
    </script>

    <style>

        .form-control.is-invalid {
            background-image: none;
        }

        .error-message {
            font-size: 0.875rem;
            min-height: 20px;
        }

        .border-danger {
            border: 2px solid #dc3545 !important;
        }

        .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        ::placeholder {
            opacity: 0.6;
        }

        .reviews-container {
            max-height: 600px;
            overflow-y: auto;
            padding-left: 25px;
            width: 300px;
            margin: 0 auto;
        }

        .bi-star-fill.text-warning {
            color: #ffc107 !important;
        }

        .bi-star {
            color: #ccc;
        }

        .card-header {
            background-color: rgba(0, 0, 0, 0.03);
        }

        .reviews-container::-webkit-scrollbar {
            width: 8px;
        }

        .reviews-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 4px;
        }

        .reviews-container::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

            .reviews-container::-webkit-scrollbar-thumb:hover {
                background: #aaa;
            }

        .truncated-text {
            cursor: pointer;
        }

        .view-komentar-recenzije {
            color: inherit;
            text-decoration: none;
            display: block;
        }

            .view-komentar-recenzije:hover {
                text-decoration: none;
            }

                .view-komentar-recenzije:hover p {
                    color: #007bff;
                }
    </style>
}
