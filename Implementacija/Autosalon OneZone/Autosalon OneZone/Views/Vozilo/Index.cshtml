@using Microsoft.AspNetCore.Identity
@using System.Globalization
@inject SignInManager<Autosalon_OneZone.Models.ApplicationUser> SignInManager
@inject UserManager<Autosalon_OneZone.Models.ApplicationUser> UserManager

@model IEnumerable<Autosalon_OneZone.Models.Vozilo>
@{
    ViewData["Title"] = "Vozila";
    var currentYear = DateTime.Now.Year;
    var culture = CultureInfo.GetCultureInfo("bs-BA");
    var searchTerm = ViewData["SearchTerm"]?.ToString();
    var hasActiveFilters =
        ViewData["GodisteOd"] != null ||
        ViewData["GodisteDo"] != null ||
        ViewData["Gorivo"] != null ||
        ViewData["Boja"] != null ||
        ViewData["KubikazaOd"] != null ||
        ViewData["KubikazaDo"] != null ||
        ViewData["KilometrazaOd"] != null ||
        ViewData["KilometrazaDo"] != null ||
        ViewData["CijenaOd"] != null ||
        ViewData["CijenaDo"] != null;
}

<section class="vehicles-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="section-eyebrow">Pregled vozila</p>
                <h1>Pronađite vozilo koje vam odgovara.</h1>
                <p>Pretražite ponudu prema marki, modelu, cijeni, gorivu, kilometraži i godištu.</p>
            </div>

            <div class="col-lg-5">
                <form class="vehicles-search" method="get" action="@Url.Action("Index", "Vozilo")" role="search">
                    <input type="text" class="form-control" name="searchTerm" value="@searchTerm" placeholder="Pretraži marku ili model..." aria-label="Pretraži vozila">
                    <button class="btn btn-primary" type="submit">Pretraži</button>
                </form>
            </div>
        </div>
    </div>
</section>

<section class="vehicles-listing-section">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <div class="alert alert-info vehicles-search-alert">
                Rezultati pretrage za: <strong>@searchTerm</strong>
            </div>
        }

        <div class="filters-card">
            <div class="d-flex justify-content-between align-items-center gap-3 mb-3 flex-wrap">
                <div>
                    <h2 class="mb-1">Filteri i sortiranje</h2>
                    <p class="text-secondary mb-0">Suzi ponudu prema najvažnijim karakteristikama vozila.</p>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="@(hasActiveFilters.ToString().ToLowerInvariant())" aria-controls="filterCollapse">
                    <i class="bi bi-funnel"></i> Prikaži/sakrij filtere
                </button>
            </div>

            <div class="collapse @(hasActiveFilters ? "show" : "")" id="filterCollapse">
                <form id="filterForm" method="get" action="@Url.Action("Index", "Vozilo")">
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <input type="hidden" name="searchTerm" value="@searchTerm" />
                    }

                    <div class="row g-3">
                        <div class="col-md-6 col-lg-4">
                            <label for="sortOrder" class="form-label">Sortiranje</label>
                            <select class="form-select" id="sortOrder" name="sortOrder">
                                <option value="" selected="@(ViewData["CurrentSort"] == null)">Naziv (A-Z)</option>
                                <option value="name_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "name_desc")">Naziv (Z-A)</option>
                                <option value="price" selected="@(ViewData["CurrentSort"]?.ToString() == "price")">Cijena (rastuće)</option>
                                <option value="price_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "price_desc")">Cijena (opadajuće)</option>
                                <option value="year" selected="@(ViewData["CurrentSort"]?.ToString() == "year")">Godište (starije prvo)</option>
                                <option value="year_desc" selected="@(ViewData["CurrentSort"]?.ToString() == "year_desc")">Godište (novije prvo)</option>
                            </select>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <label for="gorivo" class="form-label">Gorivo</label>
                            <select class="form-select" id="gorivo" name="gorivo">
                                <option value="">Sva goriva</option>
                                @{
                                    var gorivoOptions = new[] { "Benzin", "Dizel", "Plin", "Elektro", "Hibrid" };
                                    foreach (var option in gorivoOptions)
                                    {
                                        <option value="@option" selected="@(ViewData["Gorivo"]?.ToString() == option)">@option</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="col-md-6 col-lg-4">
                            <label for="boja" class="form-label">Boja</label>
                            <input type="text" class="form-control" id="boja" name="boja" placeholder="Unesite boju" value="@ViewData["Boja"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="godisteOd" class="form-label">Godište od</label>
                            <input type="number" class="form-control" placeholder="Od" id="godisteOd" name="godisteOd" min="1900" max="@currentYear" value="@ViewData["GodisteOd"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="godisteDo" class="form-label">Godište do</label>
                            <input type="number" class="form-control" placeholder="Do" id="godisteDo" name="godisteDo" min="1900" max="@currentYear" value="@ViewData["GodisteDo"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="cijenaOd" class="form-label">Cijena od (€)</label>
                            <input type="number" min="0" class="form-control" placeholder="Od" id="cijenaOd" name="cijenaOd" value="@ViewData["CijenaOd"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="cijenaDo" class="form-label">Cijena do (€)</label>
                            <input type="number" min="0" class="form-control" placeholder="Do" id="cijenaDo" name="cijenaDo" value="@ViewData["CijenaDo"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="kubikazaOd" class="form-label">Kubikaža od</label>
                            <input type="number" step="0.1" min="0" class="form-control" placeholder="Od" id="kubikazaOd" name="kubikazaOd" value="@ViewData["KubikazaOd"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="kubikazaDo" class="form-label">Kubikaža do</label>
                            <input type="number" step="0.1" min="0" class="form-control" placeholder="Do" id="kubikazaDo" name="kubikazaDo" value="@ViewData["KubikazaDo"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="kilometrazaOd" class="form-label">Kilometraža od</label>
                            <input type="number" min="0" class="form-control" placeholder="Od" id="kilometrazaOd" name="kilometrazaOd" value="@ViewData["KilometrazaOd"]">
                        </div>

                        <div class="col-md-6 col-lg-3">
                            <label for="kilometrazaDo" class="form-label">Kilometraža do</label>
                            <input type="number" min="0" class="form-control" placeholder="Do" id="kilometrazaDo" name="kilometrazaDo" value="@ViewData["KilometrazaDo"]">
                        </div>
                    </div>

                    <div class="filters-actions">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-funnel-fill"></i> Primijeni filtere
                        </button>
                        <button type="button" id="clearAllFilters" class="btn btn-outline-danger">
                            Očisti sve filtere
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="vehicles-results-header">
            <p class="results-count mb-0">Pronađeno @Model.Count() vozila</p>
        </div>

        @if (!Model.Any())
        {
            <div class="vehicles-empty-state">
                <i class="bi bi-search"></i>
                <h2>Nema vozila za prikaz</h2>
                <p>Promijenite pojam pretrage ili očistite filtere pa pokušajte ponovo.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var vozilo in Model)
                {
                    var imageUrl = !string.IsNullOrWhiteSpace(vozilo.Slika)
                        ? Url.Content($"~/images/vozila/{vozilo.Slika}")
                        : Url.Content("~/img/no-image.png");
                    var priceText = vozilo.Cijena.HasValue
                        ? $"€{vozilo.Cijena.Value.ToString("N0", culture)}"
                        : "Cijena na upit";
                    var mileageText = vozilo.Kilometraza.HasValue
                        ? $"{vozilo.Kilometraza.Value.ToString("N0", culture)} km"
                        : "Kilometraža nije unesena";

                    <div class="col-md-6 col-xl-4">
                        <article class="vehicles-card h-100">
                            <a href="@Url.Action("Details", "Vozilo", new { id = vozilo.VoziloID })" class="vehicles-card-image-link">
                                <img src="@imageUrl" class="vehicles-card-image" alt="@vozilo.Marka @vozilo.Model">
                            </a>

                            <div class="vehicles-card-body">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                                    <h2 class="vehicles-card-title">@vozilo.Marka @vozilo.Model</h2>
                                    <span class="vehicles-card-tag">@vozilo.Gorivo</span>
                                </div>

                                <p class="vehicles-card-meta">@vozilo.Godiste · @vozilo.Boja · @mileageText</p>

                                <dl class="vehicles-spec-grid">
                                    <div>
                                        <dt>Kubikaža</dt>
                                        <dd>@vozilo.Kubikaza</dd>
                                    </div>
                                    <div>
                                        <dt>Gorivo</dt>
                                        <dd>@vozilo.Gorivo</dd>
                                    </div>
                                </dl>

                                <div class="vehicles-card-footer">
                                    <span class="vehicles-card-price">@priceText</span>
                                    <div class="vehicles-card-actions">
                                        <a href="@Url.Action("Details", "Vozilo", new { id = vozilo.VoziloID })" class="btn btn-primary">Detalji</a>

                                        @if (SignInManager.IsSignedIn(User) && User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <form asp-controller="Korpa" asp-action="DodajUKorpu" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@vozilo.VoziloID" />
                                                <button type="submit" class="btn btn-outline-primary">Dodaj u korpu</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Login", "Account", new { returnUrl = Context.Request.Path })" class="btn btn-outline-primary">Prijava za kupovinu</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function clearFilter(...fields) {
            fields.forEach(field => {
                const element = document.getElementById(field);
                if (element) {
                    element.value = '';
                }
            });
        }

        $(document).ready(function() {
            $('#clearAllFilters').click(function() {
                var searchTerm = '@searchTerm';

                $('#filterForm').find('input:not([name="searchTerm"])').val('');
                $('#filterForm').find('select:not([name="searchTerm"])').val('');
                $('#sortOrder').val('');

                if (searchTerm) {
                    $('#filterForm').find('input[name="searchTerm"]').remove();
                    $('<input>').attr({
                        type: 'hidden',
                        name: 'searchTerm',
                        value: searchTerm
                    }).appendTo('#filterForm');
                }

                $('#filterForm').submit();
            });

            $('#sortOrder').change(function() {
                $('#filterForm').submit();
            });

            $('#godisteOd, #godisteDo').on('change', function() {
                var min = 1900;
                var max = @currentYear;
                var val = $(this).val() ? parseInt($(this).val()) : '';

                if (val !== '') {
                    if (val < min) {
                        $(this).val(min);
                    } else if (val > max) {
                        $(this).val(max);
                    }

                    if (this.id === 'godisteOd' && $('#godisteDo').val()) {
                        var doVal = parseInt($('#godisteDo').val());
                        if (val > doVal) {
                            $('#godisteDo').val(val);
                        }
                    }
                    else if (this.id === 'godisteDo' && $('#godisteOd').val()) {
                        var odVal = parseInt($('#godisteOd').val());
                        if (val < odVal) {
                            $('#godisteOd').val(val);
                        }
                    }
                }
            });

            function validateRange(odId, doId) {
                var odVal = $('#' + odId).val() ? parseFloat($('#' + odId).val()) : '';
                var doVal = $('#' + doId).val() ? parseFloat($('#' + doId).val()) : '';

                if (odVal !== '' && doVal !== '' && odVal > doVal) {
                    $('#' + doId).val(odVal);
                }
            }

            $('#kubikazaOd, #kubikazaDo').on('change', function() {
                validateRange('kubikazaOd', 'kubikazaDo');
            });

            $('#kilometrazaOd, #kilometrazaDo').on('change', function() {
                validateRange('kilometrazaOd', 'kilometrazaDo');
            });

            $('#cijenaOd, #cijenaDo').on('change', function() {
                validateRange('cijenaOd', 'cijenaDo');
            });
        });
    </script>
}
