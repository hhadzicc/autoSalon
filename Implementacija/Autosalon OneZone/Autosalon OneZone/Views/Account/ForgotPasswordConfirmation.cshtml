@{
    ViewData["Title"] = "Provjerite email";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="inner-page-header">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <p class="section-eyebrow">Sigurnost naloga</p>
                <h1>Provjerite email</h1>
                <p>Ako nalog sa unesenom adresom postoji, poslali smo link za resetovanje lozinke.</p>
            </div>
        </div>
    </div>
</section>

<section class="auth-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-8">
                <div class="modern-form-card text-center">
                    <div class="form-icon mx-auto">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h2>Link je poslan</h2>
                    <p class="text-muted mb-4">
                        Link vrijedi 30 minuta. Ako ne vidite poruku, provjerite spam folder ili zatražite novi link.
                    </p>
                    <div class="d-grid gap-3">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg rounded-4">Nazad na prijavu</a>
                        <a asp-controller="Account" asp-action="ForgotPassword" class="btn btn-light border btn-lg rounded-4">Zatraži novi link</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
