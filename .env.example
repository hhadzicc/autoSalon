# Local demo values for Docker Compose.
# These values are safe to commit because they only protect the local database
# created on the machine that runs the demo.

MSSQL_SA_PASSWORD=AutoSalon_Demo123!

DEMO_ADMIN_EMAIL=admin@autosalon.local
DEMO_ADMIN_PASSWORD=Admin123!
DEMO_ADMIN_FIRST_NAME=Demo
DEMO_ADMIN_LAST_NAME=Admin

DEMO_BUYER_EMAIL=kupac@autosalon.local
DEMO_BUYER_PASSWORD=Kupac123!

DEMO_SELLER_EMAIL=prodavac@autosalon.local
DEMO_SELLER_PASSWORD=Prodavac123!

# Public demo safety. Reset stays disabled unless both switches are explicitly
# enabled. The reset interval cannot be shorter than five minutes.
DEMO_MODE=TRUE
DEMO_RESET_ENABLED=TRUE
DEMO_RESET_INTERVAL_MINUTES=60

# Optional real Stripe test keys for private local testing.
# The Docker demo uses mock payments by default.
STRIPE_USE_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Optional password reset email provider. Delivery remains off unless explicitly
# enabled. Reset links and tokens are never written to logs.
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
FROM_EMAIL=

# Optional localhost port for the default docker-compose.yml.
APP_HTTP_PORT=8080
SEQ_HTTP_PORT=5341

# Optional prebuilt image. Local development can leave this unset and use
# 'docker compose up --build'. CI/CD sets an immutable sha-<commit> image.
WEB_IMAGE=ghcr.io/hhadzicc/autosalon:latest

# Production tunnel/reverse-proxy settings. The fixed subnet makes the Docker
# host gateway predictable; trust only that gateway for forwarded headers.
APP_NETWORK_SUBNET=172.30.250.0/24
REVERSE_PROXY_KNOWN_PROXY=172.30.250.1

# Private structured log viewer. Generate a hash for a unique password and put
# only the resulting hash here. Keep the original password in a password manager:
# 'your-password' | docker run --rm -i datalust/seq:latest config hash
SEQ_ADMIN_PASSWORD_HASH=

# Development keeps the zero-configuration portfolio demo fully functional.
# Use Production and replace all demo passwords before public deployment.
ASPNETCORE_ENVIRONMENT=Development

# Standalone Caddy deployment only. docker-compose.standalone.yml requires a real
# domain and non-demo passwords in a private .env before it will start.
# Point this domain's DNS records to the VPS.
APP_DOMAIN=autosalon.example.com
STANDALONE_NETWORK_SUBNET=172.30.251.0/24
STANDALONE_PROXY_IP=172.30.251.10
