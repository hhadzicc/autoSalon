@model Autosalon_OneZone.ViewModels.Admin.ProfilListViewModel

@Html.AntiForgeryToken()

<div class="admin-page-header">
    <div>
        <p class="admin-eyebrow">Admin panel</p>
        <h1>Korisnici</h1>
    </div>
</div>

<div id="add-profil-form-container" class="admin-form-card" style="display: none;">
    <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
        <div>
            <p class="admin-eyebrow mb-1">Korisnik</p>
            <h2 id="add-edit-profil-form-title" class="mb-0">Dodaj novog korisnika</h2>
        </div>
    </div>
    <div id="add-profil-form-placeholder"></div>
</div>

<div class="admin-card" id="profili-list-container">
    <div class="admin-toolbar admin-toolbar-stacked">
        <div>
            <h2>Lista korisnika</h2>
            <span>Pretražite korisnike po imenu, korisničkom imenu ili email adresi.</span>
        </div>

        <div class="admin-users-toolbar">
            <button id="add-profil-button" class="btn btn-primary rounded-4 add-admin-btn" type="button">
                <i class="bi bi-person-plus-fill me-2"></i>Dodaj novog korisnika
            </button>

            <div class="role-filter-chips" aria-label="Filter korisnika po ulozi">
                <button type="button" class="role-chip active" data-role-filter="all">Svi</button>
                <button type="button" class="role-chip" data-role-filter="Administrator">Admini</button>
                <button type="button" class="role-chip" data-role-filter="Prodavac">Prodavci</button>
                <button type="button" class="role-chip" data-role-filter="Kupac">Kupci</button>
            </div>

            <div class="admin-search-compact">
                <input type="text" id="profil-search-input" class="form-control" placeholder="Pretraži po imenu ili email-u..." value="@Model.SearchQuery" />
                <button id="profil-search-button" class="search-submit-btn" type="button" aria-label="Pretraži korisnike">
                    <i class="bi bi-search"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive admin-table-wrapper">
        <table class="table admin-table align-middle mb-0">
            <thead>
                <tr>
                    <th>Korisničko ime</th>
                    <th>Email</th>
                    <th>Ime</th>
                    <th>Prezime</th>
                    <th>Uloga</th>
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody id="profili-table-body">
                <tr>
                    <td colspan="6">Učitavanje korisnika...</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div id="profili-mobile-list" class="admin-mobile-list"></div>
    <div id="profil-pagination-controls"></div>
</div>

<script>
    $(document).ready(function () {
        $(document).off('click', '.edit-profil-button');
        $(document).off('click', '#add-profil-button');
        $(document).off('click', '#profil-search-button');
        $(document).off('click', '#cancel-add-profil');
        $(document).off('submit', '#add-profil-form');
        $(document).off('click', '.role-chip');
        $(document).off('app:delete-confirmed', '.delete-profil-button');

        const profiliTableBody = $('#profili-table-body');
        const profiliMobileList = $('#profili-mobile-list');
        const searchInput = $('#profil-search-input');
        const searchButton = $('#profil-search-button');
        const addFormContainer = $('#add-profil-form-container');
        const addFormPlaceholder = $('#add-profil-form-placeholder');
        const addFormTitle = $('#add-edit-profil-form-title');

        function escapeHtml(value) {
            return $('<div>').text(value ?? '').html();
        }

        function escapeAttribute(value) {
            return escapeHtml(value).replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function emailLink(value) {
            const email = value || 'N/A';
            const safeEmail = escapeHtml(email);
            const safeAttr = escapeAttribute(email);

            if (!value) {
                return '<span class="admin-email-link is-empty">N/A</span>';
            }

            return '<a class="admin-email-link" href="mailto:' + safeAttr + '" title="' + safeAttr + '">' + safeEmail + '</a>';
        }

        let currentRoleFilter = 'all';

        function profileActions(id, itemName) {
            return '<div class="table-actions">' +
                '<button class="edit-profil-button btn btn-sm btn-outline-primary rounded-3" data-id="' + escapeHtml(id) + '"><i class="bi bi-pencil-square me-1"></i>Izmijeni</button>' +
                '<button class="delete-profil-button btn btn-sm btn-outline-danger rounded-3" data-id="' + escapeAttribute(id) + '" data-confirm-delete="true" data-confirm-title="Obrisati korisnika?" data-confirm-message="Da li ste sigurni da želite obrisati ovog korisnika?" data-confirm-item="' + escapeAttribute(itemName) + '" data-confirm-action="Da, obriši korisnika"><i class="bi bi-trash me-1"></i>Obriši</button>' +
                '</div>';
        }

        function renderProfiles(profili) {
            profiliTableBody.empty();
            profiliMobileList.empty();

            if (!profili || profili.length === 0) {
                profiliTableBody.html('<tr><td colspan="6"><div class="empty-state"><i class="bi bi-people"></i><p>Nema dostupnih korisnika.</p></div></td></tr>');
                profiliMobileList.html('<div class="empty-state"><i class="bi bi-people"></i><p>Nema dostupnih korisnika.</p></div>');
                return;
            }

            $.each(profili, function (_, profil) {
                const id = profil.id || '';
                const rawUserName = profil.userName || 'N/A';
                const rawEmail = profil.email || '';
                const userName = escapeHtml(rawUserName);
                const email = emailLink(rawEmail);
                const ime = escapeHtml(profil.ime || '');
                const prezime = escapeHtml(profil.prezime || '');
                const uloga = escapeHtml(profil.uloga || 'N/A');
                const actions = profileActions(id, profil.userName || profil.email || 'Korisnik');

                profiliTableBody.append(
                    '<tr>' +
                        '<td><div class="user-cell" title="' + escapeAttribute(rawUserName) + '"><span class="user-avatar"><i class="bi bi-person-fill"></i></span><strong>' + userName + '</strong></div></td>' +
                        '<td>' + email + '</td>' +
                        '<td>' + ime + '</td>' +
                        '<td>' + prezime + '</td>' +
                        '<td><span class="admin-badge">' + uloga + '</span></td>' +
                        '<td>' + actions + '</td>' +
                    '</tr>'
                );

                profiliMobileList.append(
                    '<article class="admin-review-card">' +
                        '<div class="d-flex justify-content-between gap-3 align-items-start">' +
                            '<div class="min-w-0"><span class="admin-badge">' + uloga + '</span><h3 title="' + escapeAttribute(rawUserName) + '">' + userName + '</h3></div>' +
                        '</div>' +
                        '<div class="review-mobile-meta">' +
                            '<div><span>Email</span><strong>' + email + '</strong></div>' +
                            '<div><span>Ime i prezime</span><strong>' + ime + ' ' + prezime + '</strong></div>' +
                        '</div>' +
                        '<div class="mobile-actions">' + actions + '</div>' +
                    '</article>'
                );
            });
        }

        function loadProfiliList(searchQuery = '', page = 1, roleFilter = currentRoleFilter) {
            profiliTableBody.html('<tr><td colspan="6">Učitavanje korisnika...</td></tr>');
            profiliMobileList.html('<div class="empty-state"><i class="bi bi-hourglass-split"></i><p>Učitavanje korisnika...</p></div>');

            $.get('@Url.Action("GetProfiliJson", "AdminPanel")', { searchQuery: searchQuery, page: page, roleFilter: roleFilter }, function (data) {
                renderProfiles(data && data.profili ? data.profili : []);
            }).fail(function (jqXHR, textStatus, errorThrown) {
                const message = escapeHtml(jqXHR.responseText || errorThrown || 'Greška');
                profiliTableBody.html('<tr><td colspan="6"><div class="alert alert-danger mb-0">Greška prilikom učitavanja korisnika: ' + message + '</div></td></tr>');
                profiliMobileList.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja korisnika: ' + message + '</div>');
            });
        }

        loadProfiliList(searchInput.val() || '@Model.SearchQuery');

        searchButton.on('click', function () {
            loadProfiliList(searchInput.val(), 1, currentRoleFilter);
        });

        searchInput.on('keypress', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                searchButton.click();
            }
        });

        $(document).off('click.adminProfiliRole', '.role-chip').on('click.adminProfiliRole', '.role-chip', function () {
            currentRoleFilter = $(this).data('role-filter') || 'all';
            $('.role-chip').removeClass('active');
            $(this).addClass('active');
            loadProfiliList(searchInput.val(), 1, currentRoleFilter);
        });

        $('#add-profil-button').on('click', function () {
            addFormTitle.text('Dodaj novog korisnika');
            $.get('@Url.Action("GetAddProfilForm", "AdminPanel")', function (data) {
                addFormPlaceholder.html(data);
                addFormContainer.show();
                const form = addFormPlaceholder.find('form');
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            }).fail(function () {
                addFormPlaceholder.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja forme za dodavanje.</div>');
                addFormContainer.show();
            });
        });

        $(document).off('click.adminProfiliEdit', '.edit-profil-button').on('click.adminProfiliEdit', '.edit-profil-button', function () {
            const profilId = $(this).data('id');
            addFormTitle.text('Izmijeni korisnika');

            $.get('@Url.Action("GetEditProfilForm", "AdminPanel")', { id: profilId }, function (data) {
                addFormPlaceholder.html(data);
                addFormContainer.show();
                const form = addFormPlaceholder.find('form');
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse(form);
            }).fail(function () {
                addFormPlaceholder.html('<div class="alert alert-danger mb-0">Greška prilikom učitavanja forme za izmjenu.</div>');
                addFormContainer.show();
            });
        });

        $(document).off('click.adminProfiliCancel', '#cancel-add-profil').on('click.adminProfiliCancel', '#cancel-add-profil', function () {
            addFormContainer.hide();
            addFormPlaceholder.empty();
        });

        $(document).off('submit.adminProfiliSave', '#add-profil-form').on('submit.adminProfiliSave', '#add-profil-form', function (e) {
            e.preventDefault();
            const form = $(this);

            if (!form.valid()) {
                return;
            }

            $.ajax({
                url: form.attr('action'),
                method: form.attr('method'),
                data: new FormData(this),
                processData: false,
                contentType: false,
                success: function () {
                    addFormContainer.hide();
                    addFormPlaceholder.empty();
                    loadProfiliList(searchInput.val(), 1, currentRoleFilter);
                    window.showAppFlashMessage('Korisnik uspješno sačuvan.', 'success');
                },
                error: function (jqXHR, textStatus) {
                    let errorMessage = 'Došlo je do greške prilikom spremanja korisnika.';

                    if (jqXHR.status === 400 && jqXHR.responseJSON) {
                        if (jqXHR.responseJSON.errors) {
                            $.each(jqXHR.responseJSON.errors, function (key, messages) {
                                const validationSpan = $('span[data-valmsg-for="' + key + '"]');
                                if (validationSpan.length) {
                                    validationSpan.text(messages.join(', ')).show();
                                } else {
                                    errorMessage += '\n' + key + ': ' + messages.join(', ');
                                }
                            });
                        }

                        if (jqXHR.responseJSON.identityErrors) {
                            errorMessage += '\n\nGreške identiteta:';
                            $.each(jqXHR.responseJSON.identityErrors, function (_, message) {
                                errorMessage += '\n- ' + message;
                            });
                        }
                    } else if (jqXHR.responseText) {
                        errorMessage += '\n\nDetalji: ' + jqXHR.responseText;
                    } else {
                        errorMessage += '\nStatus: ' + jqXHR.status + ', Tekst: ' + textStatus;
                    }

                    window.showAppFlashMessage(errorMessage, 'error');
                }
            });
        });

        $(document).off('app:delete-confirmed.adminProfiliDelete', '.delete-profil-button').on('app:delete-confirmed.adminProfiliDelete', '.delete-profil-button', function () {
            const profilId = $(this).data('id');

            $.ajax({
                url: '@Url.Action("DeleteProfil", "AdminPanel")',
                method: 'POST',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: { id: profilId },
                success: function () {
                    window.showAppFlashMessage('Korisnik uspješno obrisan.', 'success');
                    loadProfiliList(searchInput.val(), 1, currentRoleFilter);
                },
                error: function () {
                    window.showAppFlashMessage('Došlo je do greške prilikom brisanja korisnika.', 'error');
                }
            });
        });
    });
</script>
